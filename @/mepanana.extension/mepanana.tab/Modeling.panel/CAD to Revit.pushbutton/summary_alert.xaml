<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Placement Complete" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <StackPanel Margin="28">
        <TextBlock Text="✓" FontSize="36" FontWeight="Bold"
                   Foreground="{DynamicResource SuccessBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,12"/>

        <TextBlock Text="Placement Complete"
                   FontWeight="SemiBold" FontSize="15"
                   Foreground="{DynamicResource TextBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <!-- Stats row -->
        <Border Background="{DynamicResource SecondaryButtonBrush}"
                CornerRadius="8" Padding="16,12" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Placed -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Name="txtPlaced" Text="0" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Placed" Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11.5" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Divider -->
                <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" Width="1"/>

                <!-- Failed -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Name="txtFailed" Text="0" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource MutedTextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Failed" Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11.5" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Button Name="btnOk" Content="Done"
                Style="{DynamicResource PrimaryButton}"
                Height="34" Width="120" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>