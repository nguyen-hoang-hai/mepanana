<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview Ready" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <StackPanel Margin="28">
        <!-- Icon -->
        <TextBlock Text="👁" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Message -->
        <TextBlock Text="Preview elements have been placed."
                   Foreground="{DynamicResource TextBrush}"
                   FontWeight="SemiBold" FontSize="14"
                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
        <TextBlock Text="Review the positions in the viewport, then choose an action."
                   Foreground="{DynamicResource MutedTextBrush}"
                   FontSize="12.5" TextWrapping="Wrap"
                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24"/>

        <!-- Buttons -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Name="btnEdit"
                    Content="Edit Rules"
                    Style="{DynamicResource GhostButton}" Height="34"/>
            <Button Grid.Column="2" Name="btnPlace"
                    Content="Place All"
                    Style="{DynamicResource PrimaryButton}" Height="34"/>
        </Grid>
    </StackPanel>
</Window>