<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Status — mepanana" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Main Card -->
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- ── Main Info Card ────────────────────────────────────────────── -->
        <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Padding="20" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Center">
                <!-- Avatar / Icon Badge -->
                <Border Width="54" Height="54" CornerRadius="27"
                        Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.5"
                        HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="👤" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                </Border>

                <!-- User Name -->
                <TextBlock Name="txtUserName" Text="Nguyễn Hoàng Hải"
                           FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>

                <!-- Active Status Pill -->
                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1"
                        CornerRadius="12" Padding="12,3" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="● " Foreground="#10B981" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="Session Active &amp; Unlocked" Foreground="#047857"
                                   FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Description -->
                <TextBlock Text="All mepanana tools are currently enabled and ready to use in this Revit session."
                           FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="10,0"/>
            </StackPanel>
        </Border>

        <!-- ── Action Buttons ─────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Name="btnLock"
                    Content="🔒 Lock Tools" Style="{DynamicResource GhostButton}"
                    Height="36" FontWeight="SemiBold" FontSize="12.5"/>

            <Button Grid.Column="2" Name="btnKeep"
                    Content="✓ Keep Active" Style="{DynamicResource PrimaryButton}"
                    Height="36" FontWeight="SemiBold" FontSize="12.5" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>