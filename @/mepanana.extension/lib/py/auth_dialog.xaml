<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Unlock — mepanana" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Main Card -->
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- ── Main Input Card ───────────────────────────────────────────── -->
        <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <!-- Lock Icon Badge -->
                <Border Width="54" Height="54" CornerRadius="27"
                        Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1.5"
                        HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="🔒" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                </Border>

                <!-- Title -->
                <TextBlock Text="Session Authentication"
                           FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>

                <!-- Locked Status Pill -->
                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                        CornerRadius="12" Padding="12,3" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="● " Foreground="#EF4444" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="Tools Currently Locked" Foreground="#DC2626"
                                   FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Password Field -->
                <TextBlock Text="Enter Password to Unlock:" Style="{DynamicResource FieldLabel}" Margin="0,0,0,6"/>
                <PasswordBox Name="txtPassword" Height="36" Padding="10,4" FontSize="14" VerticalContentAlignment="Center"/>

                <!-- Error Text -->
                <TextBlock Name="txtError"
                           Text="Incorrect password!"
                           Foreground="#EF4444" FontSize="12" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,10,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- ── Action Buttons ─────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Name="btnCancel"
                    Content="Cancel" Style="{DynamicResource GhostButton}"
                    Height="36" FontWeight="SemiBold" FontSize="12.5" IsCancel="True"/>

            <Button Grid.Column="2" Name="btnUnlock"
                    Content="🔓 Unlock" Style="{DynamicResource PrimaryButton}"
                    Height="36" FontWeight="SemiBold" FontSize="12.5" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>