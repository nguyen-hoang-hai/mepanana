<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update"
        Width="680" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>

        <!-- ── Modern Sleek ScrollBar ─────────────────────────────────────────── -->
        <Style x:Key="ScrollBarTrackButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="{TemplateBinding Background}" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbVertical" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBd" CornerRadius="3" Background="#CBD5E1" Margin="1,0,1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbHorizontal" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBd" CornerRadius="3" Background="#CBD5E1" Margin="0,1,0,1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumbHorizontal}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Margin" Value="2,0,0,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageUpCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumbVertical}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageDownCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Button (Emerald Accent) -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="#10B981" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#A7F3D0"/>
                                <Setter Property="Foreground" Value="#ECFDF5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="#F1F5F9"
                                BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Action Button (Theme Toggle) -->
        <Style x:Key="TitleActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="Transparent"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Close Button -->
        <Style x:Key="TitleCloseBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="Transparent"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FCA5A5"/>
                                <Setter Property="Foreground" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Master Window Shell with Drop Shadow -->
    <Grid Margin="12">
        <Border CornerRadius="12" Background="#F8FAFC"
                BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                  Color="#0F172A" Opacity="0.14"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <!-- Centered Watermark Background Logo -->
                <Image Name="watermarkImage"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Width="320" Height="320"
                       Opacity="0.14" Stretch="Uniform"
                       IsHitTestVisible="False">
                    <Image.Effect>
                        <BlurEffect Radius="1.5"/>
                    </Image.Effect>
                </Image>

                <!-- Window Content Grid -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>  <!-- Row 0: Custom TitleBar -->
                        <RowDefinition Height="2"/>   <!-- Row 1: Signature Gradient Line -->
                        <RowDefinition Height="*"/>   <!-- Row 2: Main Content Area -->
                    </Grid.RowDefinitions>

                    <!-- ── Row 0: Custom Draggable Title Bar ── -->
                    <Border Grid.Row="0" CornerRadius="11,11,0,0" Background="#F1F5F9"
                            BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid Name="titleBar" Margin="14,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Brand Badge -->
                            <Border Grid.Column="0" CornerRadius="5" Padding="6,2" Margin="0,0,9,0"
                                    Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="MN" FontSize="10.5" Foreground="#059669"/>
                            </Border>

                            <!-- Window Title -->
                            <TextBlock Grid.Column="1" Text="mepanana  ·  Update"
                                       FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>

                            <!-- Theme Toggle Button -->
                            <Button Grid.Column="2" Name="btnToggleTheme" Content="🌙"
                                    ToolTip="Switch to Dark Theme"
                                    Style="{StaticResource TitleActionBtn}" VerticalAlignment="Center"
                                    Margin="0,0,6,0"/>

                            <!-- Close Button -->
                            <Button Grid.Column="3" Name="btnClose" Content="✕"
                                    Style="{StaticResource TitleCloseBtn}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- ── Row 1: Signature 4-Color Gradient Line ── -->
                    <Rectangle Grid.Row="1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#10B981" Offset="0"/>
                                <GradientStop Color="#3B82F6" Offset="0.5"/>
                                <GradientStop Color="#F59E0B" Offset="0.8"/>
                                <GradientStop Color="#EF4444" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- ── Row 2: Main Content Area ── -->
                    <Grid Grid.Row="2" Margin="14,12,14,14">
                        <Grid Name="pnlForm">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />  <!-- Card 0: Version Comparison -->
                                <RowDefinition Height="Auto" />  <!-- Card 1: Release Notes -->
                                <RowDefinition Height="Auto" />  <!-- Footer Action Bar -->
                            </Grid.RowDefinitions>

                        <!-- ── Card 0: Version Status Comparison ── -->
                        <Border Grid.Row="0" Background="#E6FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                CornerRadius="8" Margin="0,0,0,10" Padding="14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.05"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Section Header Title -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Rectangle Width="3" Height="14" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" RadiusX="1.5" RadiusY="1.5"/>
                                        <TextBlock Text="Extension Version Information" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Text="GitHub Sync" FontSize="11" Foreground="#475569" />
                                    </Border>
                                </Grid>

                                <!-- Version Comparison Columns (2 Columns) -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Column: Installed Version -->
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="INSTALLED VERSION" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" />
                                            <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                                <TextBlock Text="LOCAL" FontSize="10" Foreground="#475569" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Name="txtLocalCommit" Text="Commit: 000c469" FontSize="13.5" Foreground="#0F172A" Margin="0,0,0,2" />
                                        <TextBlock Name="txtLocalDate" Text="Installed: Fetching..." FontSize="11" Foreground="#64748B" />
                                    </StackPanel>

                                    <!-- Divider Line -->
                                    <Border Grid.Column="1" Background="#CBD5E1" Width="1" />

                                    <!-- Right Column: Cloud Release -->
                                    <StackPanel Grid.Column="2" Margin="14,0,0,0">
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="LATEST GITHUB RELEASE" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" />
                                            <Border Name="badgeCloud" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                                <TextBlock Name="txtCloudBadge" Text="CHECKING..." FontSize="10" Foreground="#2563EB" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Name="txtCloudCommit" Text="Commit: Fetching..." FontSize="13.5" Foreground="#0F172A" Margin="0,0,0,2" />
                                        <TextBlock Name="txtCloudDate" Text="Checking latest commit..." FontSize="11" Foreground="#64748B" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ── Card 1: Release Notes & Changes ── -->
                        <Border Grid.Row="1" Background="#E6FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                CornerRadius="8" Margin="0,0,0,12" Padding="14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.05"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Rectangle Width="3" Height="14" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" RadiusX="1.5" RadiusY="1.5"/>
                                    <TextBlock Text="What's New in this Release:" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" MinHeight="65">
                                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock Name="txtChangelog" Text="Click 'Check Updates' to query the latest commit details and change summary from GitHub repository."
                                                   FontSize="11.5" Foreground="#334155" TextWrapping="Wrap" LineHeight="18" />
                                    </ScrollViewer>
                                </Border>

                                <TextBlock Text="🔗 Repository: https://github.com/nguyen-hoang-hai/mepanana" FontSize="10.5" Foreground="#94A3B8" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- ── Footer Action Bar ── -->
                        <Border Grid.Row="2" Background="#E6FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.05"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Progress Bar -->
                                <ProgressBar Name="progressBar" Grid.Row="0" Height="4" Margin="0,0,0,8"
                                             Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100" />

                                <!-- Status & Buttons -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Status Text -->
                                    <TextBlock Name="txtStatus" Grid.Column="0" Text="Ready to check for updates." FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,8,0" />

                                    <!-- Right: Action Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Check Updates Button -->
                                        <Button Name="btnCheck" Style="{StaticResource GhostBtn}" Height="34" Padding="14,0" Margin="0,0,8,0"
                                                Content="Check Updates" Cursor="Hand" />

                                        <!-- Update Now Button (Solid Emerald) -->
                                        <Button Name="btnUpdate" Style="{StaticResource PrimaryBtn}" Height="34" Padding="18,0" Margin="0,0,8,0"
                                                Content="🚀 Update Now" Cursor="Hand" IsEnabled="False" IsDefault="True" />

                                        <!-- Close Button -->
                                        <Button Name="btnFooterClose" Style="{StaticResource GhostBtn}" Height="34" Padding="16,0"
                                                Content="Close" Cursor="Hand" IsCancel="True" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- RUNNING MODE: Modern Floating Capsule Dock -->
                    <Grid Name="pnlRunning" Visibility="Collapsed" VerticalAlignment="Stretch">
                        <Border VerticalAlignment="Bottom" Margin="0,0,0,0"
                                Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="10" Padding="14,10,14,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270"
                                                  Color="#0F172A" Opacity="0.10"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Top row: Status title & Percentage -->
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Name="txtRunningTitle" Text="Updating MEPANANA…"
                                               FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <TextBlock Name="txtRunningPercent" Text="0%"
                                               FontSize="12" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Middle row: Capsule Progress Bar -->
                                <Border Height="6" CornerRadius="3" Background="#E2E8F0" Margin="0,0,0,8" ClipToBounds="True">
                                    <ProgressBar Name="progressBarRunning" Height="6" BorderThickness="0"
                                                 Minimum="0" Maximum="100" Value="0"
                                                 Background="Transparent" Foreground="#10B981"/>
                                </Border>

                                <!-- Bottom row: Step detail & Cancel button -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Name="txtRunningDetail" Grid.Column="0" Text="Downloading update package…"
                                               FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" Name="btnStopRunning" Content="Cancel"
                                            Style="{StaticResource GhostBtn}" Height="30" Padding="12,0"
                                            FontSize="11" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Grid>
</Window>
