<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update"
        Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource WindowBgBrush}">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Card 0: Version Comparison -->
            <RowDefinition Height="Auto" />  <!-- Card 1: Release Notes -->
            <RowDefinition Height="Auto" />  <!-- Footer Action Bar -->
        </Grid.RowDefinitions>

        <!-- ── Card 0: Version Status Comparison ────────────────────────── -->
        <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,10" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Section Header Title -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Extension Version Information" Style="{DynamicResource SectionTitle}" Margin="0" />
                    <Border Grid.Column="1" Background="{DynamicResource SecondaryButtonBrush}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="GitHub Sync" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}" />
                    </Border>
                </Grid>

                <!-- Version Comparison Columns (2 Columns) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Installed Version -->
                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="INSTALLED VERSION" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                            <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock Text="LOCAL" FontSize="10" FontWeight="Bold" Foreground="#475569" />
                            </Border>
                        </Grid>
                        <TextBlock Name="txtLocalCommit" Text="Commit: 000c469" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2" />
                        <TextBlock Name="txtLocalDate" Text="Installed: Fetching..." FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>

                    <!-- Divider Line -->
                    <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" Width="1" />

                    <!-- Right Column: Cloud Release -->
                    <StackPanel Grid.Column="2" Margin="14,0,0,0">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="LATEST GITHUB RELEASE" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                            <Border Name="badgeCloud" Background="#EFF6FF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock Name="txtCloudBadge" Text="CHECKING..." FontSize="10" FontWeight="Bold" Foreground="#2563EB" />
                            </Border>
                        </Grid>
                        <TextBlock Name="txtCloudCommit" Text="Commit: Fetching..." FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2" />
                        <TextBlock Name="txtCloudDate" Text="Checking latest commit..." FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Card 1: Release Notes & Changes ──────────────────────────── -->
        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Margin="0,0,0,12" Padding="14">
            <StackPanel>
                <TextBlock Text="What's New in this Release:" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8" />

                <Border Background="#F8FAFC" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" MinHeight="65">
                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock Name="txtChangelog" Text="Click 'Check Updates' to query the latest commit details and change summary from GitHub repository."
                                   FontSize="12" Foreground="#334155" TextWrapping="Wrap" LineHeight="18" />
                    </ScrollViewer>
                </Border>

                <TextBlock Text="🔗 Repository: https://github.com/nguyen-hoang-hai/mepanana" FontSize="10.5" Foreground="{DynamicResource DisabledTextBrush}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- ── Footer Action Bar ────────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Progress Bar -->
            <ProgressBar Name="progressBar" Grid.Row="0" Height="4" Margin="0,0,0,10"
                         Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100" />

            <!-- Status & Buttons -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Status Text -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Margin="4,0,8,0">
                    <TextBlock Name="txtStatus" Text="Ready to check for updates." FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Check Updates Button -->
                    <Button Name="btnCheck" Style="{DynamicResource GhostButton}" Height="32" Padding="14,0" Margin="0,0,8,0"
                            Content="Check Updates" Cursor="Hand" Click="OnCheckUpdatesClick" />

                    <!-- Update Now Button (Solid Accent Blue) -->
                    <Button Name="btnUpdate" Style="{DynamicResource PrimaryButton}" Height="32" Padding="16,0" Margin="0,0,8,0"
                            Content="🚀 Update Now" Cursor="Hand" IsEnabled="False" Click="OnUpdateClick" />

                    <!-- Close Button -->
                    <Button Name="btnClose" Style="{DynamicResource GhostButton}" Height="32" Padding="14,0"
                            Content="Close" Cursor="Hand" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
