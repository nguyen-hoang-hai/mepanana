<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shortcut Manager"
        Width="780" Height="580" MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>     <!-- Tools Card (Resizable) -->
            <RowDefinition Height="Auto"/>  <!-- Conflict Warning Banner -->
            <RowDefinition Height="Auto"/>  <!-- Bottom Action Card -->
        </Grid.RowDefinitions>

        <!-- ── Main Tools Card ────────────────────────────────────────────── -->
        <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Header Title & Info -->
                    <RowDefinition Height="Auto"/>  <!-- Table Column Headers -->
                    <RowDefinition Height="*"/>     <!-- Scrollable Tools List -->
                </Grid.RowDefinitions>

                <!-- Header Title & Info -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="mepanana Tool Shortcuts" Style="{DynamicResource SectionTitle}" Margin="0"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{DynamicResource SecondaryButtonBrush}"
                            CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Name="txtTotalToolsCount" Text="0 Tools"
                                   FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                    </Border>
                </Grid>

                <!-- Table Column Headers -->
                <Border Grid.Row="1" Background="{DynamicResource WindowBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1"
                        Padding="10,8" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/> <!-- Tool Name & Panel -->
                            <ColumnDefinition Width="110"/> <!-- Current Shortcut -->
                            <ColumnDefinition Width="180"/> <!-- New Shortcut Input -->
                            <ColumnDefinition Width="*"/>   <!-- Status -->
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="TOOL NAME" FontWeight="SemiBold"
                                   FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Grid.Column="1" Text="CURRENT" FontWeight="SemiBold"
                                   FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Grid.Column="2" Text="NEW SHORTCUT" FontWeight="SemiBold"
                                   FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Grid.Column="3" Text="STATUS" FontWeight="SemiBold"
                                   FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                   HorizontalAlignment="Right" Margin="0,0,6,0"/>
                    </Grid>
                </Border>

                <!-- Tools List ScrollViewer -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Name="pnlToolsList" Margin="0,2,0,0"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ── Conflict Warning Banner ────────────────────────────────────── -->
        <Border Grid.Row="1" Name="bdrConflictBanner" Visibility="Collapsed"
                Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="⚠" FontSize="16" Foreground="#B45309"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Name="txtConflictMessage" Text="Conflict detected with existing Revit shortcut."
                               FontWeight="SemiBold" FontSize="12.5" Foreground="#92400E" TextWrapping="Wrap"/>
                    <TextBlock Text="Please press a different key combination or clear the shortcut."
                               FontSize="11" Foreground="#B45309" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Bottom Action Card ─────────────────────────────────────────── -->
        <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Height="56" Padding="14,8" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Name="btnResetAll" Content="↺ Reset All"
                        Style="{DynamicResource GhostButton}" Height="34" Padding="16,0"/>

                <TextBlock Grid.Column="1" Text="Tip: Click input box and press keys. Press Backspace to clear."
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0"/>

                <Button Grid.Column="2" Name="btnApply" Content="✓ Apply Shortcuts"
                        Style="{DynamicResource PrimaryButton}" Height="34" Padding="20,0"
                        FontWeight="SemiBold" FontSize="13" IsDefault="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>