<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UI Sample"
        Width="488" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>

        <!-- ── Primary Button (Emerald Accent) ────────────────────────────── -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="7" Background="#10B981" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#064E3B"/>
                                <Setter Property="Foreground" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Ghost / Secondary Button (Dark) ────────────────────────────── -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="7" Background="#1E293B"
                                BorderBrush="#334155" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#475569"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Title Action Button (Theme Toggle Dark) ────────────────────── -->
        <Style x:Key="TitleActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="Transparent"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Title Close Button (Dark) ──────────────────────────────────── -->
        <Style x:Key="TitleCloseBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="Transparent"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#7F1D1D"/>
                                <Setter Property="Foreground" Value="#F87171"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Modern Clean Dark TextBox ──────────────────────────────────── -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#34D399"/>
            <Setter Property="SelectionBrush" Value="#10B98150"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#10B981"/>
                                <Setter TargetName="bd" Property="Background" Value="#020617"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Modern Clean Dark ComboBox ─────────────────────────────────── -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Name="bd" CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="▾" FontSize="10"
                                               Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <ToggleButton Grid.ColumnSpan="2" Focusable="False" IsTabStop="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" IsHitTestVisible="True"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="#1E293B" BorderBrush="#475569" BorderThickness="1"
                                        CornerRadius="6" Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#10B981"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="#E2E8F0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border Name="bd" Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <!-- ── Modern Dark CheckBox ───────────────────────────────────────── -->
        <Style x:Key="ModernCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Name="box" Width="16" Height="16" CornerRadius="4"
                                    BorderThickness="1.2" BorderBrush="#475569"
                                    Background="#0F172A" VerticalAlignment="Center">
                                <TextBlock Name="mark" Text="✓" FontSize="10" Foreground="#34D399"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" Margin="0,0,0,1"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#10B981"/>
                                <Setter TargetName="box" Property="Background" Value="#064E3B"/>
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Modern Dark RadioButton ────────────────────────────────────── -->
        <Style x:Key="ModernRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Name="ring" Width="16" Height="16" CornerRadius="8"
                                    BorderThickness="1.2" BorderBrush="#475569"
                                    Background="#0F172A" VerticalAlignment="Center">
                                <Ellipse Name="dot" Width="6" Height="6" Fill="#34D399"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="#10B981"/>
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════════════════════
         ROOT: Transparent Window + Margins for Drop Shadow & Rounded Corners
    ══════════════════════════════════════════════════════════════════════ -->
    <Grid Margin="14">

        <!-- ── MASTER WINDOW SHELL (Deep Slate-900 with CornerRadius 12) ── -->
        <Border CornerRadius="12" Background="#0F172A"
                BorderBrush="#334155" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270"
                                  Color="#000000" Opacity="0.55"/>
            </Border.Effect>

            <Grid>
                <!-- ── Centered Watermark (behind all cards) ────────────────── -->
                <Image Name="watermarkImage" Opacity="0.25"
                       Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top"
                       Width="330" Height="330" Margin="0,52,0,0"
                       IsHitTestVisible="False">
                    <Image.Effect>
                        <BlurEffect Radius="4"/>
                    </Image.Effect>
                </Image>

                <!-- ── Window Content Layout ────────────────────────────────── -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>   <!-- 0: Title Bar -->
                        <RowDefinition Height="2"/>    <!-- 1: Accent Line -->
                        <RowDefinition Height="Auto"/> <!-- 2: Dynamic Content Area -->
                    </Grid.RowDefinitions>

                    <!-- ── Row 0: Custom Title Bar (Dark) ───────────────────── -->
                    <Border Grid.Row="0" CornerRadius="11,11,0,0" Background="#1E293B"
                            BorderBrush="#334155" BorderThickness="0,0,0,1">
                        <Grid Name="titleBar" Margin="14,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Brand Badge -->
                            <Border Grid.Column="0" CornerRadius="5" Padding="6,2" Margin="0,0,9,0"
                                    Background="#064E3B" BorderBrush="#059669" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="MN" FontSize="10.5" Foreground="#34D399"/>
                            </Border>

                            <!-- Window Title -->
                            <TextBlock Grid.Column="1" Text="mepanana  ·  UI Sample"
                                       FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>

                            <!-- Theme Toggle Button (Dark -> Light) -->
                            <Button Grid.Column="2" Name="btnToggleTheme" Content="☀️"
                                    ToolTip="Switch to Light Theme"
                                    Style="{StaticResource TitleActionBtn}" VerticalAlignment="Center"
                                    Margin="0,0,6,0"/>

                            <!-- Close Button -->
                            <Button Grid.Column="3" Name="btnClose" Content="✕"
                                    Style="{StaticResource TitleCloseBtn}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- ── Row 1: Mepanana Signature Gradient Line ──────────── -->
                    <Rectangle Grid.Row="1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#10B981" Offset="0"/>
                                <GradientStop Color="#3B82F6" Offset="0.5"/>
                                <GradientStop Color="#F59E0B" Offset="0.8"/>
                                <GradientStop Color="#EF4444" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- ── Row 2: Dynamic Content Container ──────────────────── -->
                    <!-- PNL_FORM: Normal Configuration View -->
                    <StackPanel Grid.Row="2" Name="pnlForm">

                        <!-- Window Header -->
                        <Grid Margin="20,16,20,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Title (left) & Status Pill (right) -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="UI Sample Template" FontSize="20" Foreground="#F8FAFC"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                <!-- Status Pill -->
                                <Border Grid.Column="1" CornerRadius="12" Padding="9,4" VerticalAlignment="Center"
                                        Background="#064E3B" BorderBrush="#059669" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Auto · Dark" FontSize="11" Foreground="#34D399"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Row 1: Full-width Subtitle with auto-wrap (never clips) -->
                            <TextBlock Grid.Row="1" Text="Clean layout, cohesive dark theme, and seamless input components."
                                       FontSize="11.5" Foreground="#94A3B8" Margin="0,5,0,0"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <!-- ── Row 3: Cards Container ────────────────────────── -->
                        <StackPanel Grid.Row="3" Margin="16,4,16,8">

                            <!-- CARD 1: Parameters & Inputs (Dark Frosted Glass) -->
                            <Border Background="#E01E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1"
                                    Padding="16,14" Margin="0,0,0,10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270"
                                                      Color="#000000" Opacity="0.25"/>
                                </Border.Effect>
                                <StackPanel>

                                    <!-- Section Header -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Fill="#10B981" RadiusX="1.5" RadiusY="1.5"/>
                                        <TextBlock Grid.Column="1" Text="Routing Configuration"
                                                   FontSize="12.5" Foreground="#F8FAFC" Margin="8,0,0,0"/>
                                    </Grid>

                                    <!-- Dropdown Rows: Discipline & Method -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Discipline" FontSize="11" Foreground="#94A3B8" Margin="1,0,0,5"/>
                                            <ComboBox Name="cmbDiscipline" Style="{StaticResource ModernComboBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Method" FontSize="11" Foreground="#94A3B8" Margin="1,0,0,5"/>
                                            <ComboBox Name="cmbMethod" Style="{StaticResource ModernComboBox}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Tolerance Input: Seamless Connected Badge (Dark) -->
                                    <StackPanel>
                                        <TextBlock Text="Tolerance" FontSize="11" Foreground="#94A3B8" Margin="1,0,0,5"/>
                                        <Border Height="32" CornerRadius="6" Background="#0F172A"
                                                BorderBrush="#334155" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Name="txtTolerance" Grid.Column="0" Text="50"
                                                         BorderThickness="0" Background="Transparent"
                                                         VerticalContentAlignment="Center" Padding="10,0"
                                                         Foreground="#F8FAFC" FontSize="12"
                                                         CaretBrush="#34D399"/>
                                                <Border Grid.Column="1" Background="#1E293B"
                                                        BorderBrush="#334155" BorderThickness="1,0,0,0"
                                                        CornerRadius="0,5,5,0">
                                                    <TextBlock Text="mm" FontSize="11" Foreground="#94A3B8"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                </StackPanel>
                            </Border>

                            <!-- CARD 2: Options & Settings (Dark Frosted Glass) -->
                            <Border Background="#E01E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1"
                                    Padding="16,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270"
                                                      Color="#000000" Opacity="0.25"/>
                                </Border.Effect>
                                <StackPanel>

                                    <!-- Section Header -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Fill="#10B981" RadiusX="1.5" RadiusY="1.5"/>
                                        <TextBlock Grid.Column="1" Text="Execution Options"
                                                   FontSize="12.5" Foreground="#F8FAFC" Margin="8,0,0,0"/>
                                    </Grid>

                                    <!-- Checkboxes -->
                                    <CheckBox Name="chkAutoDetect" IsChecked="True" Margin="0,0,0,10"
                                              Style="{StaticResource ModernCheck}">
                                        <TextBlock Text="Auto-detect connected elements" Foreground="#E2E8F0" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <CheckBox Name="chkLinkFiles" IsChecked="False" Margin="0,0,0,10"
                                              Style="{StaticResource ModernCheck}">
                                        <TextBlock Text="Include linked model elements" Foreground="#E2E8F0" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <CheckBox Name="chkAdvanced" IsChecked="False"
                                              Style="{StaticResource ModernCheck}">
                                        <TextBlock Text="Show advanced parameters" Foreground="#E2E8F0" TextWrapping="Wrap"/>
                                    </CheckBox>

                                    <!-- Advanced Sub-panel (Expands on toggle) -->
                                    <StackPanel Name="pnlAdvanced" Visibility="Collapsed" Margin="0,12,0,0">
                                        <Border Background="#0B132B" BorderBrush="#1E293B" BorderThickness="1"
                                                CornerRadius="6" Padding="12,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="10"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Radio Mode Selector -->
                                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                    <RadioButton Name="radFast" IsChecked="True" Margin="0,0,16,0"
                                                                 Style="{StaticResource ModernRadio}">
                                                        <TextBlock Text="Fast" Foreground="#E2E8F0"/>
                                                    </RadioButton>
                                                    <RadioButton Name="radBal" Margin="0,0,16,0"
                                                                 Style="{StaticResource ModernRadio}">
                                                        <TextBlock Text="Balanced" Foreground="#E2E8F0"/>
                                                    </RadioButton>
                                                    <RadioButton Name="radPre" Style="{StaticResource ModernRadio}">
                                                        <TextBlock Text="Precision" Foreground="#E2E8F0"/>
                                                    </RadioButton>
                                                </StackPanel>

                                                <!-- Parameter Inputs -->
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Max Distance" FontSize="10.5" Foreground="#94A3B8" Margin="1,0,0,4"/>
                                                        <TextBox Height="30" Text="500" Style="{StaticResource ModernTextBox}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Iterations" FontSize="10.5" Foreground="#94A3B8" Margin="1,0,0,4"/>
                                                        <TextBox Height="30" Text="3" Style="{StaticResource ModernTextBox}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ── Row 4: Footer Bar (Dark) ───────────────────────── -->
                        <Border Grid.Row="4" Padding="16,8,16,14" Background="Transparent">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Indeterminate Progress Bar -->
                                <Border Name="progressBorder" Grid.Row="0" Height="3" Margin="0,0,0,10"
                                        Visibility="Collapsed" Background="#1E293B" CornerRadius="1.5">
                                    <ProgressBar Name="progressBar" Height="3" BorderThickness="0"
                                                 IsIndeterminate="True" Background="Transparent"
                                                 Foreground="#10B981"/>
                                </Border>

                                <!-- Status and Action Buttons -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Live Status Label -->
                                    <TextBlock Name="txtStatus" Grid.Column="0" Text="Ready"
                                               FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center"/>

                                    <!-- Cancel Button -->
                                    <Button Grid.Column="1" Name="btnCancel" Content="Cancel"
                                            Style="{StaticResource GhostBtn}" IsCancel="True"/>

                                    <!-- Run Action Button -->
                                    <Button Grid.Column="3" Name="btnRun" Content="Run"
                                            Style="{StaticResource PrimaryBtn}" IsDefault="True"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ── PNL_RUNNING: Unobstructed Background + Bottom Progress Bar (Dark) ── -->
                    <Grid Grid.Row="2" Name="pnlRunning" Visibility="Collapsed" MinHeight="485" Margin="0">

                        <!-- Sleek Bottom Progress Dock (Dark) — leaves 100% of the artwork visible above -->
                        <Border VerticalAlignment="Bottom" Margin="16,0,16,16"
                                Background="#F01E293B" CornerRadius="10"
                                BorderBrush="#334155" BorderThickness="1" Padding="16,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270"
                                                  Color="#000000" Opacity="0.4"/>
                            </Border.Effect>

                            <StackPanel>
                                <!-- Top row: Status title (left) & Percentage (right) -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Name="txtRunningTitle" Text="Processing Elements…"
                                               FontSize="13" Foreground="#F8FAFC" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Name="txtRunningPercent" Grid.Column="1" Text="0%"
                                               FontSize="13" Foreground="#34D399" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Modern Progress Bar -->
                                <Border Height="6" CornerRadius="3" Background="#0F172A" Margin="0,0,0,10" ClipToBounds="True">
                                    <ProgressBar Name="progressBarRunning" Height="6" BorderThickness="0"
                                                 Minimum="0" Maximum="100" Value="0"
                                                 Background="Transparent" Foreground="#10B981"/>
                                </Border>

                                <!-- Bottom row: Step detail (left) & Cancel button (right) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Name="txtRunningDetail" Grid.Column="0" Text="Initializing engine…"
                                               FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" Name="btnStopRunning" Content="Cancel"
                                            Style="{StaticResource GhostBtn}" Height="30" Padding="12,0"
                                            FontSize="11" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
