<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Check Clash • 3D Navigator"
        Width="1040" Height="720" MinWidth="900" MinHeight="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>

        <!-- ── Modern Sleek ScrollBar (Dark Theme) ───────────────────────────── -->
        <Style x:Key="ScrollBarTrackButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="{TemplateBinding Background}" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbVertical" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBd" CornerRadius="3" Background="#475569" Margin="1,0,1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbHorizontal" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBd" CornerRadius="3" Background="#475569" Margin="0,1,0,1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumbHorizontal}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Margin" Value="2,0,0,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageUpCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumbVertical}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageDownCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Default High-Contrast Typography for Dark Mode Controls -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="#F1F5F9"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="#10B981" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#064E3B"/>
                                <Setter Property="Foreground" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button Dark -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="#1E293B"
                                BorderBrush="#334155" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#475569"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Action Button Dark -->
        <Style x:Key="TitleActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="Transparent"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Close Button Dark -->
        <Style x:Key="TitleCloseBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="Transparent"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#7F1D1D"/>
                                <Setter Property="Foreground" Value="#FCA5A5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#991B1B"/>
                                <Setter Property="Foreground" Value="#F87171"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Dark -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Name="Border" CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Margin="10,0,0,0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      VerticalAlignment="Center"/>
                                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0 Z" Fill="#94A3B8"/>
                                </Grid>
                            </Border>
                            <Popup Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Name="DropDownBorder" MaxHeight="220" MinWidth="180"
                                        Background="#1E293B" BorderBrush="#334155"
                                        BorderThickness="1" CornerRadius="6"
                                        Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270"
                                                          Color="#000000" Opacity="0.40"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TabItem Dark -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="bdrTab" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2.5"
                                Margin="0,0,8,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bdrTab" Property="BorderBrush" Value="#10B981"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdrTab" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Shadow Layer -->
    <Grid Margin="12">
        <Border Background="#0F172A" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                  Color="#000000" Opacity="0.50"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <!-- Watermark Background Logo -->
                <Image Name="watermarkImage"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Width="340" Height="340"
                       Opacity="0.10" Stretch="Uniform"
                       IsHitTestVisible="False">
                    <Image.Effect>
                        <BlurEffect Radius="1.5"/>
                    </Image.Effect>
                </Image>

                <!-- Window Content Grid -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>  <!-- Row 0: TitleBar -->
                        <RowDefinition Height="2"/>   <!-- Row 1: Signature Gradient Line -->
                        <RowDefinition Height="*"/>   <!-- Row 2: Form Content -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: TitleBar -->
                    <Border Grid.Row="0" Name="titleBar" Background="#1E293B" CornerRadius="11,11,0,0" Padding="14,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Brand Badge -->
                            <Border Grid.Column="0" CornerRadius="5" Padding="6,2" Margin="0,0,9,0"
                                    Background="#064E3B" BorderBrush="#059669" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="MN" FontSize="10.5" Foreground="#34D399"/>
                            </Border>

                            <!-- Window Title -->
                            <TextBlock Grid.Column="1" Text="mepanana  ·  Check Clash • 3D Navigator"
                                       FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>

                            <!-- Theme Toggle Button -->
                            <Button Grid.Column="2" Name="btnToggleTheme" Content="☀️"
                                    ToolTip="Switch to Light Theme"
                                    Style="{StaticResource TitleActionBtn}" VerticalAlignment="Center"
                                    Margin="0,0,6,0"/>

                            <!-- Close Button -->
                            <Button Grid.Column="3" Name="btnClose" Content="✕"
                                    Style="{StaticResource TitleCloseBtn}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Row 1: Signature Gradient Line -->
                    <Rectangle Grid.Row="1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#10B981" Offset="0"/>
                                <GradientStop Color="#3B82F6" Offset="0.5"/>
                                <GradientStop Color="#F59E0B" Offset="0.8"/>
                                <GradientStop Color="#EF4444" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Row 2: Form Content Area -->
                    <Grid Grid.Row="2" Margin="14,12,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- 0: Scope & Scan Bar -->
                            <RowDefinition Height="*"/>     <!-- 1: Tab Workspace -->
                            <RowDefinition Height="Auto"/>  <!-- 2: Footer Bar -->
                        </Grid.RowDefinitions>

                        <!-- Row 0: Scope, Tolerance & Scan Action Bar -->
                        <Border Grid.Row="0" Background="#E01E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1"
                                Margin="0,0,0,10" Padding="14,9">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.25"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Scope:" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" Name="cmbScope" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                    <ComboBoxItem Content="Active View (All Elements)"/>
                                    <ComboBoxItem Content="Selected Elements Only"/>
                                </ComboBox>

                                <TextBlock Grid.Column="3" Text="Tolerance:" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                
                                <Border Grid.Column="4" Height="32" CornerRadius="6" Background="#0F172A" BorderBrush="#334155" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Name="txtTolerance" Grid.Column="0" Text="0"
                                                 BorderThickness="0" Background="Transparent"
                                                 VerticalContentAlignment="Center" TextAlignment="Center"
                                                 Foreground="#F8FAFC" FontSize="12"
                                                 CaretBrush="#10B981"/>
                                        <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1,0,0,0" CornerRadius="0,5,5,0">
                                            <TextBlock Text="mm" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <CheckBox Grid.Column="6" Name="chkIncludeHost" Content="Check Same Model (Host vs Host)" IsChecked="True"
                                          VerticalAlignment="Center" FontSize="12" Foreground="#CBD5E1"/>

                                <Button Grid.Column="8" Name="btnScan" Style="{StaticResource PrimaryBtn}" Height="34" Padding="18,0"
                                        Content="🔍 Scan Clashes"/>
                            </Grid>
                        </Border>

                        <!-- Row 1: TabControl Workspace -->
                        <TabControl Name="tabMain" Grid.Row="1" Margin="0,0,0,10" Background="Transparent" BorderThickness="0">
                            <!-- Tab 1: Clash Inspector -->
                            <TabItem Name="tabInspector" Header="🔍 Clash Inspector">
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Controls & Stats Card -->
                                    <Border Grid.Column="0" Background="#E01E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="14,12">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.25"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>  <!-- 0: Search -->
                                                <RowDefinition Height="Auto"/>  <!-- 1: Separator -->
                                                <RowDefinition Height="Auto"/>  <!-- 2: Actions Header & 3D Tools -->
                                                <RowDefinition Height="Auto"/>  <!-- 3: File Tools -->
                                                <RowDefinition Height="*"/>     <!-- 4: Spacer -->
                                                <RowDefinition Height="Auto"/>  <!-- 5: Mini Dashboard -->
                                            </Grid.RowDefinitions>

                                            <!-- Search Box -->
                                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Grid.Column="0" Fill="#10B981" RadiusX="1.5" RadiusY="1.5"/>
                                                    <TextBlock Grid.Column="1" Text="SEARCH / FILTER" FontSize="11" Foreground="#94A3B8" Margin="6,0,0,0"/>
                                                </Grid>
                                                <Border Height="32" CornerRadius="6" Background="#0F172A" BorderBrush="#334155" BorderThickness="1">
                                                    <TextBox Name="txtSearch" BorderThickness="0" Background="Transparent"
                                                             VerticalContentAlignment="Center" Padding="8,0"
                                                             Foreground="#F8FAFC" FontSize="12" CaretBrush="#10B981"
                                                             Tag="Filter by ID or Category..."/>
                                                </Border>
                                            </StackPanel>

                                            <Rectangle Grid.Row="1" Height="1" Fill="#334155" Margin="0,0,0,10"/>

                                            <!-- Navigation Action Buttons -->
                                            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Grid.Column="0" Fill="#10B981" RadiusX="1.5" RadiusY="1.5"/>
                                                    <TextBlock Grid.Column="1" Text="CLASH RESOLUTION" FontSize="11" Foreground="#94A3B8" Margin="6,0,0,0"/>
                                                </Grid>

                                                <Button Name="btnFocus3D" Style="{StaticResource PrimaryBtn}" Height="34" Margin="0,0,0,6"
                                                        Content="🎯 3D Box &amp; Focus" ToolTip="Open 3D view and crop Section Box around selected clash"/>

                                                <Button Name="btnRecheck" Style="{StaticResource PrimaryBtn}" Background="#059669" Height="34" Margin="0,0,0,8"
                                                        Content="⚡ Recheck (F5)" ToolTip="Check if selected clash is fixed. If clear, marks Resolved and advances to next!"/>

                                                <!-- Prev / Next Pair -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Name="btnPrev" Style="{StaticResource GhostBtn}" Height="30" Content="◀ Prev"/>
                                                    <Button Grid.Column="2" Name="btnNext" Style="{StaticResource GhostBtn}" Height="30" Content="Next ▶"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- File Management Pair -->
                                            <StackPanel Grid.Row="3" Margin="0,0,0,10">
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Grid.Column="0" Fill="#10B981" RadiusX="1.5" RadiusY="1.5"/>
                                                    <TextBlock Grid.Column="1" Text="FILE MANAGEMENT" FontSize="11" Foreground="#94A3B8" Margin="6,0,0,0"/>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Name="btnImportExcel" Style="{StaticResource GhostBtn}" Height="30"
                                                            Content="📥 Import" ToolTip="Load clash report from an Excel file"/>
                                                    <Button Grid.Column="2" Name="btnExportExcel" Style="{StaticResource GhostBtn}" Height="30"
                                                            Content="📊 Export" ToolTip="Export clash list to Excel report"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Bottom Progress Dashboard Card -->
                                            <Border Grid.Row="5" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock Text="RESOLUTION PROGRESS" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                        <TextBlock Name="txtResolutionPercent" Text="0%" FontSize="12" Foreground="#34D399" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <ProgressBar Name="progResolution" Height="4" Margin="0,0,0,6" Minimum="0" Maximum="100" Value="0"
                                                                 Foreground="#10B981" Background="#1E293B" BorderThickness="0"/>

                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="6"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Active Metric Card -->
                                                        <Border Grid.Column="0" Background="#450A0A" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="5" Padding="4,4">
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <TextBlock Name="txtActiveMetric" Text="0" FontSize="16" Foreground="#F87171" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="Active" FontSize="10" Foreground="#FCA5A5" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Resolved Metric Card -->
                                                        <Border Grid.Column="2" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="5" Padding="4,4">
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <TextBlock Name="txtResolvedMetric" Text="0" FontSize="16" Foreground="#34D399" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="Resolved" FontSize="10" Foreground="#A7F3D0" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Name="txtTotalMetric" Text="Total: 0 clashes inspected" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Right DataGrid Card -->
                                    <Border Grid.Column="2" Background="#E01E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.25"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header with Segmented Pill Tabs -->
                                            <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Segmented Pill Container -->
                                                    <Border Grid.Column="0" Background="#0F172A" CornerRadius="7" Padding="2" Height="34">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Name="btnTabActive" Height="30" Padding="14,0" Margin="0,0,2,0"
                                                                    Content="🔴 Active (0)" FontSize="11.5"
                                                                    Background="#1E293B" Foreground="#F87171" BorderThickness="0"
                                                                    Cursor="Hand"/>

                                                            <Button Name="btnTabResolved" Height="30" Padding="14,0" Margin="0,0,2,0"
                                                                    Content="✅ Resolved (0)" FontSize="11.5"
                                                                    Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                                                                    Cursor="Hand"/>

                                                            <Button Name="btnTabAll" Height="30" Padding="14,0"
                                                                    Content="All (0)" FontSize="11.5"
                                                                    Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                                                                    Cursor="Hand"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Hint Badge -->
                                                    <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                                                            CornerRadius="6" Padding="8,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="💡" Margin="0,0,4,0" FontSize="11"/>
                                                            <TextBlock Text="Double-click row to crop 3D Box" Foreground="#94A3B8" FontSize="11"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- DataGrid & Empty State Overlay -->
                                            <Grid Grid.Row="1">
                                                <DataGrid Name="dgClashes"
                                                          AutoGenerateColumns="False"
                                                          CanUserAddRows="False"
                                                          CanUserDeleteRows="False"
                                                          IsReadOnly="True"
                                                          SelectionMode="Single"
                                                          SelectionUnit="FullRow"
                                                          GridLinesVisibility="Horizontal"
                                                          HorizontalGridLinesBrush="#334155"
                                                          Background="Transparent"
                                                          RowHeight="34"
                                                          BorderThickness="0"
                                                          EnableRowVirtualization="True"
                                                          ScrollViewer.CanContentScroll="True">
                                                    <DataGrid.ColumnHeaderStyle>
                                                        <Style TargetType="DataGridColumnHeader">
                                                            <Setter Property="Background" Value="#1E293B"/>
                                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                                            <Setter Property="FontWeight" Value="Normal"/>
                                                            <Setter Property="FontSize" Value="11.5"/>
                                                            <Setter Property="Height" Value="32"/>
                                                            <Setter Property="Padding" Value="10,0"/>
                                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                            <Setter Property="BorderBrush" Value="#334155"/>
                                                        </Style>
                                                    </DataGrid.ColumnHeaderStyle>

                                                    <DataGrid.Columns>
                                                        <DataGridTemplateColumn Header="Status" Width="110">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{Binding StatusBg}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="4,2">
                                                                        <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding StatusColor}" FontSize="11.5" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>

                                                        <DataGridTextColumn Header="Element 1 (Host)" Binding="{Binding Elem1Info}" Width="175">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                                    <Setter Property="Foreground" Value="#F87171"/>
                                                                    <Setter Property="Padding" Value="6,0"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Header="Element 2 (Target / Link)" Binding="{Binding Elem2Info}" Width="185">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                                    <Setter Property="Foreground" Value="#60A5FA"/>
                                                                    <Setter Property="Padding" Value="6,0"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Header="Overlap" Binding="{Binding OverlapDisplay}" Width="80">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                                    <Setter Property="TextAlignment" Value="Right"/>
                                                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Header="Elev Diff" Binding="{Binding ElevDiffDisplay}" Width="80">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                                    <Setter Property="TextAlignment" Value="Right"/>
                                                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Header="Model Source" Binding="{Binding ModelSource}" Width="*">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                                    <Setter Property="Padding" Value="6,0"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>

                                                <!-- Empty State Notice -->
                                                <Border Name="borderEmptyState" Visibility="Visible" Background="Transparent" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.4"/>
                                                        <TextBlock Name="txtEmptyTitle" Text="No clashes displayed in this view" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                        <TextBlock Name="txtEmptySubtitle" Text="Click 'Scan Clashes' above or 'Import' from Excel to begin" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- Tab 2: Categories (VV) -->
                            <TabItem Name="tabCategories" Header="📋 Categories (VV)">
                                <Grid Margin="0,8,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>  <!-- 0: Search & Preset Bar -->
                                        <RowDefinition Height="*"/>     <!-- 1: Categories DataGrid -->
                                        <RowDefinition Height="Auto"/>  <!-- 2: Selection Counter / Info -->
                                    </Grid.RowDefinitions>

                                    <!-- Top Filter & Presets Card -->
                                    <Border Grid.Row="0" Background="#E01E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.25"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: Search + Discipline Filter -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="180"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Height="32" CornerRadius="6" Background="#0F172A" BorderBrush="#334155" BorderThickness="1">
                                                    <TextBox Name="txtCatSearch" BorderThickness="0" Background="Transparent"
                                                             VerticalContentAlignment="Center" Padding="8,0"
                                                             Foreground="#F8FAFC" FontSize="12" CaretBrush="#10B981"
                                                             Tag="🔎 Search category name..."/>
                                                </Border>

                                                <ComboBox Grid.Column="2" Name="cmbCatDiscipline" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                                    <ComboBoxItem Content="All Disciplines"/>
                                                    <ComboBoxItem Content="MEP Only"/>
                                                    <ComboBoxItem Content="Piping"/>
                                                    <ComboBoxItem Content="Mechanical"/>
                                                    <ComboBoxItem Content="Electrical"/>
                                                    <ComboBoxItem Content="Structural"/>
                                                    <ComboBoxItem Content="Architectural"/>
                                                </ComboBox>
                                            </Grid>

                                            <!-- Row 1: Quick Preset Buttons -->
                                            <WrapPanel Grid.Row="1">
                                                <Button Name="btnPresetMep" Style="{StaticResource PrimaryBtn}" Height="30" Padding="12,0" Margin="0,0,6,0"
                                                        Content="📡 MEP Default" ToolTip="Reset to standard MEP categories (Pipes, Ducts, Cable Trays, Conduits, Equipment)"/>
                                                <Button Name="btnPresetAll" Style="{StaticResource GhostBtn}" Height="30" Padding="12,0" Margin="0,0,6,0"
                                                        Content="✅ Select All" ToolTip="Select all visible categories in the list"/>
                                                <Button Name="btnPresetNone" Style="{StaticResource GhostBtn}" Height="30" Padding="12,0" Margin="0,0,6,0"
                                                        Content="☐ Clear All" ToolTip="Deselect all categories"/>
                                                <Button Name="btnPresetStruct" Style="{StaticResource GhostBtn}" Height="30" Padding="12,0" Margin="0,0,6,0"
                                                        Content="🏗️ + Structure" ToolTip="Add structural categories (Framing, Columns, Foundations)"/>
                                                <Button Name="btnPresetArch" Style="{StaticResource GhostBtn}" Height="30" Padding="12,0" Margin="0,0,6,0"
                                                        Content="🏠 + Architecture" ToolTip="Add architectural categories (Walls, Floors, Ceilings)"/>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Categories Table Card -->
                                    <Border Grid.Row="1" Background="#E01E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.25"/>
                                        </Border.Effect>
                                        <DataGrid Name="dgCategories"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  IsReadOnly="True"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  GridLinesVisibility="Horizontal"
                                                  HorizontalGridLinesBrush="#334155"
                                                  Background="Transparent"
                                                  RowHeight="32"
                                                  BorderThickness="0"
                                                  EnableRowVirtualization="True"
                                                  ScrollViewer.CanContentScroll="True">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="#1E293B"/>
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Setter Property="FontSize" Value="11.5"/>
                                                    <Setter Property="Height" Value="32"/>
                                                    <Setter Property="Padding" Value="10,0"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    <Setter Property="BorderBrush" Value="#334155"/>
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>

                                            <DataGrid.Columns>
                                                <!-- Checkbox Column -->
                                                <DataGridTemplateColumn Header="Check" Width="65">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}"
                                                                      IsHitTestVisible="False"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- Category Name -->
                                                <DataGridTextColumn Header="Model Category (VV)" Binding="{Binding Name}" Width="*">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="Padding" Value="8,0"/>
                                                            <Setter Property="Foreground" Value="#F8FAFC"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <!-- Discipline Tag -->
                                                <DataGridTemplateColumn Header="Discipline" Width="140">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding DiscBg}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" Margin="4,2">
                                                                <TextBlock Text="{Binding Discipline}" Foreground="{Binding DiscColor}" FontSize="11" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>

                                    <!-- Row 2: Status / Summary -->
                                    <Grid Grid.Row="2" Margin="4,8,4,0">
                                        <TextBlock Name="txtCatSummary" Text="Selected: 0 categories"
                                                   FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Text="💡 Click row or press Space to toggle. Click 'Scan Clashes' when ready."
                                                   FontSize="11.5" Foreground="#94A3B8"/>
                                    </Grid>
                                </Grid>
                            </TabItem>
                        </TabControl>

                        <!-- Row 2: Tier 3 FooterBar -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ProgressBar Name="progressBar" Grid.Row="0" Height="3" Margin="0,0,0,8"
                                         Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100"/>

                            <Grid Grid.Row="1">
                                <TextBlock Name="txtStatus" Text="Ready to inspect clashes..."
                                           VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11.5"/>

                                <Button Name="btnFooterClose" Style="{StaticResource GhostBtn}"
                                        HorizontalAlignment="Right" Width="90" Height="32" Content="Close" IsCancel="True"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
