<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Check Clash • 3D Navigator"
        Width="1040" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Topmost="True"
        Background="#F5F7FA"
        FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Top Scope & Scan Bar -->
            <RowDefinition Height="*"/>     <!-- 1: Main Navigator Workspace -->
            <RowDefinition Height="Auto"/>  <!-- 2: Tier 3 FooterBar -->
        </Grid.RowDefinitions>

        <!-- ── Row 0: Scope, Tolerance & Scan Action ────────────────────────── -->
        <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,12" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Scope:" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" Name="cmbScope" Height="32" SelectedIndex="0">
                    <ComboBoxItem Content="Active View (All Elements)"/>
                    <ComboBoxItem Content="Selected Elements Only"/>
                </ComboBox>

                <TextBlock Grid.Column="3" Text="Tolerance:" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="4" Name="txtTolerance" Height="32" Text="0" VerticalContentAlignment="Center" TextAlignment="Center"/>

                <TextBlock Grid.Column="5" Text="mm" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5"/>

                <Button Grid.Column="6" Name="btnScan" Style="{DynamicResource PrimaryButton}" Height="34" Padding="18,0" Content="🔍 Scan Clashes"/>
            </Grid>
        </Border>

        <!-- ── Row 1: TabControl (Inspector | Categories) ───────────────────── -->
        <TabControl Name="tabMain" Grid.Row="1" Margin="0,0,0,12"
                    Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="18,8"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="bdrTab" Background="Transparent"
                                        BorderBrush="Transparent" BorderThickness="0,0,0,3"
                                        Margin="0,0,8,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bdrTab" Property="BorderBrush" Value="#10B981"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bdrTab" Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ── TAB 1: CLASH INSPECTOR ────────────────────────────────────── -->
            <TabItem Name="tabInspector" Header="🔍 Clash Inspector">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Controls & Stats Card (Clean restored layout) -->
                    <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>  <!-- 0: Search -->
                                <RowDefinition Height="Auto"/>  <!-- 1: Separator -->
                                <RowDefinition Height="Auto"/>  <!-- 2: Actions Header & 3D Tools -->
                                <RowDefinition Height="Auto"/>  <!-- 3: File Tools -->
                                <RowDefinition Height="*"/>     <!-- 4: Spacer -->
                                <RowDefinition Height="Auto"/>  <!-- 5: Mini Dashboard -->
                            </Grid.RowDefinitions>

                            <!-- Search Box -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="SEARCH / FILTER" Style="{DynamicResource SectionTitle}" Margin="0,0,0,6"/>
                                <TextBox Name="txtSearch" Height="32" VerticalContentAlignment="Center" Padding="8,0" Tag="Filter by ID or Category..."/>
                            </StackPanel>

                            <Separator Grid.Row="1" Margin="0,0,0,12" Background="{DynamicResource BorderBrush}"/>

                            <!-- Navigation Action Buttons -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                                <TextBlock Text="CLASH RESOLUTION" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8"/>

                                <Button Name="btnFocus3D" Style="{DynamicResource PrimaryButton}" Height="36" Margin="0,0,0,8"
                                        Content="🎯 3D Box &amp; Focus" ToolTip="Open 3D view and crop Section Box around selected clash"/>

                                <Button Name="btnRecheck" Style="{DynamicResource PrimaryButton}" Background="#059669" BorderBrush="#047857" Height="36" Margin="0,0,0,10"
                                        Content="⚡ Recheck (F5)" ToolTip="Check if selected clash is fixed. If clear, marks Resolved and advances to next!"/>

                                <!-- Prev / Next Pair -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Name="btnPrev" Style="{DynamicResource GhostButton}" Height="32" Content="◀ Prev"/>
                                    <Button Grid.Column="2" Name="btnNext" Style="{DynamicResource GhostButton}" Height="32" Content="Next ▶"/>
                                </Grid>
                            </StackPanel>

                            <!-- File Management Pair -->
                            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                                <TextBlock Text="FILE MANAGEMENT" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Name="btnImportExcel" Style="{DynamicResource GhostButton}" Height="32"
                                            Content="📥 Import" ToolTip="Load clash report from an Excel file"/>
                                    <Button Grid.Column="2" Name="btnExportExcel" Style="{DynamicResource GhostButton}" Height="32"
                                            Content="📊 Export" ToolTip="Export clash list to Excel report"/>
                                </Grid>
                            </StackPanel>

                            <!-- Bottom Progress Dashboard Card -->
                            <Border Grid.Row="5" Background="#F8FAFC" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <!-- Header: Title & Percent -->
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="RESOLUTION PROGRESS" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Name="txtResolutionPercent" Text="0%" FontWeight="Bold" FontSize="12.5" Foreground="#059669" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Progress Bar -->
                                    <ProgressBar Name="progResolution" Height="5" Margin="0,0,0,10" Minimum="0" Maximum="100" Value="0"
                                                 Foreground="#10B981" Background="#E2E8F0" BorderThickness="0">
                                        <ProgressBar.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="2.5"/>
                                            </Style>
                                        </ProgressBar.Resources>
                                    </ProgressBar>

                                    <!-- 2 Metric Cards -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Active Metric Card -->
                                        <Border Grid.Column="0" Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="4,6">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Name="txtActiveMetric" Text="0" FontSize="18" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Active" FontSize="10.5" FontWeight="SemiBold" Foreground="#DC2626" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Resolved Metric Card -->
                                        <Border Grid.Column="2" Background="#D1FAE5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="4,6">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Name="txtResolvedMetric" Text="0" FontSize="18" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Resolved" FontSize="10.5" FontWeight="SemiBold" Foreground="#059669" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Total Label -->
                                    <TextBlock Name="txtTotalMetric" Text="Total: 0 clashes inspected" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Right DataGrid Card -->
                    <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header with Modern Segmented Pill Tabs -->
                            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Segmented Pill Container -->
                                    <Border Grid.Column="0" Background="#E2E8F0" CornerRadius="8" Padding="3" Height="36">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Name="btnTabActive" Height="30" Padding="14,0" Margin="0,0,2,0"
                                                    Content="🔴 Active (0)" FontWeight="Bold" FontSize="12"
                                                    Background="White" Foreground="#DC2626" BorderThickness="0"
                                                    Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <Button Name="btnTabResolved" Height="30" Padding="14,0" Margin="0,0,2,0"
                                                    Content="✅ Resolved (0)" FontWeight="SemiBold" FontSize="12"
                                                    Background="Transparent" Foreground="#64748B" BorderThickness="0"
                                                    Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <Button Name="btnTabAll" Height="30" Padding="14,0"
                                                    Content="All (0)" FontWeight="SemiBold" FontSize="12"
                                                    Background="Transparent" Foreground="#64748B" BorderThickness="0"
                                                    Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Elegant Hint Badge -->
                                    <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Background="#FFFFFF" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="10,5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💡" Margin="0,0,5,0" FontSize="11.5"/>
                                            <TextBlock Text="Double-click row to crop 3D Box" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- DataGrid & Empty State Overlay -->
                            <Grid Grid.Row="1">
                                <DataGrid Name="dgClashes"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#F1F5F9"
                                          Background="Transparent"
                                          RowHeight="34"
                                          BorderThickness="0"
                                          EnableRowVirtualization="True"
                                          ScrollViewer.CanContentScroll="True">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="11.5"/>
                                            <Setter Property="Height" Value="32"/>
                                            <Setter Property="Padding" Value="10,0"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>

                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Status" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding StatusBg}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="4,2">
                                                        <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Element 1 (Host)" Binding="{Binding Elem1Info}" Width="175">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Padding" Value="6,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Element 2 (Target / Link)" Binding="{Binding Elem2Info}" Width="185">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Foreground" Value="#2563EB"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Padding" Value="6,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Overlap" Binding="{Binding OverlapDisplay}" Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="TextAlignment" Value="Right"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Elev Diff" Binding="{Binding ElevDiffDisplay}" Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="TextAlignment" Value="Right"/>
                                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Model Source" Binding="{Binding ModelSource}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                                    <Setter Property="Padding" Value="6,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Empty State Notice -->
                                <Border Name="borderEmptyState" Visibility="Visible" Background="Transparent" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.4"/>
                                        <TextBlock Name="txtEmptyTitle" Text="No clashes displayed in this view" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Name="txtEmptySubtitle" Text="Click 'Scan Clashes' above or 'Import' from Excel to begin" FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ── TAB 2: CATEGORIES (VV) ────────────────────────────────────── -->
            <TabItem Name="tabCategories" Header="📋 Categories (VV)">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- 0: Search & Preset Bar -->
                        <RowDefinition Height="*"/>     <!-- 1: Categories DataGrid -->
                        <RowDefinition Height="Auto"/>  <!-- 2: Selection Counter / Info -->
                    </Grid.RowDefinitions>

                    <!-- Top Filter & Presets Card -->
                    <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Search + Discipline Filter -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Name="txtCatSearch" Height="32"
                                         VerticalContentAlignment="Center" Padding="8,0"
                                         Tag="🔎 Search category name..."/>

                                <ComboBox Grid.Column="2" Name="cmbCatDiscipline" Height="32" SelectedIndex="0">
                                    <ComboBoxItem Content="All Disciplines"/>
                                    <ComboBoxItem Content="MEP Only"/>
                                    <ComboBoxItem Content="Mechanical"/>
                                    <ComboBoxItem Content="Electrical"/>
                                    <ComboBoxItem Content="Piping"/>
                                    <ComboBoxItem Content="Structure"/>
                                    <ComboBoxItem Content="Architecture"/>
                                </ComboBox>
                            </Grid>

                            <!-- Row 1: Quick Preset Buttons -->
                            <WrapPanel Grid.Row="1">
                                <Button Name="btnPresetMep" Style="{DynamicResource PrimaryButton}" Height="28" Padding="12,0" Margin="0,0,6,0"
                                        Content="📡 MEP Default" ToolTip="Reset to standard MEP categories (Pipes, Ducts, Cable Trays, Conduits, Equipment)"/>
                                <Button Name="btnPresetAll" Style="{DynamicResource GhostButton}" Height="28" Padding="12,0" Margin="0,0,6,0"
                                        Content="✅ Select All" ToolTip="Select all visible categories in the list"/>
                                <Button Name="btnPresetNone" Style="{DynamicResource GhostButton}" Height="28" Padding="12,0" Margin="0,0,6,0"
                                        Content="☐ Clear All" ToolTip="Deselect all categories"/>
                                <Button Name="btnPresetStruct" Style="{DynamicResource GhostButton}" Height="28" Padding="12,0" Margin="0,0,6,0"
                                        Content="🏗️ + Structure" ToolTip="Add structural categories (Framing, Columns, Foundations)"/>
                                <Button Name="btnPresetArch" Style="{DynamicResource GhostButton}" Height="28" Padding="12,0" Margin="0,0,6,0"
                                        Content="🏠 + Architecture" ToolTip="Add architectural categories (Walls, Floors, Ceilings)"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Categories Table Card -->
                    <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="0">
                        <DataGrid Name="dgCategories"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  Background="Transparent"
                                  RowHeight="32"
                                  BorderThickness="0"
                                  EnableRowVirtualization="True"
                                  ScrollViewer.CanContentScroll="True">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="Height" Value="32"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <!-- Checkbox Column -->
                                <DataGridTemplateColumn Header="Check" Width="65">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}"
                                                      IsHitTestVisible="False"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Category Name -->
                                <DataGridTextColumn Header="Model Category (VV)" Binding="{Binding Name}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Discipline Tag -->
                                <DataGridTemplateColumn Header="Discipline" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding DiscBg}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" Margin="4,2">
                                                <TextBlock Text="{Binding Discipline}" Foreground="{Binding DiscColor}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- In Active View -->
                                <DataGridTextColumn Header="In Active View" Binding="{Binding CountDisplay}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Row 2: Status / Summary -->
                    <Grid Grid.Row="2" Margin="4,8,4,0">
                        <TextBlock Name="txtCatSummary" Text="Selected: 0 categories (0 elements in view)"
                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="💡 Click row or press Space to toggle. Click 'Scan Clashes' when ready."
                                   FontSize="11.5" Foreground="#64748B"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ── Row 2: Tier 3 FooterBar ──────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Row 0: ProgressBar -->
                <RowDefinition Height="Auto"/>  <!-- Row 1: Status & Action -->
            </Grid.RowDefinitions>

            <ProgressBar Name="progressBar" Grid.Row="0" Height="4" Margin="0,0,0,8"
                         Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100"/>

            <Grid Grid.Row="1">
                <TextBlock Name="txtStatus" Text="Ready to inspect clashes..."
                           VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>

                <Button Name="btnClose" Style="{DynamicResource GhostButton}"
                        HorizontalAlignment="Right" Width="90" Height="32" Content="Close" IsCancel="True"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
