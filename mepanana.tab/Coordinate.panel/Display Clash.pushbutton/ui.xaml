<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Display Clash"
        Width="900" Height="640" MinWidth="840" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Scope Selector Card -->
            <RowDefinition Height="*"/>     <!-- 1: Symmetrical Two-Column Content -->
            <RowDefinition Height="Auto"/>  <!-- 2: Footer Action Bar -->
        </Grid.RowDefinitions>

        <!-- ── Top Card 0: Scope, Extent, Options & Legend Bar ────────────── -->
        <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,12" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Analysis Scope (Left) & Highlight Extent (Right) -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Scope -->
                        <ColumnDefinition Width="*"/>    <!-- Spacer -->
                        <ColumnDefinition Width="Auto"/> <!-- Highlight Extent -->
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Analysis Scope:" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Name="cmbScope" Width="220" Height="30" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Active View (All Elements)"/>
                            <ComboBoxItem Content="Selected Elements Only"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Highlight Extent:" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Name="txtExtent" Text="600" Width="55" Height="28"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        <TextBlock Text="mm" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Check Same Model (Left) & Color Legend Badges (Right) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Check Same Model -->
                        <ColumnDefinition Width="*"/>    <!-- Spacer -->
                        <ColumnDefinition Width="Auto"/> <!-- Color Legend Badges -->
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" Name="chkIncludeHost" Content="Check Same Model (Host vs Host)"
                              IsChecked="True" VerticalAlignment="Center"
                              ToolTip="When enabled, detects clashes between elements within the current host model as well as linked models."/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Name="badgeHost1" Background="#20EF4444" CornerRadius="4" Padding="7,3" Margin="0,0,6,0">
                            <TextBlock Name="txtBadgeHost1" Text="🔴 Host 1 (Red)" FontSize="11" Foreground="#EF4444"/>
                        </Border>
                        <Border Name="badgeHost2" Background="#20F59E0B" CornerRadius="4" Padding="7,3" Margin="0,0,6,0">
                            <TextBlock Text="🟠 Host 2 (Orange)" FontSize="11" Foreground="#D97706"/>
                        </Border>
                        <Border Name="badgeLink" Background="#2022C55E" CornerRadius="4" Padding="7,3">
                            <TextBlock Text="🟢 Link (Green)" FontSize="11" Foreground="#16A34A"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Middle Row 1: Balanced Two-Column Grid ──────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left Column: Categories Selection Card ───────────────────── -->
            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Margin="0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- 0: Section Title & Mode Radios -->
                        <RowDefinition Height="*"/>     <!-- 1: Custom Settings Panel (Search, Toolbar, ListBox) -->
                    </Grid.RowDefinitions>

                    <!-- Mode Radios -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Host Model Categories" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8"/>
                        <RadioButton Name="radDefault" Content="Use Default Settings (MEP Core)" IsChecked="True" Margin="0,0,0,5"/>
                        <RadioButton Name="radCustom" Content="Customize Settings" Margin="0,0,0,4"/>
                    </StackPanel>

                    <!-- Custom Settings Container (Locked when Default is active) -->
                    <Grid Grid.Row="1" Name="pnlCustomSettings">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- 0: Category Search Bar -->
                            <RowDefinition Height="Auto"/>  <!-- 1: Action Bar: Count Badge, All/None -->
                            <RowDefinition Height="*"/>     <!-- 2: Scrollable Categories ListBox -->
                        </Grid.RowDefinitions>

                        <!-- Category Search Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBox Name="txtSearchCategory" Height="30" Padding="28,0,24,0"
                                     VerticalContentAlignment="Center" FontSize="12"
                                     ToolTip="Type to filter categories..."/>
                            <TextBlock Text="🔍" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock Text="Search categories..." Foreground="{DynamicResource MutedTextBrush}"
                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="28,0,0,0" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtSearchCategory}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Name="btnClearCategorySearch" Content="✕" Width="20" Height="20"
                                    HorizontalAlignment="Right" Margin="0,0,5,0"
                                    Style="{DynamicResource GhostButton}" Visibility="Collapsed"
                                    Padding="0" FontSize="10" ToolTip="Clear filter"/>
                        </Grid>

                        <!-- Subheader Toolbar: Category Count + All/None Buttons -->
                        <Grid Grid.Row="1" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Name="txtCategoryCount" Text="26 Selected" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Name="btnSelectAll" Grid.Column="1" Content="All" Style="{DynamicResource GhostButton}" Height="24" MinWidth="44" Padding="8,0" FontSize="11" Margin="0,0,4,0"/>
                            <Button Name="btnSelectNone" Grid.Column="2" Content="None" Style="{DynamicResource GhostButton}" Height="24" MinWidth="44" Padding="8,0" FontSize="11"/>
                        </Grid>

                        <!-- Scrollable Category ListBox with Virtualization -->
                        <Border Grid.Row="2" Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
                            <ListBox Name="lstCategories" BorderThickness="0" Background="Transparent"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.IsDeferredScrollingEnabled="False"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="4,3.5" VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── Right Column: Detected Clashes Card ──────────────────────── -->
            <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Margin="0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Header Title & Badge -->
                        <RowDefinition Height="*"/>     <!-- Clashes ListBox -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Detected Clashes" Style="{DynamicResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                        <TextBlock Name="txtClashCount" Grid.Column="1" Text="0 clashes detected" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Clashes ListBox with Virtualization -->
                    <Border Grid.Row="1" Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
                        <ListBox Name="lstClashes" BorderThickness="0" Background="Transparent"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.IsDeferredScrollingEnabled="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*"/>
                                             <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding DetailInfo}" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Footer Action Bar ───────────────────────────────────────────── -->
        <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Margin="0" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ProgressBar Name="progressBar" Grid.Row="0" Height="4" Margin="0,0,0,8" Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Name="btnClear" Grid.Column="0" Content="🧹 Clear Analysis" Style="{DynamicResource GhostButton}" Height="32" MinWidth="130" ToolTip="Remove visual analysis highlights from view"/>

                    <TextBlock Name="txtStatus" Grid.Column="1" Text="Ready" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis"/>

                    <Button Name="btnClose" Grid.Column="2" Content="Close" Style="{DynamicResource GhostButton}" Height="32" MinWidth="80" Margin="0,0,8,0" IsCancel="True"/>
                    <Button Name="btnAnalyze" Grid.Column="3" Content="⚡ Analyze Clashes" Style="{DynamicResource PrimaryButton}" Height="32" MinWidth="140" IsDefault="True"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
