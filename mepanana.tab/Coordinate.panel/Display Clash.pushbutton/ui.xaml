<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Display Clash"
        Width="760" Height="540" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Scope Selector Card -->
            <RowDefinition Height="*"/>     <!-- 1: Symmetrical Two-Column Content -->
            <RowDefinition Height="Auto"/>  <!-- 2: Footer Action Bar -->
        </Grid.RowDefinitions>

        <!-- ── Top Card 0: Scope & Color Legend ───────────────────────────── -->
        <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,12" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Analysis Scope:" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox Grid.Column="1" Name="cmbScope" Height="32">
                    <ComboBoxItem Content="Active View (All Elements)"/>
                    <ComboBoxItem Content="Selected Elements Only"/>
                </ComboBox>

                <!-- Color Legend Badges -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#20EF4444" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Text="🔴 Host Model (Red)" FontSize="11.5" FontWeight="SemiBold" Foreground="#EF4444"/>
                    </Border>
                    <Border Background="#2022C55E" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="🟢 Linked Models (Green)" FontSize="11.5" FontWeight="SemiBold" Foreground="#22C55E"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Middle Row 1: Balanced Two-Column Grid ──────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left Column: Categories Selection Card ───────────────────── -->
            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Margin="0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Section Title & Mode Radios -->
                        <RowDefinition Height="Auto"/>  <!-- Action Bar: Label, Badge, All/None -->
                        <RowDefinition Height="*"/>     <!-- Scrollable Categories ListBox -->
                    </Grid.RowDefinitions>

                    <!-- Mode Radios -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Host Model Categories" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8"/>
                        <RadioButton Name="radDefault" Content="Use Default Settings (MEP Core)" IsChecked="True" Margin="0,0,0,5" FontWeight="SemiBold"/>
                        <RadioButton Name="radCustom" Content="Customize Settings" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Subheader Toolbar: Category Count + All/None Buttons -->
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="txtCategoryCount" Text="8 Selected" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button Name="btnSelectAll" Grid.Column="1" Content="All" Style="{DynamicResource GhostButton}" Height="24" MinWidth="44" Padding="8,0" FontSize="11" Margin="0,0,4,0"/>
                        <Button Name="btnSelectNone" Grid.Column="2" Content="None" Style="{DynamicResource GhostButton}" Height="24" MinWidth="44" Padding="8,0" FontSize="11"/>
                    </Grid>

                    <!-- Scrollable Category ListBox -->
                    <Border Grid.Row="2" Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
                        <ListBox Name="lstCategories" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="4,3.5" VerticalContentAlignment="Center"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Right Column: Detected Clashes Card ──────────────────────── -->
            <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Margin="0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Header Title & Badge -->
                        <RowDefinition Height="*"/>     <!-- Clashes ListBox -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Detected Clashes" Style="{DynamicResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                        <TextBlock Name="txtClashCount" Grid.Column="1" Text="0 clashes detected" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Clashes ListBox (Clean, single-line rows) -->
                    <Border Grid.Row="1" Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
                        <ListBox Name="lstClashes" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding DetailInfo}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Footer Action Bar ───────────────────────────────────────────── -->
        <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Margin="0" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ProgressBar Name="progressBar" Grid.Row="0" Height="6" Margin="0,2,0,10" Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Name="btnClear" Grid.Column="0" Content="🧹 Clear Analysis" Style="{DynamicResource GhostButton}" Height="32" MinWidth="130" ToolTip="Remove visual analysis highlights from view"/>

                    <TextBlock Name="txtStatus" Grid.Column="1" Text="Ready" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis"/>

                    <Button Name="btnClose" Grid.Column="2" Content="Close" Style="{DynamicResource GhostButton}" Height="32" MinWidth="80" Margin="0,0,8,0"/>
                    <Button Name="btnAnalyze" Grid.Column="3" Content="⚡ Analyze Clashes" Style="{DynamicResource PrimaryButton}" Height="32" MinWidth="140"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
