<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CAD Blocks to Revit"
        Width="840" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>

        <!-- ── Modern Sleek ScrollBar (Dark Theme) ───────────────────────────── -->
        <Style x:Key="ScrollBarTrackButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="{TemplateBinding Background}" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbVertical" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBd" CornerRadius="3" Background="#475569" Margin="1,0,1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbHorizontal" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBd" CornerRadius="3" Background="#475569" Margin="0,1,0,1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="#64748B"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumbHorizontal}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Margin" Value="2,0,0,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageUpCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumbVertical}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageDownCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Default High-Contrast Typography for Dark Mode Controls -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#334155"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <Border Name="Bd"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="7" Background="#10B981" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#064E3B"/>
                                <Setter Property="Foreground" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button Dark -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="7" Background="#1E293B"
                                BorderBrush="#334155" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#475569"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Action Button Dark -->
        <Style x:Key="TitleActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="Transparent"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Close Button Dark -->
        <Style x:Key="TitleCloseBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="Transparent"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#7F1D1D"/>
                                <Setter Property="Foreground" Value="#F87171"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Clean Dark ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Name="bd" CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="▾" FontSize="10"
                                               Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <ToggleButton Grid.ColumnSpan="2" Focusable="False" IsTabStop="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" IsHitTestVisible="True"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="#1E293B" BorderBrush="#475569" BorderThickness="1"
                                        CornerRadius="6" Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#10B981"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ROOT CONTAINER -->
    <Grid Margin="14">
        <!-- MASTER WINDOW SHELL (Dark Slate) -->
        <Border CornerRadius="12" Background="#0F172A"
                BorderBrush="#334155" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270"
                                  Color="#000000" Opacity="0.55"/>
            </Border.Effect>

            <Grid>
                <!-- Centered Watermark -->
                <Image Name="watermarkImage" Opacity="0.22"
                       Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top"
                       Width="380" Height="380" Margin="0,50,0,0"
                       IsHitTestVisible="False">
                    <Image.Effect>
                        <BlurEffect Radius="4"/>
                    </Image.Effect>
                </Image>

                <!-- Window Content Layout -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>   <!-- 0: Title Bar -->
                        <RowDefinition Height="2"/>    <!-- 1: Accent Line -->
                        <RowDefinition Height="Auto"/> <!-- 2: Content Area -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Custom Title Bar (Dark) -->
                    <Border Grid.Row="0" CornerRadius="11,11,0,0" Background="#1E293B"
                            BorderBrush="#334155" BorderThickness="0,0,0,1">
                        <Grid Name="titleBar" Margin="14,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Brand Badge -->
                            <Border Grid.Column="0" CornerRadius="5" Padding="6,2" Margin="0,0,9,0"
                                    Background="#064E3B" BorderBrush="#059669" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="MN" FontSize="10.5" Foreground="#34D399"/>
                            </Border>

                            <!-- Window Title -->
                            <TextBlock Grid.Column="1" Text="mepanana  ·  CAD Blocks"
                                       FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>

                            <!-- Theme Toggle Button -->
                            <Button Grid.Column="2" Name="btnToggleTheme" Content="☀️"
                                    ToolTip="Switch to Light Theme"
                                    Style="{StaticResource TitleActionBtn}" VerticalAlignment="Center"
                                    Margin="0,0,6,0"/>

                            <!-- Close Button -->
                            <Button Grid.Column="3" Name="btnClose" Content="✕"
                                    Style="{StaticResource TitleCloseBtn}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Row 1: Signature Gradient Line -->
                    <Rectangle Grid.Row="1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#10B981" Offset="0"/>
                                <GradientStop Color="#3B82F6" Offset="0.5"/>
                                <GradientStop Color="#F59E0B" Offset="0.8"/>
                                <GradientStop Color="#EF4444" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Row 2: Content Area (Form or Running Mode) -->
                    <Grid Grid.Row="2">
                        <StackPanel Name="pnlForm">
                        <!-- Window Header -->
                        <Grid Margin="18,14,18,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="CAD Blocks to Revit Families" FontSize="18" Foreground="#F8FAFC"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                <Border Grid.Column="1" CornerRadius="12" Padding="9,4" VerticalAlignment="Center"
                                        Background="#064E3B" BorderBrush="#059669" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Active View" FontSize="11" Foreground="#34D399"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="1" Text="Map CAD blocks by layer to Revit family types and place them with precise transforms."
                                       FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <!-- Top Card: CAD Link & Level Selectors (Dark Frosted Glass) -->
                        <Border Background="#E01E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1"
                                Margin="16,2,16,10" Padding="14,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270"
                                                  Color="#000000" Opacity="0.25"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- CAD Link -->
                                <Grid Grid.Column="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CAD Link:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1" Name="cmbCadLink" Style="{StaticResource ModernComboBox}"/>
                                </Grid>

                                <!-- Level -->
                                <Grid Grid.Column="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Level:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1" Name="cmbLevel" Style="{StaticResource ModernComboBox}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Master-Detail Content Grid -->
                        <Grid Margin="16,0,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="290"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Rules list (Dark Frosted Glass) -->
                            <Border Grid.Column="0" Background="#E01E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1"
                                    Padding="14,12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270"
                                                      Color="#000000" Opacity="0.25"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Fill="#10B981" RadiusX="1.5" RadiusY="1.5"/>
                                        <TextBlock Grid.Column="1" Text="Mapping Rules" FontSize="12.5" Foreground="#F8FAFC" Margin="8,0,0,0"/>
                                    </Grid>

                                    <ListBox Grid.Row="1" Name="lstRules" DisplayMemberPath="DisplayName"
                                             MinHeight="250" Height="250" Margin="0,0,0,10"
                                             Background="#0F172A" Foreground="#F8FAFC"
                                             BorderBrush="#334155" BorderThickness="1"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                                    <!-- Buttons below list -->
                                    <StackPanel Grid.Row="2">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Name="btnAddRule" Content="+ Add" Style="{StaticResource GhostBtn}" Height="30"/>
                                            <Button Grid.Column="2" Name="btnRemoveRule" Content="− Remove" Style="{StaticResource GhostBtn}" Height="30"/>
                                        </Grid>
                                        <Button Name="btnAutoScan" Content="⟳ Auto Scan Layers" Style="{StaticResource GhostBtn}" Height="30" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Name="btnSaveRules" Content="💾 Save" Style="{StaticResource GhostBtn}" Height="30"/>
                                            <Button Grid.Column="2" Name="btnLoadRules" Content="📂 Load" Style="{StaticResource GhostBtn}" Height="30"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Right: Rule Detail (Dark Frosted Glass) -->
                            <Border Grid.Column="2" Background="#E01E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1"
                                    Padding="16,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270"
                                                      Color="#000000" Opacity="0.25"/>
                                </Border.Effect>
                                <Grid Name="gridRuleDetails" IsEnabled="False">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>  <!-- title -->
                                        <RowDefinition Height="Auto"/>  <!-- layer -->
                                        <RowDefinition Height="Auto"/>  <!-- category + family -->
                                        <RowDefinition Height="Auto"/>  <!-- offset + rotation -->
                                        <RowDefinition Height="*"/>     <!-- spacer -->
                                        <RowDefinition Height="Auto"/>  <!-- preview btn -->
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Fill="#10B981" RadiusX="1.5" RadiusY="1.5"/>
                                        <TextBlock Grid.Column="1" Text="Rule Details" FontSize="12.5" Foreground="#F8FAFC" Margin="8,0,0,0"/>
                                    </Grid>

                                    <!-- CAD Layer -->
                                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                        <TextBlock Text="CAD Layer:" FontSize="11" Foreground="#94A3B8" Margin="1,0,0,4"/>
                                        <ComboBox Name="cmbRuleLayer" Style="{StaticResource ModernComboBox}"/>
                                    </StackPanel>

                                    <!-- Category + Family -->
                                    <Grid Grid.Row="2" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Category:" FontSize="11" Foreground="#94A3B8" Margin="1,0,0,4"/>
                                            <ComboBox Name="cmbRuleCategory" Style="{StaticResource ModernComboBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Family Type:" FontSize="11" Foreground="#94A3B8" Margin="1,0,0,4"/>
                                            <ComboBox Name="cmbRuleFamily" Style="{StaticResource ModernComboBox}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Offset + Rotation -->
                                    <Grid Grid.Row="3" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Vertical Offset:" FontSize="11" Foreground="#94A3B8" Margin="1,0,0,4"/>
                                            <Border Height="32" CornerRadius="6" Background="#0F172A"
                                                    BorderBrush="#334155" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Name="txtRuleOffset" Grid.Column="0" Text="0"
                                                             BorderThickness="0" Background="Transparent"
                                                             VerticalContentAlignment="Center" Padding="10,0"
                                                             Foreground="#F8FAFC" FontSize="12.5"
                                                             CaretBrush="#34D399"/>
                                                    <Border Grid.Column="1" Background="#1E293B"
                                                            BorderBrush="#334155" BorderThickness="1,0,0,0"
                                                            CornerRadius="0,5,5,0">
                                                        <TextBlock Text="mm" FontSize="11" Foreground="#94A3B8"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Rotation (°):" FontSize="11" Foreground="#94A3B8" Margin="1,0,0,4"/>
                                            <ComboBox Name="cmbRuleRotation" Style="{StaticResource ModernComboBox}" IsEditable="False">
                                                <ComboBoxItem Content="0" IsSelected="True"/>
                                                <ComboBoxItem Content="90"/>
                                                <ComboBoxItem Content="180"/>
                                                <ComboBoxItem Content="270"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Spacer -->
                                    <Border Grid.Row="4" MinHeight="10"/>

                                    <!-- Preview Single -->
                                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Name="btnPreviewSingle" Content="Preview Rule" Style="{StaticResource GhostBtn}"
                                                Width="140" Height="32" ToolTip="Place one sample element to verify mapping"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Footer Bar -->
                        <Border Padding="16,8,16,14" Background="Transparent">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ProgressBar Name="progressBar" Grid.Row="0" Height="4" Margin="0,0,0,8"
                                             Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100"/>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Name="txtStatus" Grid.Column="0" Text="Ready to place elements."
                                               FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center"/>

                                    <Button Grid.Column="1" Name="btnCancel" Content="Close"
                                            Style="{StaticResource GhostBtn}" IsCancel="True"/>

                                    <Button Grid.Column="3" Name="btnPlace" Content="Place All Elements"
                                            Style="{StaticResource PrimaryBtn}" IsDefault="True"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- RUNNING MODE: Modern Floating Capsule Dock -->
                    <Grid Name="pnlRunning" Visibility="Collapsed" VerticalAlignment="Stretch">
                        <Border VerticalAlignment="Bottom" Margin="14,0,14,14"
                                Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                CornerRadius="10" Padding="14,10,14,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270"
                                                  Color="#000000" Opacity="0.35"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Top row: Status title & Percentage -->
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Name="txtRunningTitle" Text="Placing Elements…"
                                               FontSize="12" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                    <TextBlock Name="txtRunningPercent" Text="0%"
                                               FontSize="12" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Middle row: Capsule Progress Bar -->
                                <Border Height="6" CornerRadius="3" Background="#0F172A" Margin="0,0,0,8" ClipToBounds="True">
                                    <ProgressBar Name="progressBarRunning" Height="6" BorderThickness="0"
                                                 Minimum="0" Maximum="100" Value="0"
                                                 Background="Transparent" Foreground="#10B981"/>
                                </Border>

                                <!-- Bottom row: Step detail & Cancel button -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Name="txtRunningDetail" Grid.Column="0" Text="Initializing CAD placement engine…"
                                               FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" Name="btnStopRunning" Content="Cancel"
                                            Style="{StaticResource GhostBtn}" Height="30" Padding="12,0"
                                            FontSize="11" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Grid>
</Window>
