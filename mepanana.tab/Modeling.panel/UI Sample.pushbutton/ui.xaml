<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UI Sample"
        Width="500" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>

        <!-- ── Primary Gradient Button ─────────────────────────────────────── -->
        <Style x:Key="DarkPrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#15C27D" Offset="0"/>
                                    <GradientStop Color="#55C046" Offset="0.28"/>
                                    <GradientStop Color="#EBBF13" Offset="0.55"/>
                                    <GradientStop Color="#F48712" Offset="0.78"/>
                                    <GradientStop Color="#F04A3C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Ghost Button ────────────────────────────────────────────────── -->
        <Style x:Key="DarkGhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" CornerRadius="8" Background="Transparent"
                                BorderBrush="#1EFFFFFF" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0DFFFFFF"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Title Close Button ──────────────────────────────────────────── -->
        <Style x:Key="TitleCloseBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" CornerRadius="6" Background="Transparent"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CCF04A3C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F04A3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Dark TextBox ────────────────────────────────────────────────── -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#15C27D"/>
            <Setter Property="SelectionBrush" Value="#15C27D60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="border" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4015C27D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2815C27D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Dark ComboBox ───────────────────────────────────────────────── -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Name="border" CornerRadius="7"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="▾" FontSize="10"
                                               Foreground="#475569"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <ToggleButton Grid.ColumnSpan="2" Focusable="False" IsTabStop="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" IsHitTestVisible="True"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="#141B2D" BorderBrush="#1E2D4A" BorderThickness="1"
                                        CornerRadius="8" Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4015C27D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="#CBD5E1"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="10,7"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border Name="border" Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#15C27D1A"/>
                                        <Setter Property="Foreground" Value="#E2E8F0"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#15C27D12"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <!-- ── Dark CheckBox ───────────────────────────────────────────────── -->
        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Name="checkBorder" Width="16" Height="16"
                                    CornerRadius="4" BorderThickness="1.5"
                                    BorderBrush="#30FFFFFF" Background="Transparent"
                                    VerticalAlignment="Center">
                                <TextBlock Name="checkMark" Text="✓" FontSize="10"
                                           Foreground="#15C27D"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" Margin="0,0,0,1"/>
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#15C27D"/>
                                <Setter TargetName="checkBorder" Property="Background" Value="#15C27D1A"/>
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#6015C27D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Dark RadioButton ────────────────────────────────────────────── -->
        <Style x:Key="DarkRadioBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Name="outerRing" Width="16" Height="16" CornerRadius="8"
                                    BorderThickness="1.5" BorderBrush="#30FFFFFF"
                                    Background="Transparent" VerticalAlignment="Center">
                                <Ellipse Name="innerDot" Width="7" Height="7" Fill="#15C27D"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="outerRing" Property="BorderBrush" Value="#15C27D"/>
                                <Setter TargetName="innerDot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outerRing" Property="BorderBrush" Value="#6015C27D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════════════════════
         ROOT GRID: Background Blobs + Glass Content
    ══════════════════════════════════════════════════════════════════════ -->
    <Grid>

        <!-- ── LAYER 0: Blurred Ambient Background ─────────────────────────── -->
        <Border CornerRadius="20" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#080D18" Offset="0"/>
                    <GradientStop Color="#0C1220" Offset="0.45"/>
                    <GradientStop Color="#090E1B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Canvas>
                <!-- Emerald glow — top-left -->
                <Ellipse Canvas.Left="-90" Canvas.Top="-110" Width="380" Height="300">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#5515C27D" Offset="0"/>
                            <GradientStop Color="#2215C27D" Offset="0.45"/>
                            <GradientStop Color="#0015C27D" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="65"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Amber glow — center-right -->
                <Ellipse Canvas.Right="-70" Canvas.Top="120" Width="320" Height="260">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#48F48712" Offset="0"/>
                            <GradientStop Color="#18F48712" Offset="0.55"/>
                            <GradientStop Color="#00F48712" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="55"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Red glow — bottom-left -->
                <Ellipse Canvas.Left="-60" Canvas.Bottom="-80" Width="270" Height="210">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#38F04A3C" Offset="0"/>
                            <GradientStop Color="#10F04A3C" Offset="0.5"/>
                            <GradientStop Color="#00F04A3C" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="50"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Blue subtle center glow -->
                <Ellipse Canvas.Left="150" Canvas.Top="200" Width="200" Height="160">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#223B82F6" Offset="0"/>
                            <GradientStop Color="#003B82F6" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="40"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Border>

        <!-- ── LAYER 1: Outer Glass Shell ──────────────────────────────────── -->
        <Border CornerRadius="20" BorderBrush="#12FFFFFF" BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>   <!-- 0: Custom Title Bar -->
                    <RowDefinition Height="2"/>    <!-- 1: Gradient Accent Line -->
                    <RowDefinition Height="Auto"/> <!-- 2: Hero Header -->
                    <RowDefinition Height="Auto"/> <!-- 3: Stats Row -->
                    <RowDefinition Height="Auto"/> <!-- 4: Body Cards -->
                    <RowDefinition Height="Auto"/> <!-- 5: Footer -->
                </Grid.RowDefinitions>

                <!-- ── Row 0: Custom Title Bar ──────────────────────────────── -->
                <Grid Grid.Row="0" Name="titleBar" Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App badge -->
                    <Border Grid.Column="0" CornerRadius="6" Padding="8,3" Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#15C27D25" Offset="0"/>
                                <GradientStop Color="#F4871225" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#15C27D60" Offset="0"/>
                                <GradientStop Color="#F4871260" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.BorderThickness>1</Border.BorderThickness>
                        <TextBlock Text="MN" FontSize="11" Foreground="#AAEBBF13"/>
                    </Border>

                    <!-- Title text -->
                    <TextBlock Grid.Column="1" Text="mepanana  ·  UI Sample" FontSize="12"
                               Foreground="#3CFFFFFF" VerticalAlignment="Center" LetterSpacing="0.5"/>

                    <!-- Version pill -->
                    <Border Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,10,0"
                            CornerRadius="4" Padding="6,2" Background="#0EFFFFFF"
                            BorderBrush="#0AFFFFFF" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="v2025.1" FontSize="9.5" Foreground="#30FFFFFF"/>
                    </Border>

                    <!-- Close button -->
                    <Button Grid.Column="2" Name="btnClose" Content="✕"
                            Width="30" Height="30" Margin="0,0,0,0"
                            Style="{StaticResource TitleCloseBtn}" VerticalAlignment="Center"/>
                </Grid>

                <!-- ── Row 1: Mepanana Gradient Accent Line ──────────────────── -->
                <Rectangle Grid.Row="1" Height="2">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#15C27D" Offset="0"/>
                            <GradientStop Color="#20CB66" Offset="0.18"/>
                            <GradientStop Color="#55C046" Offset="0.35"/>
                            <GradientStop Color="#B4BC1E" Offset="0.50"/>
                            <GradientStop Color="#EBBF13" Offset="0.65"/>
                            <GradientStop Color="#F48712" Offset="0.80"/>
                            <GradientStop Color="#F04A3C" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- ── Row 2: Hero Header ────────────────────────────────────── -->
                <Grid Grid.Row="2" Margin="20,18,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Dark Glassmorphism" FontSize="24" Foreground="#E2E8F0"
                                   LetterSpacing="-0.3"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                    Background="#15C27D15" BorderBrush="#15C27D35" BorderThickness="1">
                                <TextBlock Text="New UI System" FontSize="10.5" Foreground="#15C27D"/>
                            </Border>
                            <TextBlock Text="Ambient glow · Glass cards · Gradient accents"
                                       FontSize="11.5" Foreground="#40638296" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Active status badge -->
                    <Border Grid.Column="1" CornerRadius="20" Padding="10,5" VerticalAlignment="Center"
                            Background="#15C27D12" BorderBrush="#15C27D35" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#15C27D" VerticalAlignment="Center"
                                     Margin="0,0,5,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#15C27D" Opacity="0.9"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="Active" FontSize="11" Foreground="#15C27D"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Row 3: Metric Stats Row ───────────────────────────────── -->
                <Grid Grid.Row="3" Margin="20,14,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Stat 1 -->
                    <Border Grid.Column="0" Background="#0AFFFFFF" BorderBrush="#10FFFFFF"
                            BorderThickness="1" CornerRadius="8" Padding="12,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="256" FontSize="18" Foreground="#E2E8F0"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Elements" FontSize="10.5" Foreground="#30638296"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Stat 2 -->
                    <Border Grid.Column="2" Background="#0AFFFFFF" BorderBrush="#10FFFFFF"
                            BorderThickness="1" CornerRadius="8" Padding="12,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="3" FontSize="18" Foreground="#EBBF13"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Linked Files" FontSize="10.5" Foreground="#30638296"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Stat 3 -->
                    <Border Grid.Column="4" Background="#0AFFFFFF" BorderBrush="#10FFFFFF"
                            BorderThickness="1" CornerRadius="8" Padding="12,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="View" FontSize="16" Foreground="#3B82F6"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Active Scope" FontSize="10.5" Foreground="#30638296"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Row 4: Body Cards ─────────────────────────────────────── -->
                <StackPanel Grid.Row="4" Margin="16,12,16,0">

                    <!-- Card 1: Configuration ──────────────────────────────── -->
                    <Border Background="#0CFFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1"
                            CornerRadius="12" Padding="16,14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Card header row -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="7"
                                            Background="#15C27D1A" Margin="0,0,8,0">
                                        <TextBlock Text="⚙" FontSize="14" Foreground="#15C27D"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Configuration" FontSize="13" Foreground="#CBD5E1"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- Collapse toggle placeholder -->
                                <TextBlock Grid.Column="2" Text="▴" FontSize="10" Foreground="#30FFFFFF"
                                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>

                            <!-- Fields grid -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Discipline -->
                                <StackPanel Grid.Column="0" Grid.Row="0">
                                    <TextBlock Text="Discipline" FontSize="10.5" Foreground="#30638296"
                                               Margin="1,0,0,5"/>
                                    <ComboBox Name="cmbDiscipline" Height="32"
                                              Style="{StaticResource DarkComboBox}"/>
                                </StackPanel>

                                <!-- Method -->
                                <StackPanel Grid.Column="2" Grid.Row="0">
                                    <TextBlock Text="Method" FontSize="10.5" Foreground="#30638296"
                                               Margin="1,0,0,5"/>
                                    <ComboBox Name="cmbMethod" Height="32"
                                              Style="{StaticResource DarkComboBox}"/>
                                </StackPanel>

                                <!-- Tolerance (full width) -->
                                <StackPanel Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="3">
                                    <TextBlock Text="Tolerance (mm)" FontSize="10.5" Foreground="#30638296"
                                               Margin="1,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Name="txtTolerance" Height="32" Text="50"
                                                 Style="{StaticResource DarkTextBox}"/>
                                        <Border Grid.Column="1" Background="#0AFFFFFF"
                                                BorderBrush="#10FFFFFF" BorderThickness="1"
                                                CornerRadius="0,7,7,0" Padding="10,0" Margin="-1,0,0,0">
                                            <TextBlock Text="mm" FontSize="11.5" Foreground="#30638296"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Card 2: Options ─────────────────────────────────────── -->
                    <Border Background="#0CFFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1"
                            CornerRadius="12" Padding="16,14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Card header -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="28" Height="28" CornerRadius="7"
                                        Background="#EBBF1315" Margin="0,0,8,0">
                                    <TextBlock Text="⚡" FontSize="13" Foreground="#EBBF13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Options" FontSize="13" Foreground="#CBD5E1"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Checkboxes -->
                            <StackPanel Grid.Row="1">
                                <CheckBox Name="chkAutoDetect" IsChecked="True" Margin="0,0,0,9"
                                          Style="{StaticResource DarkCheckBox}">
                                    <TextBlock Text="Auto-detect connected elements" FontSize="12" Foreground="#94A3B8"/>
                                </CheckBox>
                                <CheckBox Name="chkLinkFiles" IsChecked="False" Margin="0,0,0,9"
                                          Style="{StaticResource DarkCheckBox}">
                                    <TextBlock Text="Include linked model elements" FontSize="12" Foreground="#94A3B8"/>
                                </CheckBox>
                                <CheckBox Name="chkAdvanced" IsChecked="False"
                                          Style="{StaticResource DarkCheckBox}">
                                    <TextBlock Text="Show advanced parameters" FontSize="12" Foreground="#94A3B8"/>
                                </CheckBox>
                            </StackPanel>

                            <!-- Advanced panel (toggleable) -->
                            <StackPanel Grid.Row="2" Name="pnlAdvanced" Visibility="Collapsed" Margin="0,10,0,0">
                                <Border Background="#07FFFFFF" BorderBrush="#0CFFFFFF" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Advanced Parameters"
                                                   FontSize="10.5" Foreground="#25638296" Margin="0,0,0,8"/>

                                        <!-- Radio group -->
                                        <StackPanel Grid.Row="0" Margin="0,16,0,0" Orientation="Horizontal">
                                            <RadioButton Name="radMode1" IsChecked="True" Margin="0,0,16,0"
                                                         Style="{StaticResource DarkRadioBtn}">
                                                <TextBlock Text="Fast" FontSize="12" Foreground="#94A3B8"/>
                                            </RadioButton>
                                            <RadioButton Name="radMode2" Margin="0,0,16,0"
                                                         Style="{StaticResource DarkRadioBtn}">
                                                <TextBlock Text="Balanced" FontSize="12" Foreground="#94A3B8"/>
                                            </RadioButton>
                                            <RadioButton Name="radMode3"
                                                         Style="{StaticResource DarkRadioBtn}">
                                                <TextBlock Text="Precision" FontSize="12" Foreground="#94A3B8"/>
                                            </RadioButton>
                                        </StackPanel>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Max Distance" FontSize="10.5"
                                                           Foreground="#25638296" Margin="1,0,0,5"/>
                                                <TextBox Height="30" Text="500"
                                                         Style="{StaticResource DarkTextBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Iterations" FontSize="10.5"
                                                           Foreground="#25638296" Margin="1,0,0,5"/>
                                                <TextBox Height="30" Text="3"
                                                         Style="{StaticResource DarkTextBox}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 3: Status Preview ─────────────────────────────── -->
                    <Border Background="#0CFFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1"
                            CornerRadius="12" Padding="16,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="28" Height="28" CornerRadius="7"
                                        Background="#3B82F614" Margin="0,0,8,0">
                                    <TextBlock Text="◈" FontSize="13" Foreground="#3B82F6"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="System Status" FontSize="13" Foreground="#CBD5E1"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <!-- Status row helper: 3 rows -->
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center"
                                             Margin="0,0,9,0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="5" ShadowDepth="0" Color="#10B981" Opacity="0.8"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1" Text="Engine module loaded"
                                               FontSize="12" Foreground="#6394A3B8" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#10B98118" CornerRadius="4"
                                            Padding="6,2" BorderBrush="#10B98130" BorderThickness="1">
                                        <TextBlock Text="OK" FontSize="10.5" Foreground="#10B981"/>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7" Fill="#F59E0B" VerticalAlignment="Center"
                                             Margin="0,0,9,0"/>
                                    <TextBlock Grid.Column="1" Text="Session auth pending"
                                               FontSize="12" Foreground="#6394A3B8" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#F59E0B18" CornerRadius="4"
                                            Padding="6,2" BorderBrush="#F59E0B30" BorderThickness="1">
                                        <TextBlock Text="WARN" FontSize="10.5" Foreground="#F59E0B"/>
                                    </Border>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7" Fill="#3B82F6" VerticalAlignment="Center"
                                             Margin="0,0,9,0"/>
                                    <TextBlock Grid.Column="1" Text="API connection active"
                                               FontSize="12" Foreground="#6394A3B8" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Background="#3B82F618" CornerRadius="4"
                                            Padding="6,2" BorderBrush="#3B82F630" BorderThickness="1">
                                        <TextBlock Text="INFO" FontSize="10.5" Foreground="#3B82F6"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>

                <!-- ── Row 5: Footer ─────────────────────────────────────────── -->
                <Border Grid.Row="5" Padding="16,12,16,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Indeterminate progress bar -->
                        <Border Grid.Row="0" CornerRadius="2" Background="#0AFFFFFF"
                                Height="3" Margin="0,0,0,10" Name="progressBorder"
                                Visibility="Collapsed">
                            <ProgressBar Name="progressBar" Height="3" BorderThickness="0"
                                         IsIndeterminate="True" Background="Transparent">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#15C27D" Offset="0"/>
                                        <GradientStop Color="#EBBF13" Offset="0.5"/>
                                        <GradientStop Color="#F04A3C" Offset="1"/>
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Name="txtStatus" Grid.Column="0" Text="Ready"
                                       FontSize="11" Foreground="#25638296" VerticalAlignment="Center"/>

                            <Button Grid.Column="1" Name="btnCancel" Content="Cancel"
                                    Style="{StaticResource DarkGhostBtn}"
                                    Height="36" Padding="16,0" IsCancel="True"/>

                            <Button Grid.Column="3" Name="btnRun" Content="▶   Run"
                                    Style="{StaticResource DarkPrimaryBtn}"
                                    Height="36" Padding="22,0" IsDefault="True"/>
                        </Grid>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- Outer rim glow effect -->
        <Border CornerRadius="20" BorderThickness="1" IsHitTestVisible="False">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2015C27D" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="0.5"/>
                    <GradientStop Color="#20F04A3C" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>

    </Grid>
</Window>
