<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pendent Sprinkler Studio"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource WindowBgBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Selection & Configuration Cards -->
            <RowDefinition Height="Auto" />  <!-- Live Schematic Preview Card -->
            <RowDefinition Height="Auto" />  <!-- Footer Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Selection & Configuration Cards -->
        <StackPanel Grid.Row="0" Orientation="Vertical">
            
            <!-- Card 1: Element Selection -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10" Padding="14">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="1. ELEMENT SELECTION" Style="{DynamicResource SectionTitle}" Margin="0,0,0,10" />
                    
                    <!-- Pick Main Pipe -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnPickMain" Content="🎯 Pick Main" Style="{DynamicResource GhostButton}" Height="32" />
                        <TextBlock x:Name="txtMainPipeStatus" Grid.Column="1" Text="No main pipe selected" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!-- Select Sprinklers -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnSelectSprinklers" Content="⛶ Select Heads" Style="{DynamicResource GhostButton}" Height="32" />
                        <TextBlock x:Name="txtSprinklerStatus" Grid.Column="1" Text="0 sprinklers selected" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: Dynamic Dual-Mode Connection Mode -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10" Padding="14">
                <StackPanel Orientation="Vertical">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="2. CONNECTION METHOD" Style="{DynamicResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                        <Button x:Name="btnStandards" Grid.Column="1" Content="📖 NFPA 13 &amp; TCVN 7336" Style="{DynamicResource GhostButton}" Height="26" Padding="10,2" FontSize="10.5" FontWeight="Bold" Cursor="Hand" ToolTip="Click to view detailed NFPA 13 and TCVN 7336 code clauses for this mode" />
                    </Grid>

                    <!-- Dual Mode RadioButtons -->
                    <Border Background="{DynamicResource WindowBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                        <StackPanel Orientation="Vertical">
                            <RadioButton x:Name="rbFlex" GroupName="SprinklerMode" IsChecked="True" Margin="0,0,0,8" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🌀" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Flexible Hose (G-FLEX S-Curve - NFPA 13)" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="rbRigid" GroupName="SprinklerMode" Margin="0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📐" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Rigid Steel Pipe (Direct Drop &amp; Riser Nipple)" FontWeight="Bold" Foreground="#3B82F6" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Parameters: Drop Size & Riser Height -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <TextBlock Text="Drop Pipe Size" Style="{DynamicResource FieldLabel}" Margin="0,0,0,4" />
                            <ComboBox x:Name="cmbDropSize" Height="30" FontSize="12">
                                <ComboBoxItem Content="DN25 (1&quot;) - Standard" IsSelected="True" />
                                <ComboBoxItem Content="DN32 (1-1/4&quot;)" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Vertical" x:Name="panelRiser">
                            <TextBlock x:Name="lblRiserHeight" Text="Riser Height (mm)" Style="{DynamicResource FieldLabel}" Margin="0,0,0,4" />
                            <TextBox x:Name="txtRiserHeight" Text="300" Height="30" FontSize="12" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="txtModeNote" Text="* Automatic minimum drop check (ΔZ ≥ 150mm / R ≥ 250mm per NFPA 13)" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" FontStyle="Italic" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- Card 3: Interactive Animated Schematic Preview -->
        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Margin="0,0,0,12" Padding="12">
            <StackPanel Orientation="Vertical">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="3. LIVE SCHEMATIC PREVIEW" Style="{DynamicResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="{DynamicResource SecondaryButtonBrush}" CornerRadius="4" Padding="6,2">
                        <TextBlock x:Name="txtPreviewTag" Text="⚡ Mode: Flex Hose S-Curve" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <Border Background="{DynamicResource WindowBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4">
                    <Canvas x:Name="canvasPreview" Height="150" ClipToBounds="True" Background="Transparent" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Footer Action Buttons -->
        <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="10" Margin="0,2,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Live Animated Progress Bar -->
                <ProgressBar x:Name="progressBar" Grid.Row="0" Height="6" Margin="0,2,0,10"
                             Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100"/>
                             
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnClose" Grid.Column="0" Content="Close" Style="{DynamicResource GhostButton}" Height="36" MinWidth="90" Margin="0,0,10,0" IsCancel="True" />
                    <Button x:Name="btnGenerate" Grid.Column="1" Content="🚀 CREATE SPRINKLER SYSTEM" Style="{DynamicResource PrimaryButton}" Height="36" IsDefault="True" />
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>