<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sidewall Sprinkler Connector"
        Width="480" Height="620" MinWidth="420" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource WindowBgBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />     <!-- Scrollable Cards & Preview -->
            <RowDefinition Height="Auto" />  <!-- Fixed Footer Action Bar -->
        </Grid.RowDefinitions>

        <!-- Scrollable Content Area -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
            <StackPanel Orientation="Vertical">
                
                <!-- Card 1: Element Selection -->
                <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10" Padding="14">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="1. ELEMENT SELECTION" Style="{DynamicResource SectionTitle}" Margin="0,0,0,10" />
                        
                        <!-- Pick Main Pipe -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnPickMain" Content="🎯 Pick Main" Style="{DynamicResource GhostButton}" Height="32" />
                            <TextBlock x:Name="txtMainPipeStatus" Grid.Column="1" Text="No main pipe selected" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <!-- Select Sprinklers -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnSelectSprinklers" Content="⛶ Select Heads" Style="{DynamicResource GhostButton}" Height="32" />
                            <TextBlock x:Name="txtSprinklerStatus" Grid.Column="1" Text="0 sprinklers selected" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2: Configuration -->
                <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10" Padding="14">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="2. SIZING &amp; WALL CLEARANCE" Style="{DynamicResource SectionTitle}" Margin="0,0,0,10" />
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                <TextBlock Text="Wall Clearance (mm)" Style="{DynamicResource FieldLabel}" Margin="0,0,0,4" />
                                <TextBox x:Name="txtRiserHeight" Text="100" Height="30" FontSize="12" TextAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Vertical">
                                <TextBlock Text="Branch Pipe Size" Style="{DynamicResource FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox x:Name="cmbDropSize" Height="30" FontSize="12">
                                    <ComboBoxItem Content="DN25 (1&quot;) - Standard" IsSelected="True" />
                                    <ComboBoxItem Content="DN32 (1-1/4&quot;)" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 3: Interactive Animated Schematic Preview -->
                <Border Style="{DynamicResource CardStyle}" Margin="0" Padding="12">
                    <StackPanel Orientation="Vertical">
                        <!-- Header with strict column separation to prevent any overlap -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="3. LIVE SCHEMATIC PREVIEW" Style="{DynamicResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="{DynamicResource SecondaryButtonBrush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="⚡ Live Reactivity: ON" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <Border Background="{DynamicResource WindowBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4">
                            <Canvas x:Name="canvasPreview" Height="145" ClipToBounds="True" Background="Transparent" />
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Action Buttons -->
        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="10" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Live Animated Progress Bar -->
                <ProgressBar x:Name="progressBar" Grid.Row="0" Height="6" Margin="0,2,0,10"
                             Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100"/>
                             
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnClose" Content="Close" Style="{DynamicResource GhostButton}" Height="36" IsCancel="True" />
                    <Button x:Name="btnGenerate" Grid.Column="1" Content="🚀 CREATE SPRINKLER SYSTEM" Style="{DynamicResource PrimaryButton}" Height="36" Margin="10,0,0,0" IsDefault="True" />
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>