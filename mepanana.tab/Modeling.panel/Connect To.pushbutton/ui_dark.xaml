<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect To Settings"
        Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <!-- Primary Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="7" Background="#10B981" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#064E3B"/>
                                <Setter Property="Foreground" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button Dark -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="7" Background="#1E293B"
                                BorderBrush="#334155" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#475569"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Action Button Dark -->
        <Style x:Key="TitleActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="Transparent"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Close Button Dark -->
        <Style x:Key="TitleCloseBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="Transparent"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#7F1D1D"/>
                                <Setter Property="Foreground" Value="#F87171"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark CheckBox -->
        <Style x:Key="ModernCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Name="box" Width="16" Height="16" CornerRadius="4"
                                    BorderThickness="1.2" BorderBrush="#475569"
                                    Background="#0F172A" VerticalAlignment="Center">
                                <TextBlock Name="mark" Text="✓" FontSize="10" Foreground="#34D399"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" Margin="0,0,0,1"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#10B981"/>
                                <Setter TargetName="box" Property="Background" Value="#064E3B"/>
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ROOT CONTAINER -->
    <Grid Margin="14">
        <!-- MASTER WINDOW SHELL (Dark Slate) -->
        <Border CornerRadius="12" Background="#0F172A"
                BorderBrush="#334155" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270"
                                  Color="#000000" Opacity="0.55"/>
            </Border.Effect>

            <Grid>
                <!-- Centered Watermark -->
                <Image Name="watermarkImage" Opacity="0.22"
                       Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top"
                       Width="300" Height="300" Margin="0,48,0,0"
                       IsHitTestVisible="False">
                    <Image.Effect>
                        <BlurEffect Radius="4"/>
                    </Image.Effect>
                </Image>

                <!-- Window Content Layout -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>   <!-- 0: Title Bar -->
                        <RowDefinition Height="2"/>    <!-- 1: Accent Line -->
                        <RowDefinition Height="Auto"/> <!-- 2: Content Area -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Custom Title Bar (Dark) -->
                    <Border Grid.Row="0" CornerRadius="11,11,0,0" Background="#1E293B"
                            BorderBrush="#334155" BorderThickness="0,0,0,1">
                        <Grid Name="titleBar" Margin="14,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Brand Badge -->
                            <Border Grid.Column="0" CornerRadius="5" Padding="6,2" Margin="0,0,9,0"
                                    Background="#064E3B" BorderBrush="#059669" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="MN" FontSize="10.5" Foreground="#34D399"/>
                            </Border>

                            <!-- Window Title -->
                            <TextBlock Grid.Column="1" Text="mepanana  ·  Connect To"
                                       FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>

                            <!-- Theme Toggle Button -->
                            <Button Grid.Column="2" Name="btnToggleTheme" Content="☀️"
                                    ToolTip="Switch to Light Theme"
                                    Style="{StaticResource TitleActionBtn}" VerticalAlignment="Center"
                                    Margin="0,0,6,0"/>

                            <!-- Close Button -->
                            <Button Grid.Column="3" Name="btnClose" Content="✕"
                                    Style="{StaticResource TitleCloseBtn}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Row 1: Signature Gradient Line -->
                    <Rectangle Grid.Row="1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#10B981" Offset="0"/>
                                <GradientStop Color="#3B82F6" Offset="0.5"/>
                                <GradientStop Color="#F59E0B" Offset="0.8"/>
                                <GradientStop Color="#EF4444" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Row 2: Form Content -->
                    <StackPanel Grid.Row="2" Name="pnlForm">
                        <!-- Window Header -->
                        <Grid Margin="18,14,18,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Connect To Settings" FontSize="18" Foreground="#F8FAFC"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                <Border Grid.Column="1" CornerRadius="12" Padding="9,4" VerticalAlignment="Center"
                                        Background="#064E3B" BorderBrush="#059669" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Active" FontSize="11" Foreground="#34D399"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="1" Text="Configure intelligent multi-tier MEP connection tolerance."
                                       FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <!-- Card: Alignment Tolerance (Dark Frosted Glass) -->
                        <StackPanel Margin="16,2,16,8">
                            <Border Background="#E01E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1"
                                    Padding="16,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270"
                                                      Color="#000000" Opacity="0.25"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Section Header -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Fill="#10B981" RadiusX="1.5" RadiusY="1.5"/>
                                        <TextBlock Grid.Column="1" Text="Coaxial Alignment Tolerance"
                                                   FontSize="12.5" Foreground="#F8FAFC" Margin="8,0,0,0"/>
                                    </Grid>

                                    <TextBlock Text="Maximum lateral offset for automatic axis correction:"
                                               FontSize="11" Foreground="#94A3B8" Margin="1,0,0,6"/>

                                    <!-- Tolerance Input: Seamless Badge (Dark) -->
                                    <Border Height="32" CornerRadius="6" Background="#0F172A"
                                            BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="42"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Name="txtMaxOffset" Grid.Column="0" Text="100"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalContentAlignment="Center" Padding="10,0"
                                                     Foreground="#F8FAFC" FontSize="12.5"
                                                     CaretBrush="#34D399"/>
                                            <Border Grid.Column="1" Background="#1E293B"
                                                    BorderBrush="#334155" BorderThickness="1,0,0,0"
                                                    CornerRadius="0,5,5,0">
                                                <TextBlock Text="mm" FontSize="11" Foreground="#94A3B8"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Quick Presets -->
                                    <TextBlock Text="Quick Presets" FontSize="11" Foreground="#94A3B8" Margin="1,0,0,6"/>
                                    <UniformGrid Rows="1" Columns="4" Margin="0,0,0,12">
                                        <Button Name="btnPreset25" Content="25 mm"
                                                Height="32" MinWidth="0" Padding="0"
                                                Style="{StaticResource GhostBtn}" Margin="0,0,4,0"/>
                                        <Button Name="btnPreset50" Content="50 mm"
                                                Height="32" MinWidth="0" Padding="0"
                                                Style="{StaticResource GhostBtn}" Margin="2,0,2,0"/>
                                        <Button Name="btnPreset100" Content="100 mm"
                                                Height="32" MinWidth="0" Padding="0"
                                                Style="{StaticResource GhostBtn}" Margin="2,0,2,0"/>
                                        <Button Name="btnPreset200" Content="200 mm"
                                                Height="32" MinWidth="0" Padding="0"
                                                Style="{StaticResource GhostBtn}" Margin="4,0,0,0"/>
                                    </UniformGrid>

                                    <!-- Safe Alignment Checkbox -->
                                    <CheckBox Name="chkAllowMove" IsChecked="True"
                                              Style="{StaticResource ModernCheck}">
                                        <TextBlock Text="Allow auto-shifting standalone elements within tolerance"
                                                   Foreground="#E2E8F0" TextWrapping="Wrap"/>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Footer Bar -->
                        <Border Padding="16,8,16,14" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Name="txtStatus" Grid.Column="0" Text="Ready"
                                           FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center"/>

                                <Button Grid.Column="1" Name="btnCancel" Content="Cancel"
                                        Style="{StaticResource GhostBtn}" IsCancel="True"/>

                                <Button Grid.Column="3" Name="btnSave" Content="Save Settings"
                                        Style="{StaticResource PrimaryBtn}" IsDefault="True"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
