<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MEP Route" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Angle Configuration Card -->
            <RowDefinition Height="Auto"/>  <!-- 1: Instructions & Guidance Card -->
            <RowDefinition Height="Auto"/>  <!-- 2: Footer Action Bar -->
        </Grid.RowDefinitions>

        <!-- ── Card 1: Angle Configuration ────────────────────────────────── -->
        <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,12" Padding="16">
            <StackPanel>
                <TextBlock Text="1. ROUTING ANGLE CONFIGURATION" Style="{DynamicResource SectionTitle}" Margin="0,0,0,12"/>

                <!-- Standard Angle Selector -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Standard Angle:" Style="{DynamicResource FieldLabel}"/>
                    <ComboBox Name="cmbAngle" Grid.Column="1" Height="32">
                        <ComboBoxItem Content="90.0°"/>
                        <ComboBoxItem Content="60.0°"/>
                        <ComboBoxItem Content="45.0°" IsSelected="True"/>
                        <ComboBoxItem Content="30.0°"/>
                        <ComboBoxItem Content="22.5°"/>
                        <ComboBoxItem Content="11.25°"/>
                        <ComboBoxItem Content="Custom"/>
                    </ComboBox>
                </Grid>

                <!-- Custom Angle Input -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Custom Angle:" Style="{DynamicResource FieldLabel}"/>
                    <TextBox Name="txtCustom" Grid.Column="1" Height="32" Margin="0,0,8,0" IsEnabled="False" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="(°)" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── Card 2: Guidance & Supported Elements ───────────────────────── -->
        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Margin="0,0,0,12" Padding="14,12">
            <StackPanel>
                <TextBlock Text="2. ROUTING GUIDE" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8"/>

                <Border Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                    <TextBlock Text="Pick 2 parallel MEP elements (Pipes, Ducts, Cable Trays, or Conduits) to generate an angled offset with elbow fittings." FontSize="11.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="16"/>
                </Border>

                <TextBlock Text="💡 Tip: Press ESC during picking to exit or return here to change angles." FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
            </StackPanel>
        </Border>

        <!-- ── Card 3: Footer Action Bar ───────────────────────────────────── -->
        <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Margin="0" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ProgressBar Name="progressBar" Grid.Row="0" Height="4" Margin="0,0,0,8" Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Name="txtStatus" Grid.Column="0" Text="Ready" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                    <Button Name="btnCancel" Grid.Column="1" Content="Close" Style="{DynamicResource GhostButton}" Height="32" MinWidth="80" Margin="0,0,8,0" IsCancel="True"/>
                    <Button Name="btnRoute" Grid.Column="2" Content="Pick &amp; Route" Style="{DynamicResource PrimaryButton}" Height="32" MinWidth="120" IsDefault="True"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
