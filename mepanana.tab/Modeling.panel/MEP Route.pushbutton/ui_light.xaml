<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MEP Route"
        Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <!-- Primary Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="7" Background="#10B981" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#A7F3D0"/>
                                <Setter Property="Foreground" Value="#ECFDF5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="7" Background="#F1F5F9"
                                BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Action Button -->
        <Style x:Key="TitleActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="Transparent"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Close Button -->
        <Style x:Key="TitleCloseBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="Transparent"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FECACA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Clean ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Name="bd" CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="▾" FontSize="10"
                                               Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <ToggleButton Grid.ColumnSpan="2" Focusable="False" IsTabStop="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" IsHitTestVisible="True"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                                        CornerRadius="6" Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.08" Color="#0F172A"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#10B981"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ROOT CONTAINER -->
    <Grid Margin="14">
        <!-- MASTER WINDOW SHELL -->
        <Border CornerRadius="12" Background="#F8FAFC"
                BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                  Color="#0F172A" Opacity="0.14"/>
            </Border.Effect>

            <Grid>
                <!-- Centered Watermark -->
                <Image Name="watermarkImage" Opacity="0.18"
                       Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top"
                       Width="300" Height="300" Margin="0,48,0,0"
                       IsHitTestVisible="False">
                    <Image.Effect>
                        <BlurEffect Radius="4"/>
                    </Image.Effect>
                </Image>

                <!-- Window Content Layout -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>   <!-- 0: Title Bar -->
                        <RowDefinition Height="2"/>    <!-- 1: Accent Line -->
                        <RowDefinition Height="Auto"/> <!-- 2: Content Area -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Custom Title Bar -->
                    <Border Grid.Row="0" CornerRadius="11,11,0,0" Background="#F1F5F9"
                            BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid Name="titleBar" Margin="14,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Brand Badge -->
                            <Border Grid.Column="0" CornerRadius="5" Padding="6,2" Margin="0,0,9,0"
                                    Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="MN" FontSize="10.5" Foreground="#059669"/>
                            </Border>

                            <!-- Window Title -->
                            <TextBlock Grid.Column="1" Text="mepanana  ·  MEP Route"
                                       FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>

                            <!-- Theme Toggle Button -->
                            <Button Grid.Column="2" Name="btnToggleTheme" Content="🌙"
                                    ToolTip="Switch to Dark Theme"
                                    Style="{StaticResource TitleActionBtn}" VerticalAlignment="Center"
                                    Margin="0,0,6,0"/>

                            <!-- Close Button -->
                            <Button Grid.Column="3" Name="btnClose" Content="✕"
                                    Style="{StaticResource TitleCloseBtn}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Row 1: Signature Gradient Line -->
                    <Rectangle Grid.Row="1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#10B981" Offset="0"/>
                                <GradientStop Color="#3B82F6" Offset="0.5"/>
                                <GradientStop Color="#F59E0B" Offset="0.8"/>
                                <GradientStop Color="#EF4444" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Row 2: Form Content -->
                    <StackPanel Grid.Row="2" Name="pnlForm">
                        <!-- Window Header -->
                        <Grid Margin="18,14,18,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="MEP Route" FontSize="18" Foreground="#0F172A"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                <Border Grid.Column="1" CornerRadius="12" Padding="9,4" VerticalAlignment="Center"
                                        Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Active" FontSize="11" Foreground="#059669"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="1" Text="Generate precision angled elbow routing between parallel MEP elements."
                                       FontSize="11.5" Foreground="#64748B" Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <!-- Cards Container -->
                        <StackPanel Margin="16,2,16,8">
                            <!-- Card 1: Angle Configuration -->
                            <Border Background="#E6FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1"
                                    Padding="16,14" Margin="0,0,0,10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270"
                                                      Color="#0F172A" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Section Header -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Fill="#10B981" RadiusX="1.5" RadiusY="1.5"/>
                                        <TextBlock Grid.Column="1" Text="Routing Angle Configuration"
                                                   FontSize="12.5" Foreground="#0F172A" Margin="8,0,0,0"/>
                                    </Grid>

                                    <!-- Standard Angle Selector -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Standard Angle" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <ComboBox Name="cmbAngle" Grid.Column="1" Style="{StaticResource ModernComboBox}">
                                            <ComboBoxItem Content="90.0°"/>
                                            <ComboBoxItem Content="60.0°"/>
                                            <ComboBoxItem Content="45.0°" IsSelected="True"/>
                                            <ComboBoxItem Content="30.0°"/>
                                            <ComboBoxItem Content="22.5°"/>
                                            <ComboBoxItem Content="11.25°"/>
                                            <ComboBoxItem Content="Custom"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Custom Angle Input -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Custom Angle" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Height="32" CornerRadius="6" Background="White"
                                                BorderBrush="#CBD5E1" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Name="txtCustom" Grid.Column="0"
                                                         BorderThickness="0" Background="Transparent"
                                                         VerticalContentAlignment="Center" Padding="10,0"
                                                         Foreground="#0F172A" FontSize="12.5"
                                                         CaretBrush="#10B981" IsEnabled="False"/>
                                                <Border Grid.Column="1" Background="#F1F5F9"
                                                        BorderBrush="#CBD5E1" BorderThickness="1,0,0,0"
                                                        CornerRadius="0,5,5,0">
                                                    <TextBlock Text="°" FontSize="12" Foreground="#64748B"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Routing Guide -->
                            <Border Background="#E6FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1"
                                    Padding="16,12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270"
                                                      Color="#0F172A" Opacity="0.03"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Section Header -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Fill="#10B981" RadiusX="1.5" RadiusY="1.5"/>
                                        <TextBlock Grid.Column="1" Text="Routing Guide"
                                                   FontSize="12.5" Foreground="#0F172A" Margin="8,0,0,0"/>
                                    </Grid>

                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <TextBlock Text="Pick 2 parallel MEP elements (Pipes, Ducts, Cable Trays, or Conduits) to generate an angled offset with elbow fittings."
                                                   FontSize="11.5" Foreground="#334155" TextWrapping="Wrap" LineHeight="16"/>
                                    </Border>
                                    <TextBlock Text="💡 Tip: Press ESC during picking to exit or return here to change angles."
                                               FontSize="11" Foreground="#64748B"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Footer Bar -->
                        <Border Padding="16,8,16,14" Background="Transparent">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ProgressBar Name="progressBar" Grid.Row="0" Height="3" Margin="0,0,0,10"
                                             Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100"/>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Name="txtStatus" Grid.Column="0" Text="Ready"
                                               FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>

                                    <Button Grid.Column="1" Name="btnCancel" Content="Close"
                                            Style="{StaticResource GhostBtn}" IsCancel="True"/>

                                    <Button Grid.Column="3" Name="btnRoute" Content="Pick &amp; Route"
                                            Style="{StaticResource PrimaryBtn}" IsDefault="True"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
