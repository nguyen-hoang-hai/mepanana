<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bloom Settings - MEPANANA"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI"
        FontSize="12">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Auto Bloom Configuration"
                           FontSize="15"
                           Foreground="#0F172A"/>
                <TextBlock Text="Configure stub-out dimensions and disciplines for open connectors"
                           FontSize="11.5"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Card 1: Stub Length -->
        <Border Grid.Row="1" Style="{DynamicResource CardStyle}">
            <StackPanel>
                <TextBlock Text="1. STUB LENGTH" Style="{DynamicResource SectionTitle}"/>
                <TextBlock Text="Set default length for generated pipe and duct segments:"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,4,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Name="txtStubLength"
                             Grid.Column="0"
                             Height="32"
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             Text="300"
                             BorderBrush="{DynamicResource InputBorderBrush}"
                             BorderThickness="1"/>
                    <TextBlock Grid.Column="1"
                               Text="mm"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </Grid>

                <!-- Quick Presets -->
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Presets:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11.5"/>
                    <UniformGrid Grid.Column="1" Rows="1" Columns="4">
                        <Button Name="btnPreset150" Content="150 mm" Margin="0,0,6,0" Height="26" Style="{DynamicResource GhostButton}"/>
                        <Button Name="btnPreset200" Content="200 mm" Margin="0,0,6,0" Height="26" Style="{DynamicResource GhostButton}"/>
                        <Button Name="btnPreset300" Content="300 mm" Margin="0,0,6,0" Height="26" Style="{DynamicResource GhostButton}"/>
                        <Button Name="btnPreset500" Content="500 mm" Margin="0,0,0,0" Height="26" Style="{DynamicResource GhostButton}"/>
                    </UniformGrid>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Card 2: Disciplines & Options -->
        <Border Grid.Row="2" Style="{DynamicResource CardStyle}">
            <StackPanel>
                <TextBlock Text="2. DISCIPLINES &amp; CONNECTIVITY" Style="{DynamicResource SectionTitle}"/>
                <TextBlock Text="Select which open connector types will be bloomed:"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,4,0,10"/>

                <CheckBox Name="chkPipes"
                          Content="Piping (Plumbing, Fire Protection, Hydronics)"
                          IsChecked="True"
                          Margin="0,0,0,8"/>
                <CheckBox Name="chkDucts"
                          Content="HVAC Ducts (Supply, Return, Exhaust)"
                          IsChecked="True"
                          Margin="0,0,0,8"/>
                <CheckBox Name="chkCableTrays"
                          Content="Cable Trays (Thang Máng Cáp)"
                          IsChecked="True"
                          Margin="0,0,0,8"/>
                <CheckBox Name="chkConduits"
                          Content="Electrical Conduits"
                          IsChecked="True"
                          Margin="0,0,0,12"/>

                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12"/>

                <CheckBox Name="chkAutoConnect"
                          Content="Auto-connect generated stub to fitting connector"
                          IsChecked="True"
                          Margin="0,0,0,4"/>
                <TextBlock Text="Maintains a continuous MEP system with sealed connections"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="11"
                           Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Name="btnCancel"
                    Grid.Column="1"
                    Content="Cancel"
                    Style="{DynamicResource GhostButton}"
                    IsCancel="True"
                    Width="90"
                    Height="32"
                    Margin="0,0,8,0"/>

            <Button Name="btnSave"
                    Grid.Column="2"
                    Content="Save Settings"
                    Style="{DynamicResource PrimaryButton}"
                    IsDefault="True"
                    Width="110"
                    Height="32"/>
        </Grid>
    </Grid>
</Window>
