<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bloom Settings - MEPANANA"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI"
        FontSize="12">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Bloom Settings"
                           FontSize="15"
                           Foreground="#0F172A"/>
                <TextBlock Text="Set default stub extension distance for open connectors"
                           FontSize="11.5"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Card: Stub Length Configuration -->
        <Border Grid.Row="1" Style="{DynamicResource CardStyle}">
            <StackPanel>
                <TextBlock Text="STUB EXTENSION LENGTH" Style="{DynamicResource SectionTitle}"/>
                <TextBlock Text="Default length for generated pipe, duct, tray, and conduit stubs:"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,2,0,12"/>

                <!-- Input Box with Embedded Unit -->
                <Grid Margin="0,0,0,14">
                    <TextBox Name="txtStubLength"
                             Height="34"
                             FontSize="13.5"
                             VerticalContentAlignment="Center"
                             Padding="12,0,45,0"
                             Text="300"
                             BorderBrush="{DynamicResource InputBorderBrush}"
                             BorderThickness="1"/>
                    <TextBlock Text="mm"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"/>
                </Grid>

                <!-- Quick Presets -->
                <TextBlock Text="Quick Presets:"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="11"
                           Margin="0,0,0,8"/>

                <UniformGrid Rows="1" Columns="4" Margin="0,0,0,4">
                    <Button Name="btnPreset150"
                            Content="150 mm"
                            Height="34"
                            MinWidth="0"
                            Padding="0"
                            FontSize="12"
                            Margin="0,0,6,0"
                            Style="{DynamicResource GhostButton}"/>
                    <Button Name="btnPreset200"
                            Content="200 mm"
                            Height="34"
                            MinWidth="0"
                            Padding="0"
                            FontSize="12"
                            Margin="0,0,6,0"
                            Style="{DynamicResource GhostButton}"/>
                    <Button Name="btnPreset300"
                            Content="300 mm"
                            Height="34"
                            MinWidth="0"
                            Padding="0"
                            FontSize="12"
                            Margin="0,0,6,0"
                            Style="{DynamicResource GhostButton}"/>
                    <Button Name="btnPreset500"
                            Content="500 mm"
                            Height="34"
                            MinWidth="0"
                            Padding="0"
                            FontSize="12"
                            Margin="0,0,0,0"
                            Style="{DynamicResource GhostButton}"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Name="btnCancel"
                    Grid.Column="1"
                    Content="Cancel"
                    Style="{DynamicResource GhostButton}"
                    IsCancel="True"
                    Width="85"
                    Height="32"
                    Margin="0,0,8,0"/>

            <Button Name="btnSave"
                    Grid.Column="2"
                    Content="Save Settings"
                    Style="{DynamicResource PrimaryButton}"
                    IsDefault="True"
                    Width="110"
                    Height="32"/>
        </Grid>
    </Grid>
</Window>
