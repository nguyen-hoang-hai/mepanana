<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fire Detector Studio"
        Width="480" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>

        <!-- ── Modern Sleek ScrollBar ─────────────────────────────────────────── -->
        <Style x:Key="ScrollBarTrackButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="{TemplateBinding Background}" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbVertical" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBd" CornerRadius="3" Background="#CBD5E1" Margin="1,0,1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Margin" Value="2,0,0,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageUpCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumbVertical}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageDownCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="7" Background="#10B981" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#A7F3D0"/>
                                <Setter Property="Foreground" Value="#ECFDF5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="7" Background="#F1F5F9"
                                BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Action Button -->
        <Style x:Key="TitleActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="Transparent"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Close Button -->
        <Style x:Key="TitleCloseBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="Transparent"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FECACA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern RadioButton -->
        <Style x:Key="ModernRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Name="ring" Width="16" Height="16" CornerRadius="8"
                                    BorderThickness="1.2" BorderBrush="#CBD5E1"
                                    Background="White" VerticalAlignment="Center">
                                <Ellipse Name="dot" Width="6" Height="6" Fill="#EF4444"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="#EF4444"/>
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Clean ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Name="bd" CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="▾" FontSize="10"
                                               Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <ToggleButton Grid.ColumnSpan="2" Focusable="False" IsTabStop="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" IsHitTestVisible="True"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                                        CornerRadius="6" Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.08" Color="#0F172A"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#EF4444"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preset Pill Button -->
        <Style x:Key="PresetPill" TargetType="Button">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="5" Background="#F1F5F9"
                                BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FECACA"/>
                                <Setter Property="Foreground" Value="#DC2626"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FECACA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ROOT CONTAINER -->
    <Grid Margin="14">
        <!-- MASTER WINDOW SHELL -->
        <Border CornerRadius="12" Background="#F8FAFC"
                BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                  Color="#0F172A" Opacity="0.14"/>
            </Border.Effect>

            <Grid>
                <!-- Window Content Layout -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>   <!-- 0: Title Bar -->
                        <RowDefinition Height="2"/>    <!-- 1: Accent Line -->
                        <RowDefinition Height="Auto"/> <!-- 2: Content Area -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Custom Title Bar -->
                    <Border Grid.Row="0" CornerRadius="11,11,0,0" Background="#F1F5F9"
                            BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid Name="titleBar" Margin="14,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Brand Badge -->
                            <Border Grid.Column="0" CornerRadius="5" Padding="6,2" Margin="0,0,9,0"
                                    Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="MN" FontSize="10.5" Foreground="#DC2626"/>
                            </Border>

                            <!-- Window Title -->
                            <TextBlock Grid.Column="1" Text="mepanana  ·  Fire Detector"
                                       FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>

                            <!-- Theme Toggle Button -->
                            <Button Grid.Column="2" Name="btnToggleTheme" Content="🌙"
                                    ToolTip="Switch to Dark Theme"
                                    Style="{StaticResource TitleActionBtn}" VerticalAlignment="Center"
                                    Margin="0,0,6,0"/>

                            <!-- Close Button -->
                            <Button Grid.Column="3" Name="btnClose" Content="✕"
                                    Style="{StaticResource TitleCloseBtn}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Row 1: Signature Gradient Line (fire-toned) -->
                    <Rectangle Grid.Row="1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#EF4444" Offset="0"/>
                                <GradientStop Color="#F97316" Offset="0.4"/>
                                <GradientStop Color="#F59E0B" Offset="0.7"/>
                                <GradientStop Color="#EF4444" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Row 2: Content Area (Form or Running Mode) -->
                    <Grid Grid.Row="2">
                        <StackPanel Name="pnlForm">

                            <!-- Window Header -->
                            <Grid Margin="18,14,18,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Fire Detector Studio" FontSize="18" Foreground="#0F172A"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                    <Border Grid.Column="1" CornerRadius="12" Padding="9,4" VerticalAlignment="Center"
                                            Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="#EF4444" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="TCVN 5738:2021" FontSize="11" Foreground="#DC2626"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Grid.Row="1" Text="Tự động bố trí đầu báo cháy theo lưới đều trong vùng chọn."
                                           FontSize="11.5" Foreground="#64748B" Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </Grid>

                            <!-- Cards Container -->
                            <StackPanel Margin="16,2,16,8">

                                <!-- Card 1: Chọn Family đầu báo -->
                                <Border Background="#E6FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1"
                                        Padding="14,12" Margin="0,0,0,10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270"
                                                          Color="#0F172A" Opacity="0.03"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- Card header -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Fill="#EF4444" RadiusX="1.5" RadiusY="1.5"/>
                                            <TextBlock Grid.Column="1" Text="1. Chọn loại đầu báo" FontSize="12.5" Foreground="#0F172A" Margin="8,0,0,0"/>
                                        </Grid>

                                        <!-- Family Dropdown Header with Reload button -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Family Symbol:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Name="btnRefreshFamilies" Content="🔄 Tải lại"
                                                    Style="{StaticResource GhostBtn}" Height="30" Padding="8,0" FontSize="11"/>
                                        </Grid>
                                        <ComboBox Name="cmbFamily" Style="{StaticResource ModernComboBox}" Margin="0,0,0,8"/>

                                        <!-- Detector Type Info -->
                                        <TextBlock Name="txtFamilyHint" Text="Vui lòng chọn family từ danh sách trên."
                                                   FontSize="10.5" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Chọn vùng bố trí -->
                                <Border Background="#E6FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1"
                                        Padding="14,12" Margin="0,0,0,10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270"
                                                          Color="#0F172A" Opacity="0.03"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- Card header -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Fill="#EF4444" RadiusX="1.5" RadiusY="1.5"/>
                                            <TextBlock Grid.Column="1" Text="2. Xác định vùng bố trí" FontSize="12.5" Foreground="#0F172A" Margin="8,0,0,0"/>
                                        </Grid>

                                        <!-- Zone Mode RadioButtons (2 Kiểu theo yêu cầu) -->
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                            <StackPanel>
                                                <RadioButton Name="rbPickBox" GroupName="ZoneMode" IsChecked="True" Style="{StaticResource ModernRadio}" Margin="0,0,0,6">
                                                    <TextBlock Text="⬛ Quét PickBox  — Khoanh vùng hình chữ nhật (2 góc chéo)" Foreground="#0F172A" IsHitTestVisible="False"/>
                                                </RadioButton>
                                                <RadioButton Name="rbDrawLine" GroupName="ZoneMode" Style="{StaticResource ModernRadio}">
                                                    <TextBlock Text="✏️ Kẻ Line / Đa giác  — Click các điểm, nhấn Esc để kết thúc" Foreground="#0F172A" IsHitTestVisible="False"/>
                                                </RadioButton>
                                            </StackPanel>
                                        </Border>

                                        <!-- Pick Zone Button + Status -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Name="btnPickZone" Content="🎯 Chọn vùng" Style="{StaticResource GhostBtn}" Height="32"/>
                                            <TextBlock Name="txtZoneStatus" Grid.Column="1" Text="Chưa chọn vùng"
                                                       FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Cấu hình khoảng cách -->
                                <Border Background="#E6FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1"
                                        Padding="14,12" Margin="0,0,0,10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270"
                                                          Color="#0F172A" Opacity="0.03"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- Card header -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Fill="#EF4444" RadiusX="1.5" RadiusY="1.5"/>
                                            <TextBlock Grid.Column="1" Text="3. Cấu hình khoảng cách" FontSize="12.5" Foreground="#0F172A" Margin="8,0,0,0"/>
                                        </Grid>

                                        <!-- D_max Row -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="D_max (mm):" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                                <Border Height="32" CornerRadius="6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="42"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Name="txtDMax" Grid.Column="0" Text="9000"
                                                                 BorderThickness="0" Background="Transparent"
                                                                 VerticalContentAlignment="Center" Padding="10,0"
                                                                 Foreground="#0F172A" FontSize="12.5"
                                                                 CaretBrush="#EF4444"/>
                                                        <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1,0,0,0" CornerRadius="0,5,5,0">
                                                            <TextBlock Text="mm" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Cao độ Z (mm):" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                                <Border Height="32" CornerRadius="6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="42"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Name="txtZOffset" Grid.Column="0" Text="2800"
                                                                 BorderThickness="0" Background="Transparent"
                                                                 VerticalContentAlignment="Center" Padding="10,0"
                                                                 Foreground="#0F172A" FontSize="12.5"
                                                                 CaretBrush="#EF4444"/>
                                                        <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1,0,0,0" CornerRadius="0,5,5,0">
                                                            <TextBlock Text="mm" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Preset D_max Buttons -->
                                        <TextBlock Text="Preset nhanh (TCVN 5738:2021):" FontSize="10.5" Foreground="#64748B" Margin="0,0,0,6"/>
                                        <WrapPanel>
                                            <Button Name="btnPreset9000" Content="Khói ≤3.5m · 9000" Style="{StaticResource PresetPill}"/>
                                            <Button Name="btnPreset7500" Content="Khói 3.5-6m · 7500" Style="{StaticResource PresetPill}"/>
                                            <Button Name="btnPreset5400" Content="Nhiệt ROR · 5400" Style="{StaticResource PresetPill}"/>
                                            <Button Name="btnPreset4500" Content="Nhiệt Fixed · 4500" Style="{StaticResource PresetPill}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Card 4: Kết quả preview -->
                                <Border Background="#E6FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1"
                                        Padding="14,12" Margin="0,0,0,4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270"
                                                          Color="#0F172A" Opacity="0.03"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- Card header -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Fill="#EF4444" RadiusX="1.5" RadiusY="1.5"/>
                                            <TextBlock Grid.Column="1" Text="4. Kết quả dự kiến" FontSize="12.5" Foreground="#0F172A" Margin="8,0,0,0"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Vùng chọn:" FontSize="10.5" Foreground="#64748B"/>
                                                <TextBlock Name="txtZoneSummary" Text="—" FontSize="11.5" Foreground="#0F172A" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Dự kiến đầu báo:" FontSize="10.5" Foreground="#64748B"/>
                                                <TextBlock Name="txtPointCount" Text="—" FontSize="11.5" Foreground="#EF4444"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>

                            <!-- Footer Bar -->
                            <Border Padding="16,8,16,14" Background="Transparent">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <ProgressBar Name="progressBar" Grid.Row="0" Height="4" Margin="0,0,0,8"
                                                 Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100"/>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Name="txtStatus" Grid.Column="0" Text="Sẵn sàng"
                                                   FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>

                                        <Button Grid.Column="1" Name="btnFooterClose" Content="Đóng"
                                                Style="{StaticResource GhostBtn}" IsCancel="True"/>

                                        <Button Grid.Column="3" Name="btnGenerate" Content="🔥 Bố trí đầu báo"
                                                Style="{StaticResource PrimaryBtn}" IsDefault="True"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- RUNNING MODE: Modern Floating Capsule Dock -->
                        <Grid Name="pnlRunning" Visibility="Collapsed" VerticalAlignment="Stretch">
                            <Border VerticalAlignment="Bottom" Margin="14,0,14,14"
                                    Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                                    CornerRadius="10" Padding="14,10,14,10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270"
                                                      Color="#0F172A" Opacity="0.10"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Top row: Status title & Percentage -->
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Name="txtRunningTitle" Text="Đang bố trí đầu báo…"
                                                   FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        <TextBlock Name="txtRunningPercent" Text="0%"
                                                   FontSize="12" Foreground="#EF4444" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Middle row: Capsule Progress Bar -->
                                    <Border Height="6" CornerRadius="3" Background="#E2E8F0" Margin="0,0,0,8" ClipToBounds="True">
                                        <ProgressBar Name="progressBarRunning" Height="6" BorderThickness="0"
                                                     Minimum="0" Maximum="100" Value="0"
                                                     Background="Transparent" Foreground="#EF4444"/>
                                    </Border>

                                    <!-- Bottom row: Step detail & Cancel button -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Name="txtRunningDetail" Grid.Column="0" Text="Đang tính toán lưới điểm…"
                                                   FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" Name="btnStopRunning" Content="Hủy"
                                                Style="{StaticResource GhostBtn}" Height="30" Padding="12,0"
                                                FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
