<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule Link"
        Width="880" Height="650" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Segmented Tab Switcher -->
            <RowDefinition Height="*"/>     <!-- Main Content Area -->
        </Grid.RowDefinitions>

        <!-- ── Segmented Tab Switcher ──────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="4" Margin="0,0,0,16" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <RadioButton Name="rbTabExport" Content="📤  Export to Excel"
                             IsChecked="True" Style="{DynamicResource SegmentedRadioButton}"
                             Padding="20,8" FontWeight="SemiBold" FontSize="13"/>
                <RadioButton Name="rbTabImport" Content="📥  Import from Excel"
                             IsChecked="False" Style="{DynamicResource SegmentedRadioButton}"
                             Padding="20,8" FontWeight="SemiBold" FontSize="13" Margin="4,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── TAB 1: EXPORT ──────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Name="panelExport" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>     <!-- Schedules Selection Card -->
                <RowDefinition Height="Auto"/>  <!-- File Path & Action Bar -->
            </Grid.RowDefinitions>

            <!-- Schedules Card -->
            <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,14" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Title & Search Bar -->
                        <RowDefinition Height="Auto"/>  <!-- Select All / Deselect All / Count -->
                        <RowDefinition Height="*"/>     <!-- Schedules ListBox -->
                        <RowDefinition Height="Auto"/>  <!-- Options Checkboxes -->
                    </Grid.RowDefinitions>

                    <!-- Title & Search -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Project Schedules"
                                   Style="{DynamicResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>

                        <!-- Search Box with Icon -->
                        <Grid Grid.Column="2">
                            <TextBox Name="txtSearchExport" Height="32" Padding="28,4,8,4"
                                     VerticalContentAlignment="Center" FontSize="12.5"/>
                            <TextBlock Text="🔍" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Margin="8,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>

                    <!-- Selection Buttons & Selected Counter -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Name="btnSelectAll" Content="✓ Select All"
                                    Style="{DynamicResource GhostButton}" Height="30" Padding="12,2" Margin="0,0,8,0"/>
                            <Button Name="btnDeselectAll" Content="✕ Deselect All"
                                    Style="{DynamicResource GhostButton}" Height="30" Padding="12,2"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Name="txtSelectedCount" Text="0 of 0 selected"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                    </Grid>

                    <!-- Schedules ListBox with Virtualization -->
                    <ListBox Grid.Row="2" Name="lstExportSchedules"
                             Margin="0,0,0,12"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.IsDeferredScrollingEnabled="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                    <!-- Options -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox Name="chkVisibleOnly" Content="Visible fields only"
                                  IsChecked="True" Margin="0,0,28,0" VerticalContentAlignment="Center"/>
                        <CheckBox Name="chkOpenAfter" Content="Open folder / file after export"
                                  IsChecked="True" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Export Folder Location & Action Footer -->
            <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Height="68" Padding="16,8" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Live Animated Progress Bar -->
                    <ProgressBar Name="progressExport" Grid.Row="0" Height="6" Margin="0,2,0,10"
                                 Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Export Folder:" Style="{DynamicResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1" Name="txtExportFolder" Height="34" Padding="10,4"
                                 VerticalContentAlignment="Center" IsReadOnly="True"/>
                        <Button Grid.Column="2" Name="btnBrowseFolder" Content="📂 Browse Folder..."
                                Style="{DynamicResource GhostButton}" Height="34" Width="140" Margin="10,0,0,0"/>

                        <Button Grid.Column="4" Name="btnExport" Content="📤 Export to Excel"
                                Style="{DynamicResource PrimaryButton}" Height="34" Width="170"
                                FontWeight="SemiBold" FontSize="13"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ── TAB 2: IMPORT ──────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Name="panelImport" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- File Picker Card -->
                <RowDefinition Height="*"/>     <!-- Preview & Diff Table -->
                <RowDefinition Height="Auto"/>  <!-- Action Footer -->
            </Grid.RowDefinitions>

            <!-- File Picker Card -->
            <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,14" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Excel File:" Style="{DynamicResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1" Name="txtImportPath" Height="34" Padding="10,4"
                             VerticalContentAlignment="Center" IsReadOnly="True"/>
                    <Button Grid.Column="2" Name="btnBrowseImport" Content="📂 Browse..."
                            Style="{DynamicResource GhostButton}" Height="34" Width="105" Margin="10,0,0,0"/>

                    <Button Grid.Column="4" Name="btnPreviewDiff" Content="🔍 Preview Changes"
                            Style="{DynamicResource GhostButton}" Height="34" Width="160"
                            FontWeight="SemiBold" FontSize="13"/>
                </Grid>
            </Border>

            <!-- Preview Diff Table Card -->
            <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Margin="0,0,0,14" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Badges Bar -->
                        <RowDefinition Height="*"/>     <!-- Diff ListView -->
                    </Grid.RowDefinitions>

                    <!-- Stat Badges Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Change Preview"
                                   Style="{DynamicResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Border Background="#FEF3C7" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                                <TextBlock Name="txtChangesBadge" Text="🟡 0 Changes"
                                           Foreground="#92400E" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#F1F5F9" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                                <TextBlock Name="txtUnchangedBadge" Text="🟢 0 Unchanged"
                                           Foreground="#475569" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#FEE2E2" CornerRadius="4" Padding="10,4">
                                <TextBlock Name="txtReadonlyBadge" Text="🔒 0 Read-Only"
                                           Foreground="#991B1B" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ListView for Diff Results with Virtualization -->
                    <ListView Grid.Row="1" Name="lvDiff"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.IsDeferredScrollingEnabled="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Schedule" Width="160" DisplayMemberBinding="{Binding Sheet}"/>
                                <GridViewColumn Header="Element ID" Width="95" DisplayMemberBinding="{Binding ElementId}"/>
                                <GridViewColumn Header="Parameter" Width="145" DisplayMemberBinding="{Binding Field}"/>
                                <GridViewColumn Header="Old Value (Revit)" Width="155" DisplayMemberBinding="{Binding OldVal}"/>
                                <GridViewColumn Header="New Value (Excel)" Width="155" DisplayMemberBinding="{Binding NewVal}"/>
                                <GridViewColumn Header="Status" Width="110" DisplayMemberBinding="{Binding StatusDisplay}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- Import Action Footer -->
            <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Height="68" Padding="16,8" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Live Animated Progress Bar -->
                    <ProgressBar Name="progressImport" Grid.Row="0" Height="6" Margin="0,2,0,10"
                                 Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Name="btnApplyImport" Content="📥 Apply Import to Revit"
                                Style="{DynamicResource PrimaryButton}" Height="34" Width="200"
                                FontWeight="SemiBold" FontSize="13" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>