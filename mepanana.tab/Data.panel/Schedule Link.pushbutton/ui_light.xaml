<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule Link"
        Width="880" Height="650" MinWidth="760" MinHeight="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>

        <!-- ── Modern Sleek ScrollBar ─────────────────────────────────────────── -->
        <Style x:Key="ScrollBarTrackButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="{TemplateBinding Background}" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbVertical" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBd" CornerRadius="3" Background="#CBD5E1" Margin="1,0,1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbHorizontal" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBd" CornerRadius="3" Background="#CBD5E1" Margin="0,1,0,1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBd" Property="Background" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumbHorizontal}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Margin" Value="2,0,0,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageUpCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumbVertical}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarTrackButton}" Command="ScrollBar.PageDownCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Default ListBox Styles -->
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <Border Name="Bd"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="#10B981" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#A7F3D0"/>
                                <Setter Property="Foreground" Value="#ECFDF5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="#F1F5F9"
                                BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Action Button -->
        <Style x:Key="TitleActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="Transparent"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Close Button -->
        <Style x:Key="TitleCloseBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="Transparent"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FCA5A5"/>
                                <Setter Property="Foreground" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Tab RadioButton -->
        <Style x:Key="SegmentedTabRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Name="bd" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#0F172A" Opacity="0.08"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Shadow Layer -->
    <Grid Margin="12">
        <Border Background="#F8FAFC" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                  Color="#0F172A" Opacity="0.14"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <!-- Watermark Background Logo -->
                <Image Name="watermarkImage"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Width="320" Height="320"
                       Opacity="0.12" Stretch="Uniform"
                       IsHitTestVisible="False">
                    <Image.Effect>
                        <BlurEffect Radius="1.5"/>
                    </Image.Effect>
                </Image>

                <!-- Window Content Grid -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>  <!-- Row 0: TitleBar -->
                        <RowDefinition Height="2"/>   <!-- Row 1: Signature Gradient Line -->
                        <RowDefinition Height="*"/>   <!-- Row 2: Form Content -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: TitleBar -->
                    <Border Grid.Row="0" Name="titleBar" Background="#FFFFFF" CornerRadius="11,11,0,0" Padding="14,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Brand Badge -->
                            <Border Grid.Column="0" CornerRadius="5" Padding="6,2" Margin="0,0,9,0"
                                    Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="MN" FontSize="10.5" Foreground="#059669"/>
                            </Border>

                            <!-- Window Title -->
                            <TextBlock Grid.Column="1" Text="mepanana  ·  Schedule Link"
                                       FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>

                            <!-- Theme Toggle Button -->
                            <Button Grid.Column="2" Name="btnToggleTheme" Content="🌙"
                                    ToolTip="Switch to Dark Theme"
                                    Style="{StaticResource TitleActionBtn}" VerticalAlignment="Center"
                                    Margin="0,0,6,0"/>

                            <!-- Close Button -->
                            <Button Grid.Column="3" Name="btnClose" Content="✕"
                                    Style="{StaticResource TitleCloseBtn}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Row 1: Signature Gradient Line -->
                    <Rectangle Grid.Row="1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#10B981" Offset="0"/>
                                <GradientStop Color="#3B82F6" Offset="0.5"/>
                                <GradientStop Color="#F59E0B" Offset="0.8"/>
                                <GradientStop Color="#EF4444" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Row 2: Form Content -->
                    <Grid Grid.Row="2" Margin="16,12,16,14">
                        <Grid Name="pnlForm">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>  <!-- Segmented Tab Switcher -->
                                <RowDefinition Height="*"/>     <!-- Main Content Area -->
                            </Grid.RowDefinitions>

                        <!-- ── Segmented Tab Switcher ──────────────────────────────────────── -->
                        <Border Grid.Row="0" Background="#E2E8F0"
                                BorderBrush="#CBD5E1" BorderThickness="1"
                                CornerRadius="8" Padding="3" Margin="0,0,0,12" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Name="rbTabExport" Content="📤  Export to Excel"
                                             IsChecked="True" Style="{StaticResource SegmentedTabRadio}"
                                             GroupName="TabGroup"/>
                                <RadioButton Name="rbTabImport" Content="📥  Import from Excel"
                                             IsChecked="False" Style="{StaticResource SegmentedTabRadio}"
                                             GroupName="TabGroup" Margin="3,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- ── TAB 1: EXPORT ──────────────────────────────────────────────── -->
                        <Grid Grid.Row="1" Name="panelExport" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>     <!-- Schedules Selection Card -->
                                <RowDefinition Height="Auto"/>  <!-- File Path & Action Bar -->
                            </Grid.RowDefinitions>

                            <!-- Schedules Card -->
                            <Border Grid.Row="0" Background="#E6FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1"
                                    Margin="0,0,0,10" Padding="14,12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="#0F172A" Opacity="0.03"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>  <!-- Title & Search Bar -->
                                        <RowDefinition Height="Auto"/>  <!-- Select All / Deselect All / Count -->
                                        <RowDefinition Height="*"/>     <!-- Schedules ListBox -->
                                        <RowDefinition Height="Auto"/>  <!-- Options Checkboxes -->
                                    </Grid.RowDefinitions>

                                    <!-- Title & Search -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Rectangle Fill="#10B981" Width="3" RadiusX="1.5" RadiusY="1.5" Margin="0,0,6,0"/>
                                            <TextBlock Text="PROJECT SCHEDULES" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Search Box with Icon -->
                                        <Border Grid.Column="2" Height="32" CornerRadius="6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#94A3B8"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBox Name="txtSearchExport" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                                         VerticalContentAlignment="Center" FontSize="12" Foreground="#0F172A"
                                                         CaretBrush="#10B981" Tag="Filter schedules..."/>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Selection Buttons & Selected Counter -->
                                    <Grid Grid.Row="1" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Button Name="btnSelectAll" Content="✓ Select All"
                                                    Style="{StaticResource GhostBtn}" Height="28" Padding="10,0" Margin="0,0,6,0"/>
                                            <Button Name="btnDeselectAll" Content="✕ Deselect All"
                                                    Style="{StaticResource GhostBtn}" Height="28" Padding="10,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Name="txtSelectedCount" Text="0 of 0 selected"
                                                   Foreground="#64748B" FontSize="11.5"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Schedules ListBox -->
                                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="3">
                                        <ListBox Name="lstExportSchedules" BorderThickness="0" Background="Transparent"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 ScrollViewer.IsDeferredScrollingEnabled="False"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                    </Border>

                                    <!-- Options -->
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,2,0,0">
                                        <CheckBox Name="chkVisibleOnly" Content="Visible fields only"
                                                  IsChecked="True" Margin="0,0,24,0" VerticalContentAlignment="Center" FontSize="11.5" Foreground="#334155"/>
                                        <CheckBox Name="chkOpenAfter" Content="Open folder / file after export"
                                                  IsChecked="True" VerticalContentAlignment="Center" FontSize="11.5" Foreground="#334155"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Export Folder Location & Action Footer -->
                            <Border Grid.Row="1" Background="#E6FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14,10" Margin="0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="#0F172A" Opacity="0.03"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Progress Bar -->
                                    <ProgressBar Name="progressExport" Grid.Row="0" Height="4" Margin="0,0,0,8"
                                                 Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100"/>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Export Folder:" FontSize="12" Foreground="#475569"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>

                                        <Border Grid.Column="1" Height="34" CornerRadius="6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
                                            <TextBox Name="txtExportFolder" BorderThickness="0" Background="Transparent"
                                                     VerticalContentAlignment="Center" Padding="8,0" IsReadOnly="True"
                                                     Foreground="#0F172A" FontSize="12"/>
                                        </Border>

                                        <Button Grid.Column="2" Name="btnBrowseFolder" Content="📂 Browse..."
                                                Style="{StaticResource GhostBtn}" Height="34" Padding="12,0" Margin="8,0,0,0"/>

                                        <Button Grid.Column="4" Name="btnFooterClose" Content="Close"
                                                Style="{StaticResource GhostBtn}" Height="34" Width="80" IsCancel="True"/>

                                        <Button Grid.Column="6" Name="btnExport" Content="📤 Export to Excel"
                                                Style="{StaticResource PrimaryBtn}" Height="34" Padding="18,0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ── TAB 2: IMPORT ──────────────────────────────────────────────── -->
                        <Grid Grid.Row="1" Name="panelImport" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>  <!-- File Picker Card -->
                                <RowDefinition Height="*"/>     <!-- Preview & Diff Table -->
                                <RowDefinition Height="Auto"/>  <!-- Action Footer -->
                            </Grid.RowDefinitions>

                            <!-- File Picker Card -->
                            <Border Grid.Row="0" Background="#E6FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1"
                                    Margin="0,0,0,10" Padding="14,10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="#0F172A" Opacity="0.03"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Excel File:" FontSize="12" Foreground="#475569"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <Border Grid.Column="1" Height="34" CornerRadius="6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
                                        <TextBox Name="txtImportPath" BorderThickness="0" Background="Transparent"
                                                 VerticalContentAlignment="Center" Padding="8,0" IsReadOnly="True"
                                                 Foreground="#0F172A" FontSize="12"/>
                                    </Border>

                                    <Button Grid.Column="2" Name="btnBrowseImport" Content="📂 Browse..."
                                            Style="{StaticResource GhostBtn}" Height="34" Padding="12,0" Margin="8,0,0,0"/>

                                    <Button Grid.Column="4" Name="btnPreviewDiff" Content="🔍 Preview Changes"
                                            Style="{StaticResource GhostBtn}" Height="34" Padding="14,0"/>
                                </Grid>
                            </Border>

                            <!-- Preview Diff Table Card -->
                            <Border Grid.Row="1" Background="#E6FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1"
                                    Margin="0,0,0,10" Padding="14,12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="#0F172A" Opacity="0.03"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>  <!-- Badges Bar -->
                                        <RowDefinition Height="*"/>     <!-- Diff ListView -->
                                    </Grid.RowDefinitions>

                                    <!-- Stat Badges Bar -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Rectangle Fill="#10B981" Width="3" RadiusX="1.5" RadiusY="1.5" Margin="0,0,6,0"/>
                                            <TextBlock Text="CHANGE PREVIEW" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                                                <TextBlock Name="txtChangesBadge" Text="🟡 0 Changes" Foreground="#92400E" FontSize="11.5"/>
                                            </Border>
                                            <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                                                <TextBlock Name="txtUnchangedBadge" Text="🟢 0 Unchanged" Foreground="#475569" FontSize="11.5"/>
                                            </Border>
                                            <Border Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                                <TextBlock Name="txtReadonlyBadge" Text="🔒 0 Read-Only" Foreground="#991B1B" FontSize="11.5"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- ListView for Diff Results -->
                                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="2">
                                        <ListView Name="lvDiff" BorderThickness="0" Background="Transparent"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  ScrollViewer.IsDeferredScrollingEnabled="False"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Schedule" Width="160" DisplayMemberBinding="{Binding Sheet}"/>
                                                    <GridViewColumn Header="Element ID" Width="95" DisplayMemberBinding="{Binding ElementId}"/>
                                                    <GridViewColumn Header="Parameter" Width="145" DisplayMemberBinding="{Binding Field}"/>
                                                    <GridViewColumn Header="Old Value (Revit)" Width="155" DisplayMemberBinding="{Binding OldVal}"/>
                                                    <GridViewColumn Header="New Value (Excel)" Width="155" DisplayMemberBinding="{Binding NewVal}"/>
                                                    <GridViewColumn Header="Status" Width="110" DisplayMemberBinding="{Binding StatusDisplay}"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Import Action Footer -->
                            <Border Grid.Row="2" Background="#E6FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14,10" Margin="0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="#0F172A" Opacity="0.03"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Progress Bar -->
                                    <ProgressBar Name="progressImport" Grid.Row="0" Height="4" Margin="0,0,0,8"
                                                 Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100"/>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Name="btnCloseImport" Content="Close"
                                                Style="{StaticResource GhostBtn}" Height="34" Width="80" Margin="0,0,8,0" IsCancel="True"/>
                                        <Button Name="btnApplyImport" Content="📥 Apply Import to Revit"
                                                Style="{StaticResource PrimaryBtn}" Height="34" Padding="18,0"
                                                IsEnabled="False"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- RUNNING MODE: Modern Floating Capsule Dock -->
                    <Grid Name="pnlRunning" Visibility="Collapsed" VerticalAlignment="Stretch">
                        <Border VerticalAlignment="Bottom" Margin="0,0,0,0"
                                Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="10" Padding="14,10,14,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270"
                                                  Color="#0F172A" Opacity="0.10"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Top row: Status title & Percentage -->
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Name="txtRunningTitle" Text="Exporting Schedules…"
                                               FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <TextBlock Name="txtRunningPercent" Text="0%"
                                               FontSize="12" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Middle row: Capsule Progress Bar -->
                                <Border Height="6" CornerRadius="3" Background="#E2E8F0" Margin="0,0,0,8" ClipToBounds="True">
                                    <ProgressBar Name="progressBarRunning" Height="6" BorderThickness="0"
                                                 Minimum="0" Maximum="100" Value="0"
                                                 Background="Transparent" Foreground="#10B981"/>
                                </Border>

                                <!-- Bottom row: Step detail & Cancel button -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Name="txtRunningDetail" Grid.Column="0" Text="Processing schedule data…"
                                               FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" Name="btnStopRunning" Content="Cancel"
                                            Style="{StaticResource GhostBtn}" Height="30" Padding="12,0"
                                            FontSize="11" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Grid>
</Window>
