<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Cloud"
        Width="1060" Height="680" MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource WindowBgBrush}">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Segmented Switcher & Status -->
            <RowDefinition Height="*" />     <!-- Main Tab Content -->
            <RowDefinition Height="Auto" />  <!-- Tier 3 FooterBar with ProgressBar & Batch Actions -->
        </Grid.RowDefinitions>

        <!-- ── Top Header Bar ─────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Segmented Tab Switcher (Only 2 Clean Tabs) -->
            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Name="rbTabBrowse" Content="🛒  Online Library"
                                 IsChecked="True" Style="{DynamicResource SegmentedRadioButton}"
                                 Padding="18,6" FontWeight="SemiBold" FontSize="12.5" />
                    <RadioButton Name="rbTabUpload" Content="☁️  Upload Family"
                                 IsChecked="False" Style="{DynamicResource SegmentedRadioButton}"
                                 Padding="18,6" FontWeight="SemiBold" FontSize="12.5" Margin="4,0,0,0" />
                </StackPanel>
            </Border>

            <!-- Right Status & Refresh -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6"
                        Height="32" Padding="12,0" Margin="0,0,8,0" VerticalAlignment="Center"
                        ToolTip="Mepanana Family Cloud is active and connected">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Name="dotCloudStatus" Width="7" Height="7" Fill="#16A34A" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Name="txtCloudStatus" Text="Cloud Online" FontSize="12" Foreground="#15803D" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button Name="btnRefresh" Content="🔄 Refresh" Style="{DynamicResource GhostButton}" Height="32" Padding="14,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ── TAB 1: BROWSE LIBRARY ──────────────────────────────────────── -->
        <Grid Grid.Row="1" Name="panelBrowse" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" /> <!-- Categories Sidebar -->
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />   <!-- Cards Grid (3 Cards Per Row) -->
            </Grid.ColumnDefinitions>

            <!-- Left Categories Sidebar -->
            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Categories" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8" />

                    <!-- Categories ListBox -->
                    <ListBox Grid.Row="1" Name="listCategories"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1" Background="{DynamicResource SecondaryButtonBrush}" CornerRadius="10" Padding="5,1" Margin="4,0,0,0">
                                        <TextBlock Text="{Binding Count}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Dynamic Version Filter in Sidebar Footer -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="Family Version:" Style="{DynamicResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox Name="cmbVersionFilter" Height="28" FontSize="11.5" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Families Catalog Area -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Search Bar & Controls -->
                    <RowDefinition Height="*" />    <!-- Cards ScrollViewer -->
                </Grid.RowDefinitions>

                <!-- Search, Select All, Batch Actions & Compatibility Filters Toolbar -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />        <!-- Search Box -->
                        <ColumnDefinition Width="Auto" />     <!-- Select All -->
                        <ColumnDefinition Width="Auto" />     <!-- Batch Load -->
                        <ColumnDefinition Width="Auto" />     <!-- Batch Delete -->
                        <ColumnDefinition Width="Auto" />     <!-- Compatible Only -->
                        <ColumnDefinition Width="Auto" />     <!-- Families Found Counter -->
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <TextBox Name="txtSearch" Height="34" Padding="30,4,8,4" VerticalContentAlignment="Center" FontSize="12" />
                        <TextBlock Text="🔍" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" />
                    </Grid>

                    <!-- Select All Pill Button -->
                    <CheckBox Name="chkSelectAll" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Hand"
                              ToolTip="Select or Deselect all currently filtered families for batch operations">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <Border Name="borderPill" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="34" Padding="10,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Name="txtIcon" Text="☑️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Name="txtLabel" Text="Select All" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="borderPill" Property="Background" Value="#EFF6FF" />
                                        <Setter TargetName="borderPill" Property="BorderBrush" Value="#93C5FD" />
                                        <Setter TargetName="txtLabel" Property="Foreground" Value="#1D4ED8" />
                                        <Setter TargetName="txtLabel" Property="Text" Value="Deselect All" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="borderPill" Property="BorderBrush" Value="#2563EB" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>
                    </CheckBox>

                    <!-- Batch Load Button (Sleek Pill Button) -->
                    <Button Name="btnBatchLoad" Grid.Column="2"
                            Click="OnBatchLoadClick"
                            Height="34" Padding="10,0" Margin="0,0,6,0"
                            IsEnabled="False" Cursor="Hand"
                            ToolTip="Load all selected families into the active Revit project">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#EFF6FF" />
                                <Setter Property="BorderBrush" Value="#BFDBFE" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                                <Setter Property="FontSize" Value="11.5" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#DBEAFE" />
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#2563EB" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📥" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Name="txtBatchLoadCount" Text="Load (0)" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Batch Delete Button (Sleek Danger Pill Button) -->
                    <Button Name="btnBatchDelete" Grid.Column="3"
                            Click="OnBatchDeleteClick"
                            Height="34" Padding="10,0" Margin="0,0,8,0"
                            IsEnabled="False" Cursor="Hand"
                            ToolTip="Delete all selected families from Cloud Library">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FEF2F2" />
                                <Setter Property="BorderBrush" Value="#FECACA" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="#DC2626" />
                                <Setter Property="FontSize" Value="11.5" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FEE2E2" />
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#EF4444" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🗑️" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Name="txtBatchDeleteCount" Text="Delete" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Smart Compatibility Shield Toggle Pill Button -->
                    <CheckBox Name="chkCompatibleOnly" Grid.Column="4" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand"
                              ToolTip="Filter to show only families compatible with your current Revit version">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <Border Name="borderPill" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="34" Padding="10,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Name="txtIcon" Text="🛡️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Name="txtLabel" Text="Compatible Only" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="borderPill" Property="Background" Value="#DCFCE7" />
                                        <Setter TargetName="borderPill" Property="BorderBrush" Value="#86EFAC" />
                                        <Setter TargetName="txtLabel" Property="Foreground" Value="#15803D" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="borderPill" Property="BorderBrush" Value="#2563EB" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>
                    </CheckBox>

                    <!-- Counter Status -->
                    <TextBlock Grid.Column="5" Name="txtLibraryStatus" Text="0 Families Found" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" FontSize="11.5" />
                </Grid>

                <!-- Balanced Cards Grid ScrollViewer (3 Cards Per Row) with Empty & Syncing States -->
                <Border Grid.Row="1" Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
                    <Grid>
                        <!-- Cards ScrollViewer -->
                        <ScrollViewer Name="scrollCards" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl Name="itemsFamilyCards">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Balanced Family Card (Width 236 for perfect 3-column wrap) -->
                                        <Border Width="236" Height="274" Margin="5" Style="{DynamicResource CardStyle}" Padding="10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="148" /> <!-- Thumbnail -->
                                                    <RowDefinition Height="Auto" /> <!-- Title -->
                                                    <RowDefinition Height="Auto" /> <!-- Badges -->
                                                    <RowDefinition Height="*" />    <!-- Spacer -->
                                                    <RowDefinition Height="Auto" /> <!-- Action Buttons -->
                                                </Grid.RowDefinitions>

                                                <!-- Thumbnail Container -->
                                                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" ClipToBounds="True">
                                                    <Grid>
                                                        <TextBlock Text="📦" FontSize="36" Opacity="0.2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{Binding ThumbnailImage}" Stretch="Uniform" Margin="4" />
                                                        <!-- Selection Checkbox Overlay -->
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  Click="OnCardCheckboxClick"
                                                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                  Margin="7" Cursor="Hand"
                                                                  ToolTip="Select family for batch loading / deletion">
                                                            <CheckBox.Template>
                                                                <ControlTemplate TargetType="CheckBox">
                                                                    <Border Name="chkBorder" Width="20" Height="20" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="5">
                                                                        <TextBlock Name="chkCheck" Text="✓" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,-1,0,0"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="chkBorder" Property="Background" Value="#2563EB" />
                                                                            <Setter TargetName="chkBorder" Property="BorderBrush" Value="#1D4ED8" />
                                                                            <Setter TargetName="chkCheck" Property="Visibility" Value="Visible" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="chkBorder" Property="BorderBrush" Value="#2563EB" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </CheckBox.Template>
                                                        </CheckBox>
                                                    </Grid>
                                                </Border>

                                                <!-- Family Title -->
                                                <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,0,5" />

                                                <!-- Badges: Category on Left, Version & Size on Right -->
                                                <Grid Grid.Row="2" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Category Tag -->
                                                    <Border Grid.Column="0" Background="#EEF2FF" CornerRadius="4" Padding="5,1.5" HorizontalAlignment="Left" Margin="0,0,4,0">
                                                        <TextBlock Text="{Binding Category}" FontSize="9.5" Foreground="#4338CA" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Category}" />
                                                    </Border>

                                                    <!-- Version & Size Badges -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Border Background="{Binding VersionBadgeBg}" CornerRadius="4" Padding="5,1.5" Margin="0,0,4,0" ToolTip="{Binding VersionToolTip}">
                                                            <TextBlock Text="{Binding VersionBadgeText}" FontSize="9.5" Foreground="{Binding VersionBadgeFg}" FontWeight="Bold" />
                                                        </Border>
                                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="5,1.5">
                                                            <TextBlock Text="{Binding FileSize}" FontSize="9.5" Foreground="#64748B" FontWeight="SemiBold" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Action Buttons: Load & Delete -->
                                                <Grid Grid.Row="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="32" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            CommandParameter="{Binding}"
                                                            Click="OnLoadFamilyClick"
                                                            Height="28" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0"
                                                            Background="{Binding ButtonBg}"
                                                            BorderBrush="{Binding ButtonBorder}"
                                                            Foreground="{Binding ButtonFg}"
                                                            Cursor="Hand"
                                                            ToolTip="{Binding LoadButtonToolTip}">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6" />
                                                            </Style>
                                                        </Button.Resources>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ButtonIcon}" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding ButtonText}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="1"
                                                            CommandParameter="{Binding}"
                                                            Click="OnDeleteFamilyClick"
                                                            Height="28" Width="30"
                                                            Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1"
                                                            Cursor="Hand" ToolTip="Delete from Cloud Library">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6" />
                                                            </Style>
                                                        </Button.Resources>
                                                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty State Panel (when 0 families found) -->
                        <StackPanel Name="panelEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="20">
                            <Border Width="80" Height="80" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="40" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Name="txtEmptyIcon" Text="☁️" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                            </Border>
                            <TextBlock Name="txtEmptyTitle" Text="Cloud Library is Empty" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Name="txtEmptySubtitle" Text="No Revit families uploaded yet. Upload your first .rfa family to get started!" FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="400" TextWrapping="Wrap" Margin="0,0,0,16"/>
                            <Button Name="btnEmptyUpload" Content="☁️  Upload Family Now" Style="{DynamicResource PrimaryButton}" Height="34" Padding="18,0" HorizontalAlignment="Center" Cursor="Hand" Click="OnEmptyUploadClick"/>
                        </StackPanel>

                        <!-- Syncing / Loading Overlay -->
                        <StackPanel Name="panelSyncingState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="20">
                            <Border Width="80" Height="80" Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="40" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="🔄" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Syncing with Cloud..." FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Fetching latest Revit families and metadata from cloud storage..." FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ── TAB 2: UPLOAD FAMILY ───────────────────────────────────────── -->
        <Grid Grid.Row="1" Name="panelUpload" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical" MaxWidth="720" HorizontalAlignment="Center" Margin="0,10,0,0">
                    
                    <!-- Card 1: Source File Selection -->
                    <Border Style="{DynamicResource CardStyle}" Padding="16" Margin="0,0,0,12">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="1. SELECT SOURCE FAMILY (.RFA)" Style="{DynamicResource SectionTitle}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Name="txtUploadFilePath" Height="32" Padding="8,4" VerticalContentAlignment="Center" FontSize="12" IsReadOnly="True" />
                                <Button Grid.Column="2" Name="btnBrowseRfa" Content="📁 Browse..." Style="{DynamicResource GhostButton}" Height="32" Padding="16,2" />
                            </Grid>

                            <!-- Live Auto-Detection Pill -->
                            <Border Name="borderDetectInfo" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,4,0,0" Visibility="Collapsed">
                                <TextBlock Name="txtDetectInfo" Text="⚡ Auto-detected: Category: Generic Models | Revit 2022" FontSize="11.5" Foreground="#166534" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Category & Metadata Configuration -->
                    <Border Style="{DynamicResource CardStyle}" Padding="16" Margin="0,0,0,12">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="2. CATEGORY &amp; METADATA" Style="{DynamicResource SectionTitle}" Margin="0,0,0,10" />

                            <!-- Category Selection -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Target Category:" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" Name="cmbUploadCategory" Height="30" FontSize="12" />
                            </Grid>

                            <!-- Description -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Description (Optional):" Style="{DynamicResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,0,0" />
                                <TextBox Grid.Column="1" Name="txtUploadDescription" Height="50" AcceptsReturn="True" TextWrapping="Wrap" Padding="8,4" FontSize="11.5" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Upload Action Button -->
                    <Button Name="btnExecuteUpload" Content="☁️ Upload Family to Cloud Library" Style="{DynamicResource PrimaryButton}" Height="42" FontSize="13.5" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── Tier 3: Footer Bar (Progress Bar & Live Status Feedback) ── -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- GEMINI.md Unified Progress Bar Standard -->
            <ProgressBar Name="progressBar" Grid.Row="0" Height="3" Margin="0,0,0,6" Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100"/>

