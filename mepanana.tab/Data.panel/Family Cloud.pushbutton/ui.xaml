<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Cloud"
        Width="1050" Height="680" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource WindowBgBrush}">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Row 0: Segmented Switcher & Status -->
            <RowDefinition Height="Auto" />  <!-- Row 1: Dedicated Progress Bar Row -->
            <RowDefinition Height="*" />     <!-- Row 2: Main Tab Content -->
        </Grid.RowDefinitions>

        <!-- ── Top Header Bar ─────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Segmented Tab Switcher (Only 2 Clean Tabs) -->
            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Name="rbTabBrowse" Content="🛒  Online Library"
                                 IsChecked="True" Style="{DynamicResource SegmentedRadioButton}"
                                 Padding="18,6" FontWeight="SemiBold" FontSize="12.5" />
                    <RadioButton Name="rbTabUpload" Content="☁️  Upload Family"
                                 IsChecked="False" Style="{DynamicResource SegmentedRadioButton}"
                                 Padding="18,6" FontWeight="SemiBold" FontSize="12.5" Margin="4,0,0,0" />
                </StackPanel>
            </Border>

            <!-- Right Status & Refresh -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6"
                        Height="32" Padding="12,0" Margin="0,0,8,0" VerticalAlignment="Center"
                        ToolTip="Mepanana Family Cloud is active and connected">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Name="dotCloudStatus" Width="7" Height="7" Fill="#16A34A" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Name="txtCloudStatus" Text="Cloud Online" FontSize="12" Foreground="#15803D" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button Name="btnRefresh" Content="🔄 Refresh" Style="{DynamicResource GhostButton}" Height="32" Padding="14,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ── Dedicated Animated Progress Bar ────────────────────────────── -->
        <ProgressBar Name="progressBar" Grid.Row="1" Height="6" Margin="0,0,0,12"
                     Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100"/>

        <!-- ── TAB 1: BROWSE LIBRARY ──────────────────────────────────────── -->
        <Grid Grid.Row="2" Name="panelBrowse" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" /> <!-- Categories Sidebar -->
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />   <!-- Cards Grid -->
            </Grid.ColumnDefinitions>

            <!-- Left Categories Sidebar -->
            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Categories" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8" />

                    <!-- Categories ListBox -->
                    <ListBox Grid.Row="1" Name="listCategories"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1" Background="{DynamicResource SecondaryButtonBrush}" CornerRadius="10" Padding="6,1" Margin="4,0,0,0">
                                        <TextBlock Text="{Binding Count}" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Dynamic Version Filter in Sidebar Footer -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="Family Version:" Style="{DynamicResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox Name="cmbVersionFilter" Height="28" FontSize="11.5" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Families Catalog Area -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Search Bar & Primary Filter -->
                    <RowDefinition Height="Auto" /> <!-- Batch Selection Action Bar -->
                    <RowDefinition Height="*" />    <!-- Cards ScrollViewer -->
                </Grid.RowDefinitions>

                <!-- Row 0: Search & Primary Compatibility Shield Filter -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <TextBox Name="txtSearch" Height="34" Padding="30,4,8,4" VerticalContentAlignment="Center" FontSize="12.5" />
                        <TextBlock Text="🔍" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" />
                    </Grid>

                    <!-- Smart Compatibility Shield Toggle Pill Button -->
                    <CheckBox Name="chkCompatibleOnly" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" Cursor="Hand"
                              ToolTip="Filter to show only families compatible with your current Revit version">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <Border Name="borderPill" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="34" Padding="12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Name="txtIcon" Text="🛡️" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Name="txtLabel" Text="Compatible Only" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="borderPill" Property="Background" Value="#DCFCE7" />
                                        <Setter TargetName="borderPill" Property="BorderBrush" Value="#86EFAC" />
                                        <Setter TargetName="txtLabel" Property="Foreground" Value="#15803D" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="borderPill" Property="BorderBrush" Value="#2563EB" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>
                    </CheckBox>

                    <!-- Counter Status -->
                    <TextBlock Grid.Column="2" Name="txtLibraryStatus" Text="0 Families Found" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" FontSize="11.5" />
                </Grid>

                <!-- Row 1: Batch Selection Action Toolbar -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Select All Pill Button -->
                    <Button Name="btnSelectAll" Grid.Column="0" Height="30" Margin="0,0,10,0" Cursor="Hand"
                            Content="☑️ Select All"
                            ToolTip="Select or deselect all visible families">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Name="btnBorder" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,0">
                                    <TextBlock Name="btnTxt" Text="{TemplateBinding Content}" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#F1F5F9" />
                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#94A3B8" />
                                        <Setter TargetName="btnTxt" Property="Foreground" Value="#0F172A" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Selection Hint / Info -->
                    <TextBlock Grid.Column="1" Name="txtSelectionCount" Text="💡 Hold Ctrl + Click to select multiple families" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" />

                    <!-- Batch Load Button (Crisp Disabled & Solid Primary Enabled) -->
                    <Button Name="btnBatchLoad" Grid.Column="2" Height="30" Margin="0,0,8,0" Cursor="Hand" IsEnabled="False"
                            Content="📥 Load Selected (0)"
                            ToolTip="Load all selected families into the active Revit project">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Name="btnBorder" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14,0">
                                    <TextBlock Name="btnTxt" Text="{TemplateBinding Content}" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#2563EB" />
                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#1D4ED8" />
                                        <Setter TargetName="btnTxt" Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsEnabled" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Batch Delete Button (Crisp Disabled & Danger Red Enabled) -->
                    <Button Name="btnBatchDelete" Grid.Column="3" Height="30" Cursor="Hand" IsEnabled="False"
                            Content="🗑️ Delete Selected (0)"
                            ToolTip="Delete all selected families from Cloud Library">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Name="btnBorder" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,0">
                                    <TextBlock Name="btnTxt" Text="{TemplateBinding Content}" FontSize="11.5" FontWeight="SemiBold" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#FEE2E2" />
                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#FCA5A5" />
                                        <Setter TargetName="btnTxt" Property="Foreground" Value="#DC2626" />
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsEnabled" Value="True" />
                                            <Condition Property="IsMouseOver" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="btnBorder" Property="Background" Value="#FECACA" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Row 2: Balanced Cards Grid ScrollViewer -->
                <Border Grid.Row="2" Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                    <Grid>
                        <!-- Empty / Loading State Placeholder -->
                        <StackPanel Name="panelPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="Collapsed">
                            <TextBlock Name="txtPlaceholderIcon" Text="☁️" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.5"/>
                            <TextBlock Name="txtPlaceholderText" Text="Loading Cloud Families..." FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Name="txtPlaceholderSub" Text="Please wait while fetching library data..." FontSize="11.5" Foreground="{DynamicResource DisabledTextBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl Name="itemsFamilyCards">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Balanced Family Card (Width 228 for spacious badges) -->
                                    <Border Width="228" Height="274" Margin="6" Padding="10" CornerRadius="8"
                                            Background="{Binding CardBackground}"
                                            BorderBrush="{Binding CardBorderBrush}"
                                            BorderThickness="{Binding CardBorderThickness}"
                                            Cursor="Hand"
                                            PreviewMouseDown="OnCardPreviewMouseDown">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="148" /> <!-- Thumbnail -->
                                                <RowDefinition Height="Auto" /> <!-- Title -->
                                                <RowDefinition Height="Auto" /> <!-- Badges -->
                                                <RowDefinition Height="*" />    <!-- Spacer -->
                                                <RowDefinition Height="Auto" /> <!-- Action Buttons -->
                                            </Grid.RowDefinitions>

                                            <!-- Thumbnail Container -->
                                            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="📦" FontSize="36" Opacity="0.2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{Binding ThumbnailImage}" Stretch="Uniform" Margin="4" />

                                                    <!-- Top-Left Selection Checkbox Pill -->
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                                              Cursor="Hand" Click="OnCardCheckClick" ToolTip="Select family (Ctrl+Click anywhere on card)">
                                                        <CheckBox.Template>
                                                            <ControlTemplate TargetType="CheckBox">
                                                                <Border Name="chkBoxBorder" Width="20" Height="20" CornerRadius="5" Background="#E2E8F0" BorderBrush="#94A3B8" BorderThickness="1.5">
                                                                    <TextBlock Name="chkBoxTick" Text="✓" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" Visibility="Collapsed" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="chkBoxBorder" Property="Background" Value="#2563EB" />
                                                                        <Setter TargetName="chkBoxBorder" Property="BorderBrush" Value="#1D4ED8" />
                                                                        <Setter TargetName="chkBoxTick" Property="Visibility" Value="Visible" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="chkBoxBorder" Property="BorderBrush" Value="#2563EB" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </CheckBox.Template>
                                                    </CheckBox>
                                                </Grid>
                                            </Border>

                                            <!-- Family Title -->
                                            <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,0,5" />

                                            <!-- Badges: Category on Left, Version & Size on Right -->
                                            <Grid Grid.Row="2" Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Category Tag -->
                                                <Border Grid.Column="0" Background="#EEF2FF" CornerRadius="4" Padding="5,1.5" HorizontalAlignment="Left" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="9.5" Foreground="#4338CA" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Category}" />
                                                </Border>

                                                <!-- Version & Size Badges -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Border Background="{Binding VersionBadgeBg}" CornerRadius="4" Padding="5,1.5" Margin="0,0,4,0" ToolTip="{Binding VersionToolTip}">
                                                        <TextBlock Text="{Binding VersionBadgeText}" FontSize="9.5" Foreground="{Binding VersionBadgeFg}" FontWeight="Bold" />
                                                    </Border>
                                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="5,1.5">
                                                        <TextBlock Text="{Binding FileSize}" FontSize="9.5" Foreground="#64748B" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Action Buttons: Load & Delete -->
                                            <Grid Grid.Row="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="32" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        CommandParameter="{Binding}"
                                                        Click="OnLoadFamilyClick"
                                                        Height="28" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0"
                                                        Background="{Binding ButtonBg}"
                                                        BorderBrush="{Binding ButtonBorder}"
                                                        Foreground="{Binding ButtonFg}"
                                                        Cursor="Hand"
                                                        ToolTip="{Binding LoadButtonToolTip}">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6" />
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ButtonIcon}" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ButtonText}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="1"
                                                        CommandParameter="{Binding}"
                                                        Click="OnDeleteFamilyClick"
                                                        Height="28" Width="30"
                                                        Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1"
                                                        Cursor="Hand" ToolTip="Delete from Cloud Library">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6" />
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock Text="✕" FontSize="12" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ── TAB 2: UPLOAD FAMILY ───────────────────────────────────────── -->
        <Grid Grid.Row="2" Name="panelUpload" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical" MaxWidth="720" HorizontalAlignment="Center" Margin="0,10,0,0">
                    
                    <!-- Card 1: Source File Selection -->
                    <Border Style="{DynamicResource CardStyle}" Padding="16" Margin="0,0,0,12">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="1. SELECT SOURCE FAMILY (.RFA)" Style="{DynamicResource SectionTitle}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Name="txtUploadFilePath" Height="32" Padding="8,4" VerticalContentAlignment="Center" FontSize="12" IsReadOnly="True" />
                                <Button Grid.Column="2" Name="btnBrowseRfa" Content="📁 Browse..." Style="{DynamicResource GhostButton}" Height="32" Padding="16,2" />
                            </Grid>

                            <!-- Live Auto-Detection Pill -->
                            <Border Name="borderDetectInfo" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,4,0,0" Visibility="Collapsed">
                                <TextBlock Name="txtDetectInfo" Text="⚡ Auto-detected: Category: Generic Models | Revit 2022" FontSize="11.5" Foreground="#166534" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Category & Metadata Configuration -->
                    <Border Style="{DynamicResource CardStyle}" Padding="16" Margin="0,0,0,12">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="2. CATEGORY &amp; METADATA" Style="{DynamicResource SectionTitle}" Margin="0,0,0,10" />

                            <!-- Category Selection -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Target Category:" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" Name="cmbUploadCategory" Height="30" FontSize="12" />
                            </Grid>

                            <!-- Description -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Description (Optional):" Style="{DynamicResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,0,0" />
                                <TextBox Grid.Column="1" Name="txtUploadDescription" Height="50" AcceptsReturn="True" TextWrapping="Wrap" Padding="8,4" FontSize="11.5" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Upload Action Button -->
                    <Button Name="btnExecuteUpload" Content="☁️ Upload Family to Cloud Library" Style="{DynamicResource PrimaryButton}" Height="42" FontSize="13.5" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</Window>