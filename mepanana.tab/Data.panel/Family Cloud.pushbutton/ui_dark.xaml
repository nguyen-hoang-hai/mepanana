<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Cloud"
        Width="1060" Height="680" MinWidth="960" MinHeight="580"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <!-- Primary Button (Emerald Accent) -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="#10B981" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#064E3B"/>
                                <Setter Property="Foreground" Value="#6EE7B7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="#1E293B"
                                BorderBrush="#334155" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#475569"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Action Button (Theme Toggle) -->
        <Style x:Key="TitleActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="Transparent"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Close Button -->
        <Style x:Key="TitleCloseBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="Transparent"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#7F1D1D"/>
                                <Setter Property="Foreground" Value="#FCA5A5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#991B1B"/>
                                <Setter Property="Foreground" Value="#F87171"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Tab RadioButton -->
        <Style x:Key="SegmentedTabRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Name="bd" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Master Outer Window Shell with Drop Shadow -->
    <Grid Margin="12">
        <Border CornerRadius="12" Background="#0F172A"
                BorderBrush="#334155" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                  Color="#000000" Opacity="0.35"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <!-- Centered Watermark Background Logo -->
                <Image Name="watermarkImage"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Width="360" Height="360"
                       Opacity="0.10" Stretch="Uniform"
                       IsHitTestVisible="False">
                    <Image.Effect>
                        <BlurEffect Radius="1.5"/>
                    </Image.Effect>
                </Image>

                <!-- Window Content Grid -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>  <!-- Row 0: TitleBar -->
                        <RowDefinition Height="2"/>   <!-- Row 1: Signature Gradient Line -->
                        <RowDefinition Height="*"/>   <!-- Row 2: Main Workspace -->
                    </Grid.RowDefinitions>

                    <!-- ── Row 0: Custom Draggable Title Bar ── -->
                    <Border Grid.Row="0" CornerRadius="11,11,0,0" Background="#1E293B"
                            BorderBrush="#334155" BorderThickness="0,0,0,1">
                        <Grid Name="titleBar" Margin="14,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Brand Badge -->
                            <Border Grid.Column="0" CornerRadius="5" Padding="6,2" Margin="0,0,9,0"
                                    Background="#064E3B" BorderBrush="#059669" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="MN" FontSize="10.5" Foreground="#34D399"/>
                            </Border>

                            <!-- Window Title -->
                            <TextBlock Grid.Column="1" Text="mepanana  ·  Family Cloud Library"
                                       FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>

                            <!-- Theme Toggle Button (Dark -> Light) -->
                            <Button Grid.Column="2" Name="btnToggleTheme" Content="☀️"
                                    ToolTip="Switch to Light Theme"
                                    Style="{StaticResource TitleActionBtn}" VerticalAlignment="Center"
                                    Margin="0,0,6,0"/>

                            <!-- Close Button -->
                            <Button Grid.Column="3" Name="btnClose" Content="✕"
                                    Style="{StaticResource TitleCloseBtn}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- ── Row 1: Signature 4-Color Gradient Line ── -->
                    <Rectangle Grid.Row="1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#10B981" Offset="0"/>
                                <GradientStop Color="#3B82F6" Offset="0.5"/>
                                <GradientStop Color="#F59E0B" Offset="0.8"/>
                                <GradientStop Color="#EF4444" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- ── Row 2: Main Workspace ── -->
                    <Grid Grid.Row="2" Margin="14,12,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />  <!-- Top Segmented Switcher & Status -->
                            <RowDefinition Height="*" />     <!-- Main Tab Content -->
                            <RowDefinition Height="Auto" />  <!-- Tier 3 FooterBar -->
                        </Grid.RowDefinitions>

                        <!-- ── Top Header Bar: Segmented Tab Switcher & Cloud Status ── -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Segmented Tab Switcher -->
                            <Border Grid.Column="0" Background="#E01E293B" BorderBrush="#334155" BorderThickness="1"
                                    CornerRadius="8" Padding="3">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.2"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Name="rbTabBrowse" Content="🛒  Online Library"
                                                 IsChecked="True" Style="{StaticResource SegmentedTabRadio}" />
                                    <RadioButton Name="rbTabUpload" Content="☁️  Upload Family"
                                                 IsChecked="False" Style="{StaticResource SegmentedTabRadio}" Margin="3,0,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Right Status & Refresh -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Name="borderCloudStatus" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="6"
                                        Height="32" Padding="12,0" Margin="0,0,8,0" VerticalAlignment="Center"
                                        ToolTip="Mepanana Family Cloud connection status">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Name="dotCloudStatus" Width="7" Height="7" Fill="#34D399" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Name="txtCloudStatus" Text="Cloud Online" FontSize="12" Foreground="#6EE7B7" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Button Name="btnRefresh" Content="🔄 Refresh" Style="{StaticResource GhostBtn}" Height="32" Padding="14,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- ── TAB 1: BROWSE LIBRARY ── -->
                        <Grid Grid.Row="1" Name="panelBrowse" Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" /> <!-- Categories Sidebar -->
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />   <!-- Cards Area -->
                            </Grid.ColumnDefinitions>

                            <!-- Left Categories Sidebar -->
                            <Border Grid.Column="0" Background="#E01E293B" BorderBrush="#334155" BorderThickness="1"
                                    CornerRadius="8" Padding="12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.2"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Section Header -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Rectangle Width="3" Height="14" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" RadiusX="1.5" RadiusY="1.5"/>
                                        <TextBlock Text="Categories" FontSize="12" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Categories ListBox with Virtualization -->
                                    <ListBox Grid.Row="1" Name="listCategories"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             ScrollViewer.IsDeferredScrollingEnabled="False"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             BorderThickness="0" Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="11.5" Foreground="#CBD5E1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="1" Background="#0F172A" CornerRadius="10" Padding="6,1" Margin="4,0,0,0">
                                                         <TextBlock Text="{Binding Count}" FontSize="10" Foreground="#94A3B8" />
                                                     </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Dynamic Version Filter in Sidebar Footer -->
                                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                        <TextBlock Text="Family Version:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4" />
                                        <ComboBox Name="cmbVersionFilter" Height="30" FontSize="11.5" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Right Families Catalog Area -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Row 0: Search Bar & Filters -->
                                    <RowDefinition Height="Auto" /> <!-- Row 1: Batch Actions Toolbar -->
                                    <RowDefinition Height="*" />    <!-- Row 2: Cards ScrollViewer -->
                                </Grid.RowDefinitions>

                                <!-- Row 0: Search Input + Compatibility Filter + Found Counter -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />        <!-- Search Box -->
                                        <ColumnDefinition Width="Auto" />     <!-- Compatible Only -->
                                        <ColumnDefinition Width="Auto" />     <!-- Families Found Counter -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Search Input -->
                                    <Grid Grid.Column="0" Margin="0,0,10,0">
                                        <TextBox Name="txtSearch" Height="34" Padding="30,4,8,4" VerticalContentAlignment="Center" FontSize="12" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" />
                                        <TextBlock Text="🔍" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" />
                                    </Grid>

                                    <!-- Smart Compatibility Shield Toggle Pill Button -->
                                    <CheckBox Name="chkCompatibleOnly" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand"
                                              ToolTip="Filter to show only families compatible with your current Revit version">
                                        <CheckBox.Template>
                                            <ControlTemplate TargetType="CheckBox">
                                                <Border Name="borderPill" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Height="34" Padding="10,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Name="txtIcon" Text="🛡️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                        <TextBlock Name="txtLabel" Text="Compatible Only" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="borderPill" Property="Background" Value="#064E3B" />
                                                        <Setter TargetName="borderPill" Property="BorderBrush" Value="#059669" />
                                                        <Setter TargetName="txtLabel" Property="Foreground" Value="#6EE7B7" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </CheckBox.Template>
                                    </CheckBox>

                                    <!-- Counter Status -->
                                    <Border Grid.Column="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Height="34" Padding="10,0" VerticalAlignment="Center">
                                        <TextBlock Name="txtLibraryStatus" Text="0 Families Found" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11.5" />
                                    </Border>
                                </Grid>

                                <!-- Row 1: Batch Actions Toolbar (Select All, Load, Delete) -->
                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Select All Pill Button -->
                                        <CheckBox Name="chkSelectAll" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand"
                                                  ToolTip="Select or Deselect all currently filtered families for batch operations">
                                            <CheckBox.Template>
                                                <ControlTemplate TargetType="CheckBox">
                                                    <Border Name="borderPill" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Height="32" Padding="10,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Name="txtIcon" Text="☑️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                            <TextBlock Name="txtLabel" Text="Select All" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="borderPill" Property="Background" Value="#1E3A8A" />
                                                            <Setter TargetName="borderPill" Property="BorderBrush" Value="#3B82F6" />
                                                            <Setter TargetName="txtLabel" Property="Foreground" Value="#93C5FD" />
                                                            <Setter TargetName="txtLabel" Property="Text" Value="Deselect All" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="borderPill" Property="BorderBrush" Value="#60A5FA" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </CheckBox.Template>
                                        </CheckBox>

                                        <!-- Batch Load Button (Sleek Pill Button) -->
                                        <Button Name="btnBatchLoad"
                                                Height="32" Padding="12,0" Margin="0,0,8,0"
                                                IsEnabled="False" Cursor="Hand"
                                                ToolTip="Load all selected families into the active Revit project">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#1E3A8A" />
                                                    <Setter Property="BorderBrush" Value="#3B82F6" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="Foreground" Value="#BFDBFE" />
                                                    <Setter Property="FontSize" Value="11.5" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="border" Property="Background" Value="#2563EB" />
                                                                        <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter TargetName="border" Property="Opacity" Value="0.4" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📥" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Name="txtBatchLoadCount" Text="Load (0)" FontSize="11.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Batch Delete Button (Sleek Danger Pill Button) -->
                                        <Button Name="btnBatchDelete"
                                                Height="32" Padding="12,0"
                                                IsEnabled="False" Cursor="Hand"
                                                ToolTip="Delete all selected families from Cloud Library">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#450A0A" />
                                                    <Setter Property="BorderBrush" Value="#7F1D1D" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="Foreground" Value="#FCA5A5" />
                                                    <Setter Property="FontSize" Value="11.5" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="border" Property="Background" Value="#7F1D1D" />
                                                                        <Setter TargetName="border" Property="BorderBrush" Value="#EF4444" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter TargetName="border" Property="Opacity" Value="0.4" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🗑️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Name="txtBatchDeleteCount" Text="Delete" FontSize="11.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Balanced Cards Grid ScrollViewer (3 Cards Per Row) -->
                                <Border Grid.Row="2" Background="#E01E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="6">
                                    <Grid>
                                        <!-- Cards ScrollViewer -->
                                        <ScrollViewer Name="scrollCards" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl Name="itemsFamilyCards">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- Balanced Family Card (Width 236 for perfect 3-column wrap) -->
                                                        <Border Width="236" Height="274" Margin="5" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.15"/>
                                                            </Border.Effect>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="148" /> <!-- Thumbnail -->
                                                                    <RowDefinition Height="Auto" /> <!-- Title -->
                                                                    <RowDefinition Height="Auto" /> <!-- Badges -->
                                                                    <RowDefinition Height="*" />    <!-- Spacer -->
                                                                    <RowDefinition Height="Auto" /> <!-- Action Buttons -->
                                                                </Grid.RowDefinitions>

                                                                <!-- Thumbnail Container -->
                                                                <Border Grid.Row="0" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" ClipToBounds="True">
                                                                    <Grid>
                                                                        <TextBlock Text="📦" FontSize="36" Opacity="0.15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        <Image Source="{Binding ThumbnailImage}" Stretch="Uniform" Margin="4" />
                                                                        <!-- Selection Checkbox Overlay -->
                                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                                  Margin="7" Cursor="Hand"
                                                                                  ToolTip="Select family for batch loading / deletion">
                                                                            <CheckBox.Template>
                                                                                <ControlTemplate TargetType="CheckBox">
                                                                                    <Border Name="chkBorder" Width="20" Height="20" Background="#1E293B" BorderBrush="#475569" BorderThickness="1.5" CornerRadius="5">
                                                                                        <TextBlock Name="chkCheck" Text="✓" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,-1,0,0"/>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsChecked" Value="True">
                                                                                            <Setter TargetName="chkBorder" Property="Background" Value="#2563EB" />
                                                                                            <Setter TargetName="chkBorder" Property="BorderBrush" Value="#3B82F6" />
                                                                                            <Setter TargetName="chkCheck" Property="Visibility" Value="Visible" />
                                                                                        </Trigger>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter TargetName="chkBorder" Property="BorderBrush" Value="#3B82F6" />
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </CheckBox.Template>
                                                                        </CheckBox>
                                                                    </Grid>
                                                                </Border>

                                                                <!-- Family Title -->
                                                                <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,0,5" Foreground="#F1F5F9" />

                                                                <!-- Badges: Category on Left, Version & Size on Right -->
                                                                <Grid Grid.Row="2" Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Category Tag -->
                                                                    <Border Grid.Column="0" Background="#312E81" CornerRadius="4" Padding="5,1.5" HorizontalAlignment="Left" Margin="0,0,4,0">
                                                                        <TextBlock Text="{Binding Category}" FontSize="9.5" Foreground="#C7D2FE" TextTrimming="CharacterEllipsis" ToolTip="{Binding Category}" />
                                                                    </Border>

                                                                    <!-- Version & Size Badges -->
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                        <Border Background="{Binding VersionBadgeBg}" CornerRadius="4" Padding="5,1.5" Margin="0,0,4,0" ToolTip="{Binding VersionToolTip}">
                                                                            <TextBlock Text="{Binding VersionBadgeText}" FontSize="9.5" Foreground="{Binding VersionBadgeFg}" />
                                                                        </Border>
                                                                        <Border Background="#0F172A" CornerRadius="4" Padding="5,1.5">
                                                                            <TextBlock Text="{Binding FileSize}" FontSize="9.5" Foreground="#94A3B8" />
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!-- Action Buttons: Load & Delete -->
                                                                <Grid Grid.Row="4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="32" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button Name="btnLoadCard" Grid.Column="0"
                                                                            CommandParameter="{Binding}"
                                                                            Height="30" FontSize="11" Margin="0,0,4,0"
                                                                            Background="{Binding ButtonBg}"
                                                                            BorderBrush="{Binding ButtonBorder}"
                                                                            Foreground="{Binding ButtonFg}"
                                                                            Cursor="Hand"
                                                                            ToolTip="{Binding LoadButtonToolTip}">
                                                                        <Button.Resources>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="CornerRadius" Value="6" />
                                                                            </Style>
                                                                        </Button.Resources>
                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                            <TextBlock Text="{Binding ButtonIcon}" Margin="0,0,4,0" FontSize="11" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding ButtonText}" FontSize="11" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button Name="btnDeleteCard" Grid.Column="1"
                                                                            CommandParameter="{Binding}"
                                                                            Height="30" Width="30"
                                                                            Background="#450A0A" BorderBrush="#7F1D1D" BorderThickness="1"
                                                                            Cursor="Hand" ToolTip="Delete from Cloud Library">
                                                                        <Button.Resources>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="CornerRadius" Value="6" />
                                                                            </Style>
                                                                        </Button.Resources>
                                                                        <TextBlock Text="✕" FontSize="12" Foreground="#FCA5A5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" IsHitTestVisible="False"/>
                                                                    </Button>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <!-- Empty State Panel -->
                                        <StackPanel Name="panelEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="20">
                                            <Border Width="72" Height="72" Background="#1E3A8A" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="36" HorizontalAlignment="Center" Margin="0,0,0,14">
                                                <Path Data="M 19.35,10.04 C 18.67,6.59 15.64,4 12,4 C 9.11,4 6.6,5.64 5.35,8.04 C 2.34,8.36 0,10.91 0,14 C 0,17.31 2.69,20 6,20 L 19,20 C 21.76,20 24,17.76 24,15 C 24,12.36 21.95,10.22 19.35,10.04 Z"
                                                      Fill="#60A5FA" Width="34" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Name="txtEmptyTitle" Text="Cloud Library is Empty" FontSize="15" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Name="txtEmptySubtitle" Text="No Revit families uploaded yet. Upload your first .rfa family to get started!" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                            <Button Name="btnEmptyUpload" Content="☁️  Upload Family Now" Style="{StaticResource PrimaryBtn}" Height="34" Padding="18,0" HorizontalAlignment="Center" Cursor="Hand"/>
                                        </StackPanel>

                                        <!-- Syncing / Loading Overlay -->
                                        <StackPanel Name="panelSyncingState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="20">
                                            <Border Width="72" Height="72" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="36" HorizontalAlignment="Center" Margin="0,0,0,14">
                                                <Path Data="M 12,4 V 1 L 8,5 L 12,9 V 6 C 15.31,6 18,8.69 18,12 C 18,13.01 17.75,13.97 17.3,14.8 L 18.76,16.26 C 19.54,15.01 20,13.56 20,12 C 20,7.58 16.42,4 12,4 Z M 12,18 C 8.69,18 6,15.31 6,12 C 6,10.99 6.25,10.03 6.7,9.2 L 5.24,7.74 C 4.46,8.99 4,10.44 4,12 C 4,16.42 7.58,20 12,20 V 23 L 16,19 L 12,15 V 18 Z"
                                                      Fill="#34D399" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Syncing with Cloud..." FontSize="15" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="Fetching latest Revit families and metadata from cloud storage..." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="360" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ── TAB 2: UPLOAD FAMILY ── -->
                        <Grid Grid.Row="1" Name="panelUpload" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Orientation="Vertical" MaxWidth="720" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    
                                    <!-- Card 1: Source File Selection -->
                                    <Border Background="#E01E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.2"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Vertical">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Rectangle Width="3" Height="14" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" RadiusX="1.5" RadiusY="1.5"/>
                                                <TextBlock Text="1. SELECT SOURCE FAMILY (.RFA)" FontSize="12" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBox Name="txtUploadFilePath" Height="32" Padding="8,4" VerticalContentAlignment="Center" FontSize="12" IsReadOnly="True" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" />
                                                <Button Grid.Column="2" Name="btnBrowseRfa" Content="📁 Browse..." Style="{StaticResource GhostBtn}" Height="32" Padding="16,2" />
                                            </Grid>

                                            <!-- Live Auto-Detection Pill -->
                                            <Border Name="borderDetectInfo" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,4,0,0" Visibility="Collapsed">
                                                <TextBlock Name="txtDetectInfo" Text="⚡ Auto-detected: Category: Generic Models | Revit 2022" FontSize="11.5" Foreground="#6EE7B7" />
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 2: Category & Metadata Configuration -->
                                    <Border Background="#E01E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.2"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Vertical">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Rectangle Width="3" Height="14" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" RadiusX="1.5" RadiusY="1.5"/>
                                                <TextBlock Text="2. CATEGORY &amp; METADATA" FontSize="12" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Category Selection -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Target Category:" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1" Name="cmbUploadCategory" Height="30" FontSize="12" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" />
                                            </Grid>

                                            <!-- Description -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Description (Optional):" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Top" Margin="0,6,0,0" />
                                                <TextBox Grid.Column="1" Name="txtUploadDescription" Height="50" AcceptsReturn="True" TextWrapping="Wrap" Padding="8,4" FontSize="11.5" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 3: Upload Action Button -->
                                    <Button Name="btnExecuteUpload" Content="☁️ Upload Family to Cloud Library" Style="{StaticResource PrimaryBtn}" Height="40" FontSize="13" Margin="0,4,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ── Tier 3 FooterBar with ProgressBar ── -->
                        <Border Grid.Row="2" Background="#E01E293B" BorderBrush="#334155" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.2"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- ProgressBar -->
                                    <RowDefinition Height="Auto" /> <!-- Action Controls -->
                                </Grid.RowDefinitions>

                                <!-- GEMINI.md Unified Progress Bar Standard -->
                                <ProgressBar Name="progressBar" Grid.Row="0" Height="4" Margin="0,0,0,8" Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100"/>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Name="txtStatus" Grid.Column="0" Text="Ready" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button Name="btnFooterClose" Grid.Column="1" Content="Close" Style="{StaticResource GhostBtn}" Height="32" Padding="20,0" IsCancel="True" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
