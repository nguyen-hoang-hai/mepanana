<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Local Library"
        Width="1060" Height="680" MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource WindowBgBrush}">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Top Header Bar (Folder Picker & Stats) -->
            <RowDefinition Height="*" />     <!-- Main Content Area (Sidebar & Cards) -->
            <RowDefinition Height="Auto" />  <!-- FooterBar with ProgressBar & Batch Actions -->
        </Grid.RowDefinitions>

        <!-- ── Top Header Bar: Folder Picker & Actions ───────────────────── -->
        <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Padding="10,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Label -->
                    <ColumnDefinition Width="*" />    <!-- Path TextBox -->
                    <ColumnDefinition Width="Auto" /> <!-- Browse Button -->
                    <ColumnDefinition Width="Auto" /> <!-- Rescan Button -->
                    <ColumnDefinition Width="Auto" /> <!-- Explorer Button -->
                    <ColumnDefinition Width="Auto" /> <!-- Stats Badge -->
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="📁 Library Folder:" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,10,0" Foreground="{DynamicResource TextBrush}" />

                <TextBox Grid.Column="1" Name="txtFolderPath" Height="32" Padding="8,4" VerticalContentAlignment="Center" FontSize="12" Margin="0,0,8,0"
                         ToolTip="Path to your local or network Revit family library directory" />

                <Button Grid.Column="2" Name="btnBrowseFolder" Content="📁 Browse..." Style="{DynamicResource PrimaryButton}" Height="32" Padding="12,0" Margin="0,0,6,0" />
                <Button Grid.Column="3" Name="btnRescan" Content="🔄 Rescan" Style="{DynamicResource GhostButton}" Height="32" Padding="10,0" Margin="0,0,6,0" ToolTip="Rescan directory for new or updated .rfa families" />
                <Button Grid.Column="4" Name="btnOpenExplorer" Content="↗️ Explorer" Style="{DynamicResource GhostButton}" Height="32" Padding="10,0" Margin="0,0,10,0" ToolTip="Open folder in Windows Explorer" />

                <!-- Stats Badge -->
                <Border Grid.Column="5" Name="borderLibraryStats" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Height="32" Padding="12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#16A34A" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Name="txtLibraryStats" Text="0 Families" FontSize="12" Foreground="#15803D" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ── Main Content Area (Sidebar & Cards) ────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" /> <!-- Categories Sidebar -->
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />   <!-- Cards Area -->
            </Grid.ColumnDefinitions>

            <!-- Left Categories Sidebar -->
            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Categories" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8" />

                    <!-- Categories ListBox with Virtualization -->
                    <ListBox Grid.Row="1" Name="listCategories"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.IsDeferredScrollingEnabled="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1" Background="{DynamicResource SecondaryButtonBrush}" CornerRadius="10" Padding="5,1" Margin="4,0,0,0">
                                        <TextBlock Text="{Binding Count}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Dynamic Version Filter in Sidebar Footer -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="Family Version:" Style="{DynamicResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox Name="cmbVersionFilter" Height="28" FontSize="11.5" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Families Catalog Area -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Search Bar & Filters -->
                    <RowDefinition Height="*" />    <!-- Cards ScrollViewer -->
                </Grid.RowDefinitions>

                <!-- Search Input + Compatibility Filter + Found Counter -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />        <!-- Search Box -->
                        <ColumnDefinition Width="Auto" />     <!-- Compatible Only -->
                        <ColumnDefinition Width="Auto" />     <!-- Families Found Counter -->
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <TextBox Name="txtSearch" Height="34" Padding="30,4,8,4" VerticalContentAlignment="Center" FontSize="12" />
                        <TextBlock Text="🔍" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" />
                    </Grid>

                    <!-- Smart Compatibility Shield Toggle Pill Button -->
                    <CheckBox Name="chkCompatibleOnly" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand"
                              ToolTip="Filter to show only families compatible with your current Revit version">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <Border Name="borderPill" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="34" Padding="10,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Name="txtIcon" Text="🛡️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Name="txtLabel" Text="Compatible Only" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="borderPill" Property="Background" Value="#EFF6FF" />
                                        <Setter TargetName="borderPill" Property="BorderBrush" Value="#3B82F6" />
                                        <Setter TargetName="txtLabel" Property="Foreground" Value="#1D4ED8" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>
                    </CheckBox>

                    <!-- Found Counter Badge -->
                    <Border Grid.Column="2" Background="{DynamicResource SecondaryButtonBrush}" CornerRadius="6" Padding="10,0" Height="34" VerticalAlignment="Center">
                        <TextBlock Name="txtFoundCount" Text="0 families found" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Cards ScrollViewer with Adaptive WrapPanel -->
                <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="8">
                    <ScrollViewer Name="scrollCards" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl Name="itemsCards">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="246" Margin="6" Background="{DynamicResource CardBgBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="8" SnapsToDevicePixels="True" Cursor="Hand"
                                            Tag="{Binding RfaPath}" ToolTip="{Binding TooltipText}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="120" /> <!-- Thumbnail Preview -->
                                                <RowDefinition Height="Auto" /> <!-- Family Title -->
                                                <RowDefinition Height="Auto" /> <!-- Badges -->
                                                <RowDefinition Height="Auto" /> <!-- Footer Actions (Select Checkbox & 1-Click Load) -->
                                            </Grid.RowDefinitions>

                                            <!-- Thumbnail Container -->
                                            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="6" ClipToBounds="True" BorderBrush="#E2E8F0" BorderThickness="1">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <!-- Fallback watermarking if no thumbnail -->
                                                    <TextBlock Text="📦 RFA" FontSize="14" FontWeight="Bold" Foreground="#CBD5E1"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding FallbackVisibility}" />
                                                </Grid>
                                            </Border>

                                            <!-- Family Title -->
                                            <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="Bold" FontSize="12"
                                                       Margin="0,8,0,4" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextBrush}" />

                                            <!-- Badges: Category, Version, File Size -->
                                            <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                                                <Border Background="#F1F5F9" CornerRadius="4" Padding="5,1" Margin="0,0,4,4">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="#475569" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                                                </Border>
                                                <Border Background="{Binding VersionBadgeBg}" CornerRadius="4" Padding="5,1" Margin="0,0,4,4">
                                                    <TextBlock Text="{Binding VersionLabel}" FontSize="10" FontWeight="Bold" Foreground="{Binding VersionBadgeFg}" />
                                                </Border>
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="0,0,4,4">
                                                    <TextBlock Text="{Binding FileSizeStr}" FontSize="9.5" Foreground="#64748B" />
                                                </Border>
                                            </WrapPanel>

                                            <!-- Card Footer Actions: Checkbox & 1-Click Load Button -->
                                            <Grid Grid.Row="3" Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="Select"
                                                          FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />

                                                <Button Grid.Column="1" Tag="{Binding RfaPath}" Name="btnCardLoad"
                                                        Content="📥 Load" Style="{DynamicResource PrimaryButton}"
                                                        Height="26" Padding="10,0" FontSize="11" FontWeight="Bold" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ── Tier 3 FooterBar with ProgressBar & Batch Actions ─────────── -->
        <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="12,10" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- ProgressBar -->
                    <RowDefinition Height="Auto" /> <!-- Action Buttons -->
                </Grid.RowDefinitions>

                <!-- Unified Progress Bar Standard -->
                <ProgressBar Grid.Row="0" Name="progressBar" Height="4" Margin="0,0,0,8"
                             Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100" />

                <!-- Action Controls Row -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /> <!-- Select All / Deselect All -->
                        <ColumnDefinition Width="*" />    <!-- Status Feedback -->
                        <ColumnDefinition Width="Auto" /> <!-- Close & Batch Load Buttons -->
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="btnSelectAll" Content="Select All" Style="{DynamicResource GhostButton}" Height="32" Padding="12,0" Margin="0,0,6,0" />
                        <Button Name="btnDeselectAll" Content="Deselect All" Style="{DynamicResource GhostButton}" Height="32" Padding="12,0" Margin="0,0,10,0" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Name="txtStatus" Text="Ready." VerticalAlignment="Center"
                               FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="btnClose" Content="Close" Style="{DynamicResource GhostButton}" Height="32" Padding="16,0" Margin="0,0,8,0" />
                        <Button Name="btnBatchLoad" Content="📥 Load Selected (0)" Style="{DynamicResource PrimaryButton}" Height="32" Padding="18,0" FontWeight="Bold" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
