<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Local Library"
        Width="1060" Height="680" MinWidth="960" MinHeight="580"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <!-- Primary Button (Emerald Accent) -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="#10B981" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#A7F3D0"/>
                                <Setter Property="Foreground" Value="#ECFDF5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="#F1F5F9"
                                BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Action Button (Theme Toggle) -->
        <Style x:Key="TitleActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="Transparent"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Close Button -->
        <Style x:Key="TitleCloseBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" CornerRadius="6" Background="Transparent"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FCA5A5"/>
                                <Setter Property="Foreground" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Name="box" Width="16" Height="16" CornerRadius="4"
                                    BorderThickness="1.2" BorderBrush="#CBD5E1"
                                    Background="White" VerticalAlignment="Center">
                                <TextBlock Name="chk" Text="✓" FontSize="11" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,-1,0,0" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#10B981"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#059669"/>
                                <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Master Outer Window Shell with Drop Shadow -->
    <Grid Margin="12">
        <Border CornerRadius="12" Background="#F8FAFC"
                BorderBrush="#CBD5E1" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                  Color="#0F172A" Opacity="0.14"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <!-- Centered Watermark Background Logo -->
                <Image Name="watermarkImage"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Width="360" Height="360"
                       Opacity="0.14" Stretch="Uniform"
                       IsHitTestVisible="False">
                    <Image.Effect>
                        <BlurEffect Radius="1.5"/>
                    </Image.Effect>
                </Image>

                <!-- Window Content Grid -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>  <!-- Row 0: Custom TitleBar -->
                        <RowDefinition Height="2"/>   <!-- Row 1: Signature Gradient Line -->
                        <RowDefinition Height="*"/>   <!-- Row 2: Main Content -->
                    </Grid.RowDefinitions>

                    <!-- ── Row 0: Custom Draggable Title Bar ── -->
                    <Border Grid.Row="0" CornerRadius="11,11,0,0" Background="#F1F5F9"
                            BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid Name="titleBar" Margin="14,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Brand Badge -->
                            <Border Grid.Column="0" CornerRadius="5" Padding="6,2" Margin="0,0,9,0"
                                    Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="MN" FontSize="10.5" Foreground="#059669"/>
                            </Border>

                            <!-- Window Title -->
                            <TextBlock Grid.Column="1" Text="mepanana  ·  Family Local Library"
                                       FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>

                            <!-- Theme Toggle Button -->
                            <Button Grid.Column="2" Name="btnToggleTheme" Content="🌙"
                                    ToolTip="Switch to Dark Theme"
                                    Style="{StaticResource TitleActionBtn}" VerticalAlignment="Center"
                                    Margin="0,0,6,0"/>

                            <!-- Close Button -->
                            <Button Grid.Column="3" Name="btnClose" Content="✕"
                                    Style="{StaticResource TitleCloseBtn}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- ── Row 1: Signature 4-Color Gradient Line ── -->
                    <Rectangle Grid.Row="1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#10B981" Offset="0"/>
                                <GradientStop Color="#3B82F6" Offset="0.5"/>
                                <GradientStop Color="#F59E0B" Offset="0.8"/>
                                <GradientStop Color="#EF4444" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- ── Row 2: Main Workspace ── -->
                    <Grid Grid.Row="2" Margin="14,12,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />  <!-- Top Header Card (Folder Picker & Stats) -->
                            <RowDefinition Height="*" />     <!-- Catalog Workspace (Sidebar & Cards) -->
                            <RowDefinition Height="Auto" />  <!-- FooterBar with ProgressBar & Actions -->
                        </Grid.RowDefinitions>

                        <!-- ── Top Header Card: Folder Picker & Actions ── -->
                        <Border Grid.Row="0" Background="#E6FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.05"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="📁 Library Folder:" VerticalAlignment="Center" Margin="4,0,10,0" Foreground="#0F172A" />

                                <TextBox Grid.Column="1" Name="txtFolderPath" Height="32" Padding="8,4" VerticalContentAlignment="Center" FontSize="12" Margin="0,0,8,0"
                                         Background="White" BorderBrush="#CBD5E1" ToolTip="Path to your local or network Revit family library directory" />

                                <Button Grid.Column="2" Name="btnBrowseFolder" Content="📁 Browse..." Style="{StaticResource PrimaryBtn}" Height="32" Padding="14,0" Margin="0,0,6,0" Cursor="Hand" />
                                <Button Grid.Column="3" Name="btnRescan" Content="🔄 Rescan" Style="{StaticResource GhostBtn}" Height="32" Padding="12,0" Margin="0,0,6,0" Cursor="Hand" ToolTip="Rescan directory for new or updated .rfa families" />
                                <Button Grid.Column="4" Name="btnOpenExplorer" Content="↗️ Explorer" Style="{StaticResource GhostBtn}" Height="32" Padding="12,0" Margin="0,0,10,0" Cursor="Hand" ToolTip="Open folder in Windows Explorer" />

                                <!-- Stats Badge -->
                                <Border Grid.Column="5" Name="borderLibraryStats" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Height="32" Padding="12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="#16A34A" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Name="txtLibraryStats" Text="0 Families" FontSize="12" Foreground="#15803D" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ── Main Workspace Area (Sidebar & Cards) ── -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" /> <!-- Categories Sidebar -->
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />   <!-- Cards Area -->
                            </Grid.ColumnDefinitions>

                            <!-- Left Categories Sidebar Card -->
                            <Border Grid.Column="0" Background="#E6FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                    CornerRadius="8" Padding="12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.05"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Section Header -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Rectangle Width="3" Height="14" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" RadiusX="1.5" RadiusY="1.5"/>
                                        <TextBlock Text="Categories" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Categories ListBox with Virtualization -->
                                    <ListBox Grid.Row="1" Name="listCategories"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             ScrollViewer.IsDeferredScrollingEnabled="False"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             BorderThickness="0" Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="11.5" Foreground="#334155" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="10" Padding="6,1" Margin="4,0,0,0">
                                                         <TextBlock Text="{Binding Count}" FontSize="10" Foreground="#64748B" />
                                                     </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Dynamic Version Filter in Sidebar Footer -->
                                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                        <TextBlock Text="Family Version:" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" />
                                        <ComboBox Name="cmbVersionFilter" Height="30" FontSize="11.5" Background="White" BorderBrush="#CBD5E1" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Right Families Catalog Area -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Row 0: Search Bar & Filters -->
                                    <RowDefinition Height="Auto" /> <!-- Row 1: Batch Actions Toolbar -->
                                    <RowDefinition Height="*" />    <!-- Row 2: Cards ScrollViewer -->
                                </Grid.RowDefinitions>

                                <!-- Row 0: Search Input + Compatibility Filter + Found Counter -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />        <!-- Search Box -->
                                        <ColumnDefinition Width="Auto" />     <!-- Compatible Only -->
                                        <ColumnDefinition Width="Auto" />     <!-- Families Found Counter -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Search Input -->
                                    <Grid Grid.Column="0" Margin="0,0,10,0">
                                        <TextBox Name="txtSearch" Height="34" Padding="30,4,8,4" VerticalContentAlignment="Center" FontSize="12" Background="White" BorderBrush="#CBD5E1" />
                                        <TextBlock Text="🔍" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" />
                                    </Grid>

                                    <!-- Smart Compatibility Shield Toggle Pill Button -->
                                    <CheckBox Name="chkCompatibleOnly" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand"
                                              ToolTip="Filter to show only families compatible with your current Revit version">
                                        <CheckBox.Template>
                                            <ControlTemplate TargetType="CheckBox">
                                                <Border Name="borderPill" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="34" Padding="10,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Name="txtIcon" Text="🛡️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                        <TextBlock Name="txtLabel" Text="Compatible Only" FontSize="11.5" Foreground="#475569" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="borderPill" Property="Background" Value="#EFF6FF" />
                                                        <Setter TargetName="borderPill" Property="BorderBrush" Value="#3B82F6" />
                                                        <Setter TargetName="txtLabel" Property="Foreground" Value="#1D4ED8" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </CheckBox.Template>
                                    </CheckBox>

                                    <!-- Found Counter Badge -->
                                    <Border Grid.Column="2" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,0" Height="34" VerticalAlignment="Center">
                                        <TextBlock Name="txtFoundCount" Text="0 families found" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <!-- Row 1: Batch Actions Toolbar (Select All & Batch Load) -->
                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Select All Pill Button -->
                                        <CheckBox Name="chkSelectAll" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand"
                                                  ToolTip="Select or Deselect all currently filtered families for batch loading">
                                            <CheckBox.Template>
                                                <ControlTemplate TargetType="CheckBox">
                                                    <Border Name="borderPill" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="32" Padding="10,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Name="txtIcon" Text="☑️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                            <TextBlock Name="txtLabel" Text="Select All" FontSize="11.5" Foreground="#475569" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="borderPill" Property="Background" Value="#EFF6FF" />
                                                            <Setter TargetName="borderPill" Property="BorderBrush" Value="#93C5FD" />
                                                            <Setter TargetName="txtLabel" Property="Foreground" Value="#1D4ED8" />
                                                            <Setter TargetName="txtLabel" Property="Text" Value="Deselect All" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="borderPill" Property="BorderBrush" Value="#2563EB" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </CheckBox.Template>
                                        </CheckBox>

                                        <!-- Batch Load Button (Sleek Pill Button) -->
                                        <Button Name="btnBatchLoadTop" Height="32" Padding="14,0" Margin="0,0,8,0" Cursor="Hand"
                                                ToolTip="Load all selected families into the active Revit project">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#EFF6FF" />
                                                    <Setter Property="BorderBrush" Value="#BFDBFE" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="Foreground" Value="#1D4ED8" />
                                                    <Setter Property="FontSize" Value="11.5" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="border" Property="Background" Value="#DBEAFE" />
                                                                        <Setter TargetName="border" Property="BorderBrush" Value="#2563EB" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter TargetName="border" Property="Opacity" Value="0.4" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📥" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Name="txtBatchLoadTopCount" Text="Load Selected (0)" FontSize="11.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 2: Balanced Cards Grid ScrollViewer (3 Cards Per Row) -->
                                <Border Grid.Row="2" Background="#E6FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="6">
                                    <ScrollViewer Name="scrollCards" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl Name="itemsCards">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Balanced Family Card (Width 236 for perfect 3-column wrap) -->
                                                    <Border Width="236" Height="274" Margin="5" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.04"/>
                                                        </Border.Effect>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="148" /> <!-- Thumbnail -->
                                                                <RowDefinition Height="Auto" /> <!-- Title -->
                                                                <RowDefinition Height="Auto" /> <!-- Badges -->
                                                                <RowDefinition Height="*" />    <!-- Spacer -->
                                                                <RowDefinition Height="Auto" /> <!-- Action Button -->
                                                            </Grid.RowDefinitions>

                                                            <!-- Thumbnail Container with Checkbox Overlay -->
                                                            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" ClipToBounds="True">
                                                                <Grid>
                                                                    <TextBlock Text="📦" FontSize="36" Opacity="0.2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    <Image Source="{Binding ThumbnailImage}" Stretch="Uniform" Margin="4"
                                                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                                                    <!-- Selection Checkbox Overlay -->
                                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                              HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                              Margin="7" Cursor="Hand"
                                                                              ToolTip="Select family for batch loading">
                                                                        <CheckBox.Template>
                                                                            <ControlTemplate TargetType="CheckBox">
                                                                                <Border Name="chkBorder" Width="20" Height="20" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="5">
                                                                                    <TextBlock Name="chkCheck" Text="✓" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,-1,0,0"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsChecked" Value="True">
                                                                                        <Setter TargetName="chkBorder" Property="Background" Value="#2563EB" />
                                                                                        <Setter TargetName="chkBorder" Property="BorderBrush" Value="#1D4ED8" />
                                                                                        <Setter TargetName="chkCheck" Property="Visibility" Value="Visible" />
                                                                                    </Trigger>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="chkBorder" Property="BorderBrush" Value="#2563EB" />
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </CheckBox.Template>
                                                                    </CheckBox>
                                                                </Grid>
                                                            </Border>

                                                            <!-- Family Title -->
                                                            <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="12.5"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding TooltipText}" Margin="0,0,0,5"
                                                                       Foreground="#0F172A" />

                                                            <!-- Badges: Category on Left, Version & Size on Right -->
                                                            <Grid Grid.Row="2" Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Category Tag -->
                                                                <Border Grid.Column="0" Background="#EEF2FF" CornerRadius="4" Padding="5,1.5" HorizontalAlignment="Left" Margin="0,0,4,0">
                                                                    <TextBlock Text="{Binding Category}" FontSize="9.5" Foreground="#4338CA" TextTrimming="CharacterEllipsis" ToolTip="{Binding Category}" />
                                                                </Border>

                                                                <!-- Version & Size Badges -->
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                    <Border Background="{Binding VersionBadgeBg}" CornerRadius="4" Padding="5,1.5" Margin="0,0,4,0">
                                                                        <TextBlock Text="{Binding VersionLabel}" FontSize="9.5" Foreground="{Binding VersionBadgeFg}" />
                                                                    </Border>
                                                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="5,1.5">
                                                                        <TextBlock Text="{Binding FileSizeStr}" FontSize="9.5" Foreground="#64748B" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- 1-Click Load CTA Button -->
                                                            <Button Grid.Row="4" Tag="{Binding RfaPath}" Name="btnCardLoad"
                                                                    Content="📥 Load" Height="30" FontSize="11"
                                                                    Background="#EFF6FF" BorderBrush="#BFDBFE" Foreground="#1D4ED8" Cursor="Hand">
                                                                <Button.Resources>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="CornerRadius" Value="6" />
                                                                    </Style>
                                                                </Button.Resources>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ── Tier 3 FooterBar with ProgressBar ── -->
                        <Border Grid.Row="2" Background="#E6FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.05"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- ProgressBar -->
                                    <RowDefinition Height="Auto" /> <!-- Action Buttons -->
                                </Grid.RowDefinitions>

                                <!-- Unified Progress Bar Standard -->
                                <ProgressBar Grid.Row="0" Name="progressBar" Height="4" Margin="0,0,0,8"
                                             Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100" />

                                <!-- Action Controls Row -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />    <!-- Status Feedback -->
                                        <ColumnDefinition Width="Auto" /> <!-- Close Button -->
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Name="txtStatus" Text="Ready." VerticalAlignment="Center"
                                               FontSize="11.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                                    <Button Grid.Column="1" Name="btnFooterClose" Content="Close" Style="{StaticResource GhostBtn}" Height="32" Padding="20,0" Margin="0" Cursor="Hand" IsCancel="True" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
