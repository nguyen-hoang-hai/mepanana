<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Sheet Export • MEPANANA Publish"
        Width="1060" Height="720" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="#F5F7FA" FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Header Banner -->
            <RowDefinition Height="*"/>     <!-- 1: Main 2-Column Content -->
            <RowDefinition Height="Auto"/>  <!-- 2: Tier 3 FooterBar -->
        </Grid.RowDefinitions>

        <!-- ── Row 0: Top Header Card ─────────────────────────────────────────── -->
        <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,8" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📑" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Batch Sheet Export" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Project & Counts Badge -->
                <Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12,4" VerticalAlignment="Center">
                    <TextBlock Name="txtSheetCountBadge" Text="0 Sheets in Project" FontWeight="SemiBold" FontSize="12" Foreground="#1D4ED8"/>
                </Border>
            </Grid>
        </Border>

        <!-- ── Row 1: 2-Column Main Workspace ─────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>      <!-- Left: Sheet List -->
                <ColumnDefinition Width="12"/>     <!-- Splitter / Gap -->
                <ColumnDefinition Width="460"/>    <!-- Right: Options & Naming -->
            </Grid.ColumnDefinitions>

            <!-- ── Left Column: Sheet Selection Card ──────────────────────────── -->
            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Margin="0" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title, Search & Filter Bar -->
                        <RowDefinition Height="*"/>    <!-- Sheets DataGrid -->
                        <RowDefinition Height="Auto"/> <!-- Batch Select Action Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Header & Search Bar -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="1. SELECT SHEETS" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Name="txtSearch" Height="30" Padding="8,0"
                                 VerticalContentAlignment="Center" FontSize="12.5"
                                 ToolTip="Type to filter sheets by number or name..."/>
                        <TextBlock Grid.Column="0" Text="🔍 Search sheets..." Foreground="#94A3B8"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="1" Name="btnClearSearch" Content="✕" Style="{DynamicResource GhostButton}"
                                Width="28" Height="30" Margin="6,0,0,0" ToolTip="Clear filter"/>
                    </Grid>
                </StackPanel>

                <!-- Sheets DataGrid -->
                    <DataGrid Grid.Row="1" Name="dgSheets"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              HorizontalGridLinesBrush="#F1F5F9"
                              Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                              RowHeight="32">
                        <DataGrid.Resources>
                            <!-- Elegant Pastel Selection Colors (Prevent Windows Classic Dark Blue Clash) -->
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#EFF6FF"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#EFF6FF"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>
                        </DataGrid.Resources>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="Height" Value="32"/>
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                        <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <!-- Selection Checkbox -->
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                            </DataGridCheckBoxColumn>

                            <!-- Sheet Number -->
                            <DataGridTextColumn Header="Sheet No." Binding="{Binding SheetNumber}" Width="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="6,0"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Sheet Name -->
                            <DataGridTextColumn Header="Sheet Name" Binding="{Binding SheetName}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="6,0"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Auto-Detected Paper Size -->
                            <DataGridTextColumn Header="Size" Binding="{Binding FormatTag}" Width="85" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#059669"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Rev -->
                            <DataGridTextColumn Header="Rev" Binding="{Binding Revision}" Width="55" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#64748B"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Batch Select Controls & Count Footer -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Name="btnSelectAll" Content="Select All" Style="{DynamicResource GhostButton}" Height="28" Padding="10,0" Margin="0,0,6,0"/>
                            <Button Name="btnSelectNone" Content="Clear" Style="{DynamicResource GhostButton}" Height="28" Padding="10,0" Margin="0,0,6,0"/>
                            <Button Name="btnInvertSelect" Content="Invert" Style="{DynamicResource GhostButton}" Height="28" Padding="10,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Name="txtSelectionCount" Text="Selected: 0 / 0"
                                   VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2563EB"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── Right Column: Export Settings, Naming & Destination ──────────── -->
            <ScrollViewer Name="scrollRightOptions" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical">

                    <!-- Card 1: Output Formats & Engine Options -->
                    <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="2. EXPORT FORMATS" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox Name="chkFormatPdf" Content="PDF (Native 2022+)" IsChecked="True"
                                          FontWeight="SemiBold" Margin="0,0,22,0"/>
                                <CheckBox Name="chkFormatDwg" Content="DWG (AutoCAD 2018)" IsChecked="False"
                                          FontWeight="SemiBold"/>
                            </StackPanel>

                            <!-- PDF Specific Config -->
                            <Border Name="borderPdfConfig" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="PDF Export Mode:" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <RadioButton Name="rbPdfSeparate" Content="Separate Files" IsChecked="True"
                                                     Margin="0,0,18,0" GroupName="PdfMode"/>
                                        <RadioButton Name="rbPdfCombine" Content="Combine into 1 PDF"
                                                     GroupName="PdfMode"/>
                                    </StackPanel>

                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Color Mode -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Color Quality:" Style="{DynamicResource FieldLabel}" Margin="0,0,0,4"/>
                                            <ComboBox Name="cmbColorMode" SelectedIndex="0" Height="28">
                                                <ComboBoxItem Content="Color"/>
                                                <ComboBoxItem Content="Grayscale"/>
                                                <ComboBoxItem Content="Black &amp; White"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Paper Size Rule -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Paper Size Rule:" Style="{DynamicResource FieldLabel}" Margin="0,0,0,4"/>
                                            <ComboBox Name="cmbPaperRule" SelectedIndex="0" Height="28">
                                                <ComboBoxItem Content="Auto-Detect (TitleBlock)"/>
                                                <ComboBoxItem Content="Force A3"/>
                                                <ComboBoxItem Content="Force A1"/>
                                                <ComboBoxItem Content="Force A0"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- DWG Specific Config -->
                            <Border Name="borderDwgConfig" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="DWG Export Mode:" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Name="rbDwgSeparate" Content="Separate Files" IsChecked="True"
                                                     Margin="0,0,18,0" GroupName="DwgMode"/>
                                        <RadioButton Name="rbDwgCombine" Content="Combine into 1 DWG (Layouts)"
                                                     GroupName="DwgMode"
                                                     ToolTip="Merges all selected sheets into multiple Layout tabs in 1 master DWG."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Custom Filename Builder -->
                    <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,10" Padding="14,12">
                        <StackPanel>
                            <TextBlock Name="txtNamingSectionTitle" Text="3. DYNAMIC FILENAME BUILDER" Style="{DynamicResource SectionTitle}" Margin="0,0,0,6"/>

                            <TextBlock Name="lblNamingPattern" Text="Template Pattern:" Style="{DynamicResource FieldLabel}" Margin="0,0,0,4"/>
                            <TextBox Name="txtNamingTemplate"
                                     Text="[Sheet Number] - [Sheet Name]"
                                     Height="30" Margin="0,0,0,8" VerticalContentAlignment="Center"
                                     FontFamily="Consolas" FontSize="12"/>

                            <!-- Quick Token Pills -->
                            <WrapPanel Margin="0,0,0,8">
                                <Button Name="btnTokenSheetNum" Content="+ Sheet No." Style="{DynamicResource GhostButton}" Height="25" Padding="8,0" Margin="0,0,6,4" FontSize="11.5"/>
                                <Button Name="btnTokenSheetName" Content="+ Sheet Name" Style="{DynamicResource GhostButton}" Height="25" Padding="8,0" Margin="0,0,6,4" FontSize="11.5"/>
                                <Button Name="btnTokenRev" Content="+ Revision" Style="{DynamicResource GhostButton}" Height="25" Padding="8,0" Margin="0,0,6,4" FontSize="11.5"/>
                                <Button Name="btnTokenDate" Content="+ Date" Style="{DynamicResource GhostButton}" Height="25" Padding="8,0" Margin="0,0,6,4" FontSize="11.5"/>
                                <Button Name="btnTokenProjNum" Content="+ Proj No." Style="{DynamicResource GhostButton}" Height="25" Padding="8,0" Margin="0,0,6,4" FontSize="11.5"/>
                            </WrapPanel>

                            <!-- Live Preview Box -->
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Name="lblLivePreviewTitle" Text="Live Filename Preview:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                                    <TextBlock Name="txtLivePreview" Text="A101 - Unnamed.pdf"
                                               FontFamily="Consolas" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Destination Folder -->
                    <Border Style="{DynamicResource CardStyle}" Margin="0" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="4. OUTPUT DESTINATION" Style="{DynamicResource SectionTitle}" Margin="0,0,0,6"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Name="txtOutputPath" Height="30" VerticalContentAlignment="Center"
                                         IsReadOnly="True" Background="#F8FAFC" FontSize="12"
                                         Text="C:\MEPANANA_Exports"/>
                                <Button Grid.Column="1" Name="btnBrowseFolder" Content="Browse..." Style="{DynamicResource GhostButton}"
                                         Height="30" Padding="14,0" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── Row 2: Tier 3 FooterBar ────────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Progress Bar (4px top edge) -->
                <RowDefinition Height="Auto"/> <!-- Action Controls -->
            </Grid.RowDefinitions>

            <!-- 100% Span 4px High Progress Bar -->
            <ProgressBar Grid.Row="0" Name="progressBar" Height="4" Margin="0,0,0,10"
                         Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100"
                         Background="#E2E8F0" Foreground="#2563EB">
                <ProgressBar.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="2"/>
                    </Style>
                </ProgressBar.Resources>
            </ProgressBar>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Feedback -->
                <TextBlock Grid.Column="0" Name="txtStatus" Text="Ready to export."
                           VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Name="btnClose" Content="Close" Style="{DynamicResource GhostButton}"
                            Height="34" Width="90" Margin="0,0,8,0" IsCancel="True"/>
                    <Button Name="btnExport" Content="🚀 Export All" Style="{DynamicResource PrimaryButton}"
                            Height="34" Width="140" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
