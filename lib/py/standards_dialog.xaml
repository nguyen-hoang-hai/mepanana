<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Standards Reference Guide - NFPA 13 &amp; TCVN 7336:2021"
        Width="580" Height="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="12.5"
        Background="{DynamicResource WindowBgBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 0: Header & Tool Title -->
            <RowDefinition Height="Auto" />  <!-- 1: Mode Switcher -->
            <RowDefinition Height="*" />     <!-- 2: Scrollable Standards Content -->
            <RowDefinition Height="Auto" />  <!-- 3: Footer Action Buttons -->
        </Grid.RowDefinitions>

        <!-- 0: Header -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource SecondaryButtonBrush}" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="📖" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="txtToolTitle" Text="Pendent Sprinkler Studio" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="NFPA 13 (2016, 2019/2022) &amp; TCVN 7336:2021 Engineering Standards Guide" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1: Mode Switcher Bar -->
        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="10,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Configuration Mode:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox x:Name="cmbMode" Grid.Column="1" Height="30" FontSize="12" />
            </Grid>
        </Border>

        <!-- 2: Scrollable Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
            <StackPanel Orientation="Vertical">

                <!-- Card 1: NFPA 13 Requirements -->
                <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,12" Padding="14">
                    <StackPanel Orientation="Vertical">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🌐" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="NFPA 13 REQUIREMENTS" Style="{DynamicResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#EEF2FF" CornerRadius="4" Padding="6,2">
                                <TextBlock x:Name="txtNFPAEdition" Text="NFPA 13 (2019/2022) Sec. 16.4.5" FontSize="10" FontWeight="Bold" Foreground="#4F46E5" />
                            </Border>
                        </Grid>
                        <StackPanel x:Name="panelNFPA" Orientation="Vertical" />
                    </StackPanel>
                </Border>

                <!-- Card 2: TCVN 7336:2021 Requirements -->
                <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,12" Padding="14">
                    <StackPanel Orientation="Vertical">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🇻🇳" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="QUY CHUẨN TCVN 7336:2021" Style="{DynamicResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="4" Padding="6,2">
                                <TextBlock x:Name="txtTCVNEdition" Text="TCVN 7336:2021 Mục 6.7" FontSize="10" FontWeight="Bold" Foreground="#059669" />
                            </Border>
                        </Grid>
                        <StackPanel x:Name="panelTCVN" Orientation="Vertical" />
                    </StackPanel>
                </Border>

                <!-- Card 3: Key Technical Specifications & Tolerances -->
                <Border Style="{DynamicResource CardStyle}" Padding="14">
                    <StackPanel Orientation="Vertical">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📐" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="THÔNG SỐ KỸ THUẬT CỐT LÕI (SPECIFICATIONS)" Style="{DynamicResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#FEF3C7" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="Standard Limits" FontSize="10" FontWeight="Bold" Foreground="#D97706" />
                            </Border>
                        </Grid>
                        <StackPanel x:Name="panelSpecs" Orientation="Vertical" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 3: Footer Action Buttons -->
        <Border Grid.Row="3" Style="{DynamicResource CardStyle}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtStatus" Grid.Column="0" Text="" VerticalAlignment="Center" Foreground="#10B981" FontWeight="SemiBold" FontSize="11.5" />

                <Button x:Name="btnCopy" Grid.Column="1" Content="📋 Copy Notes" Style="{DynamicResource GhostButton}" Height="36" MinWidth="110" Margin="0,0,10,0" ToolTip="Copy all standards clauses and specifications to clipboard" />
                <Button x:Name="btnClose" Grid.Column="2" Content="Close" Style="{DynamicResource PrimaryButton}" Height="36" MinWidth="88" IsCancel="True" IsDefault="True" />
            </Grid>
        </Border>

    </Grid>
</Window>
