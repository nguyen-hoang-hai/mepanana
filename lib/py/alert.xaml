<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification" Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FFFFFF" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Icon Badge -->
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="Auto"/> <!-- Message -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- ── Top Icon Badge ─────────────────────────────────────────────── -->
        <Border Grid.Row="0" Name="borderIconBadge"
                Width="54" Height="54" CornerRadius="27"
                Background="#D1FAE5" HorizontalAlignment="Center" Margin="0,0,0,12">
            <TextBlock Name="txtIcon" Text="ℹ"
                       FontWeight="Bold" FontSize="26"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#059669" Margin="0,-2,0,0"/>
        </Border>

        <!-- ── Title ──────────────────────────────────────────────────────── -->
        <TextBlock Grid.Row="1" Name="txtAlertTitle"
                   Text="Notification" FontWeight="Bold" FontSize="16"
                   Foreground="#0F172A"
                   HorizontalAlignment="Center" TextAlignment="Center"
                   Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>

        <!-- ── Message Body ───────────────────────────────────────────────── -->
        <TextBlock Grid.Row="2" Name="txtMessage"
                   Text="Message details go here."
                   TextWrapping="Wrap"
                   Foreground="#475569"
                   FontSize="12.5" Margin="0,0,0,20"
                   HorizontalAlignment="Center" TextAlignment="Center"
                   MaxWidth="370"/>

        <!-- ── Actions ────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="btnCancel" Content="Cancel" Style="{DynamicResource GhostButton}"
                    Height="36" Width="110" FontSize="12.5" FontWeight="SemiBold"
                    Margin="0,0,10,0" Visibility="Collapsed"/>
            <Button Name="btnOk" Content="OK" Style="{DynamicResource PrimaryButton}"
                    Height="36" Width="120" FontSize="12.5" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>