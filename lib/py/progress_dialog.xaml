<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Progress" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Border Margin="16" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
            CornerRadius="14" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" Direction="270" ShadowDepth="4" BlurRadius="24" Opacity="0.16" />
        </Border.Effect>

        <Grid Margin="22,20,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header (Title + Status) -->
                <RowDefinition Height="Auto"/> <!-- Progress Section (Live Detail + Bar + Percent) -->
                <RowDefinition Height="Auto"/> <!-- Optional Footer Cancel Button -->
            </Grid.RowDefinitions>

            <!-- ── Header: Clean Title & Status Subtitle (No Logo) ─────────── -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Name="txtTitle" Text="Loading Family Library..." FontWeight="Bold" FontSize="15"
                           Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                <TextBlock Name="txtStatus" Text="Indexing library..." FontSize="12"
                           Foreground="#64748B" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- ── Progress Section: Live Detail Text, Progress Bar & Percent ─ -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Detail & Percentage Header -->
                        <RowDefinition Height="Auto" /> <!-- Progress Bar Track -->
                    </Grid.RowDefinitions>

                    <!-- Top Row: Detail text & Percent -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Name="txtDetail" Text="Initializing..." FontSize="12"
                                   Foreground="#334155" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="320" VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1" Name="txtPercent" Text="0%" FontSize="13" FontWeight="Bold"
                                   Foreground="#2563EB" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>

                    <!-- Smooth Animated Progress Bar -->
                    <ProgressBar Grid.Row="1" Name="progressBar" Height="6" Minimum="0" Maximum="100" Value="0"
                                 IsIndeterminate="False" Background="#E2E8F0" Foreground="#2563EB">
                        <ProgressBar.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="3" />
                            </Style>
                        </ProgressBar.Resources>
                    </ProgressBar>
                </Grid>
            </Border>

            <!-- ── Optional Footer Action: Cancel Button ───────────────────── -->
            <Button Grid.Row="2" Name="btnCancel" Content="Cancel Operation"
                    Height="28" Padding="14,0" FontSize="11" FontWeight="SemiBold"
                    HorizontalAlignment="Right" Margin="0,12,0,0" Visibility="Collapsed" Cursor="Hand"
                    Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#64748B">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>
