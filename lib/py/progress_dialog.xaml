<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MEPANANA Progress" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Border Margin="16" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
            CornerRadius="14" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" Direction="270" ShadowDepth="4" BlurRadius="24" Opacity="0.16" />
        </Border.Effect>

        <Grid Margin="20,18,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header (Icon + Title + Status) -->
                <RowDefinition Height="Auto"/> <!-- Progress Section (Live Detail + Bar + Percent) -->
                <RowDefinition Height="Auto"/> <!-- Optional Footer Cancel Button -->
            </Grid.RowDefinitions>

            <!-- ── Header: Brand Icon, Title & Status Pill ─────────────────── -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Premium Rounded Gradient Icon Badge -->
                <Border Grid.Column="0" Name="borderIcon" Width="42" Height="42" CornerRadius="10"
                        Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Name="txtIcon" Text="🍌" FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                </Border>

                <!-- Title & Status Subtitle -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Name="txtTitle" Text="Loading Family Library..." FontWeight="Bold" FontSize="14.5"
                               Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,1.5" Margin="0,0,8,0">
                            <TextBlock Text="MEPANANA ENGINE" FontSize="9.5" FontWeight="Bold" Foreground="#475569" />
                        </Border>
                        <TextBlock Name="txtStatus" Text="Indexing library..." FontSize="11.5"
                                   Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ── Progress Section: Live Detail Text, Progress Bar & Percent ─ -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Detail & Percentage Header -->
                        <RowDefinition Height="Auto" /> <!-- Progress Bar Track -->
                    </Grid.RowDefinitions>

                    <!-- Top Row: Detail text & Percent -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="#3B82F6" />
                            <TextBlock Grid.Column="0" Name="txtDetail" Text="Initializing..." FontSize="11.5"
                                       Foreground="#334155" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="330" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" Name="txtPercent" Text="0%" FontSize="12.5" FontWeight="Bold"
                                   Foreground="#2563EB" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>

                    <!-- Smooth Animated Progress Bar -->
                    <ProgressBar Grid.Row="1" Name="progressBar" Height="6" Minimum="0" Maximum="100" Value="0"
                                 IsIndeterminate="False" Background="#E2E8F0" Foreground="#2563EB">
                        <ProgressBar.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="3" />
                            </Style>
                        </ProgressBar.Resources>
                    </ProgressBar>
                </Grid>
            </Border>

            <!-- ── Optional Footer Action: Cancel Button ───────────────────── -->
            <Button Grid.Row="2" Name="btnCancel" Content="Cancel Operation"
                    Height="28" Padding="14,0" FontSize="11" FontWeight="SemiBold"
                    HorizontalAlignment="Right" Margin="0,12,0,0" Visibility="Collapsed" Cursor="Hand"
                    Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#64748B">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>
