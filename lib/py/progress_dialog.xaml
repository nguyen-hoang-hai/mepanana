<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MEPANANA Progress" Width="450" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        FontFamily="Segoe UI" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Border Margin="14" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
            CornerRadius="12" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" Direction="270" ShadowDepth="4" BlurRadius="20" Opacity="0.14" />
        </Border.Effect>

        <Grid Margin="20,18,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header (Icon + Title) -->
                <RowDefinition Height="Auto"/> <!-- Status Subtitle -->
                <RowDefinition Height="Auto"/> <!-- Progress Bar -->
                <RowDefinition Height="Auto"/> <!-- Detail & Percentage -->
                <RowDefinition Height="Auto"/> <!-- Optional Cancel Button -->
            </Grid.RowDefinitions>

            <!-- ── Header: Brand Icon & Title ──────────────────────────────── -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border Grid.Column="0" Name="borderIcon" Width="38" Height="38" CornerRadius="19"
                        Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Name="txtIcon" Text="🍌" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                </Border>

                <!-- Title & App Label -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Name="txtTitle" Text="Processing Task..." FontWeight="Bold" FontSize="14.5"
                               Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="MEPANANA Extension Engine" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="#64748B" Margin="0,1,0,0" />
                </StackPanel>
            </Grid>

            <!-- ── Status Message ─────────────────────────────────────────── -->
            <TextBlock Grid.Row="1" Name="txtStatus" Text="Please wait while processing..."
                       FontSize="12" Foreground="#475569" Margin="0,4,0,10"
                       TextTrimming="CharacterEllipsis" />

            <!-- ── Smooth Progress Bar ────────────────────────────────────── -->
            <ProgressBar Grid.Row="2" Name="progressBar" Height="6" Minimum="0" Maximum="100" Value="0"
                         IsIndeterminate="False" Background="#F1F5F9" Foreground="#2563EB" Margin="0,0,0,6">
                <ProgressBar.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="3" />
                    </Style>
                </ProgressBar.Resources>
            </ProgressBar>

            <!-- ── Detail Text & Percentage ───────────────────────────────── -->
            <Grid Grid.Row="3" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Name="txtDetail" Text="" FontSize="11"
                           Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                <TextBlock Grid.Column="1" Name="txtPercent" Text="0%" FontSize="11" FontWeight="Bold"
                           Foreground="#2563EB" HorizontalAlignment="Right" />
            </Grid>

            <!-- ── Cancel Button (Optional) ───────────────────────────────── -->
            <Button Grid.Row="4" Name="btnCancel" Content="Cancel" Style="{DynamicResource GhostButton}"
                    Height="28" Width="90" FontSize="11.5" FontWeight="SemiBold"
                    HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="Collapsed" Cursor="Hand" />
        </Grid>
    </Border>
</Window>
